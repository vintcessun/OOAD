{
  "name": "rbac-web",
  "private": true,
  "version": "1.0.0",
  "description": "统一授权中心前端（Vue 3 + TypeScript），界面设计见 docs/05-ui.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "element-plus": "2.11.1",
    "pinia": "2.3.1",
    "vue": "3.5.44",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "2.2.0"
  }
}
