title [pos="600,-52.5!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="1100"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="30"><B>RBAC1 权限管理系统 · 数据库 ER 图</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">MySQL 8.0  |  15 张表 · 20 条外键  |  Flyway V1–V7  |  鸟脚记法</FONT></TD></TR></TABLE>>];
