authorization [pos="1665,-145!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>角色与授权</B></FONT></TD></TR></TABLE>>];
resources [pos="2345,-145!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>系统与资源</B></FONT></TD></TR></TABLE>>];
infrastructure [pos="305,-899!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>审计与授权一致性</B></FONT></TD></TR></TABLE>>];
background [pos="1945,-1031!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="1070"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>模型背景与业务约束</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">同一个权限中心管理中心系统和课程系统。部门组成单公司组织树，用户归属一个部门。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">直接角色指派先检查当前部门的准入名单。跨部门调动清空该用户的直接角色指派。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">角色继承沿 senior → junior。应用层检查同系统、去重和无环，继承权限在读取时计算。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">权限目录区分 UI 与 API。映射表登记界面与操作的关系，实际访问仍由 API 独立鉴权。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">授权写入锁定授权版本行（id=1）。版本推进与本地成功审计随业务一起提交。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">令牌按 jti 记录撤销。审计保留历史主体快照，审计与令牌撤销均无业务外键。</FONT></TD></TR></TABLE>>];
legend [pos="1945,-1192.5!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="1070"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>图例</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">PK 主键  ·  FK 外键  ·  N 可空  ·  U 单列唯一</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">虚线为物理外键。鸟脚端为子表（0..*），父端按外键可空性表示 1 或 0..1。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">浅蓝为组织与用户，浅绿为授权，浅橙为系统和资源，浅灰为审计与授权一致性。</FONT></TD></TR></TABLE>>];
unique_keys [pos="2990,-1220!",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" WIDTH="800"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18"><B>关键联合唯一约束</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_role  (system_id, code)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_permission  (system_id, kind, code)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_role_permission  (role_id, permission_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_user_role  (user_id, role_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_department_allowed_role  (department_id, role_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_role_hierarchy  (senior_role_id, junior_role_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_ui_resource  (system_id, code)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_api_operation  (system_id, operation_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_api_operation  (system_id, method, path_template)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13">sys_ui_api_mapping  (ui_resource_id, api_operation_id)</FONT></TD></TR></TABLE>>];
