  },
  "sys_grant_version": {
    "columns": [
      "id TINYINT PRIMARY KEY,",
      "  version BIGINT NOT NULL DEFAULT 0,",
      "  CHECK(id=1),",
      "  CHECK(version>=0)"
    ],
