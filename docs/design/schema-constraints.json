  "sys_user": {
    "columns": [
      "id BIGINT AUTO_INCREMENT PRIMARY KEY,",
      "  subject VARCHAR(128) NOT NULL UNIQUE,",
      "  username VARCHAR(128) NOT NULL UNIQUE,",
      "  password_hash VARCHAR(100) NOT NULL,",
