      "  FOREIGN KEY(permission_id) REFERENCES sys_permission(id),",
      "  UNIQUE(role_id,permission_id)"
    ],
    "ddlSha256": "b05195002bfb1bab73fa10e05f3e0977094baa5837c30ab9ac6515afd51ab2b9"
