@startuml
!pragma teoz true
hide footbox
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam ParticipantPadding 124
skinparam BoxPadding 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 200
title S06-ddd-sequence — source snapshot (not a runtime trace)
participant "obj: 调用者" as obj
participant "ctl: RoleController" as ctl
participant "svc: RoleApplicationService" as svc
participant "auth: AuthorizationApplicationService" as auth
participant "repo: AuthorizationRepository" as repo
participant "audit: AuditApplicationService" as audit
participant "role: Role" as role
participant "graph: RoleHierarchy" as graph
participant "integrity: GrantIntegrityService" as integrity
participant "auditRepo: AuditRepository" as auditRepo
activate obj
obj -> ctl: 1. status(bearer, id, input)
activate ctl
ctl -> svc: 2. status(principal, id, enabled)
activate svc
group Same transaction: role status, grant version and success audit
svc -> repo: 3. lockGrants()
activate repo
deactivate repo
svc -> auth: 4. require(principal, rbac:role:status, true)
activate auth
deactivate auth
svc -> repo: 5. role(id)
activate repo
deactivate repo
svc -> auth: 6. requireRoleManagement(actor, role)
activate auth
deactivate auth
||12||
opt Enable
svc -> auth: 7. requireRoleGrantSystem(actor, role.systemCode())
activate auth
deactivate auth
||16||
end
svc -> role: 8. changeStatus(enabled)
activate role
deactivate role
||12||
opt Enable
svc -> svc: 9. requireAffectedGrants(actor, proposed graph, role, permissions)
activate svc
svc -> graph: 10. affectedBy(role.id())
activate graph
deactivate graph
||12||
loop Affected
svc -> auth: 11. requireGraphGrant(actor, proposed graph, affectedId)
activate auth
deactivate auth
svc -> auth: 12. upperBound(actor, systemCode, proposed permissions)
activate auth
deactivate auth
||16||
end
deactivate svc
||16||
end
svc -> repo: 13. saveRole(role)
activate repo
deactivate repo
svc -> integrity: 14. requireAdministrator()
activate integrity
deactivate integrity
note over svc,repo
Check that an effective SUPER_ADMIN remains.
A failure rolls back the transaction before the version or audit is written.
end note
svc -> repo: 15. advanceVersion()
activate repo
deactivate repo
svc -> audit: 16. local(actor, system, ROLE_STATUS_CHANGED, target, SUCCESS, null)
activate audit
note over audit
Capture the current roles for this actor and build the success record.
end note
audit -> auditRepo: 17. append(fact)
activate auditRepo
break Failure
auditRepo -->> obj: Persistence error, transaction rolls back
||16||
end
deactivate auditRepo
deactivate audit
||16||
end
note over ctl,svc
Spring commits after the service method finishes, before returning to the controller.
end note
alt Committed
svc -->> ctl: role result
ctl -->> obj: 200 role status updated
else Commit throws
svc -->> obj: Commit error, success response withheld
||16||
end
note over audit
Denied audit events use a separate transaction.
end note
deactivate svc
deactivate ctl
deactivate obj
@enduml