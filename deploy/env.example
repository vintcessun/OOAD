# Copy to the repository root as .env; never commit real credentials.
# This file is sourced by Bash: quote values containing spaces or shell characters.
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-rbac
RBAC_JWT_SECRET=change-me-change-me-change-me-change-me-change-me
RBAC_INITIAL_PASSWORD=Init@2026

REGISTRY=swr.cn-north-4.myhuaweicloud.com/egret-hill/
# Empty: build.sh chooses a commit-based tag; stack.sh uses the last build record.
TAG=
APP_REPLICAS=1
APP_JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"

# Local images imported from the offline archive on package.
MYSQL_SOURCE_IMAGE=mysql:8.0
REDIS_SOURCE_IMAGE=redis:7-alpine
BASE_IMAGE=eclipse-temurin:21-jre
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine

# build.sh push will publish these runtime dependency images to SWR.
MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/egret-hill/ooad-mysql:8.0
REDIS_IMAGE=swr.cn-north-4.myhuaweicloud.com/egret-hill/ooad-redis:7-alpine
