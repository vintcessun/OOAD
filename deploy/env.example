# 复制为仓库根目录的 .env 后修改。.env 已被 .gitignore 忽略，真实口令不要提交。
#   cp deploy/env.example .env
#
# 实验二要求：每个组的数据库用户口令都不同。下面的 change-me 必须全部改掉，
# deploy/stack.sh 发现还有 change-me 或开发默认值（root / rbac）会拒绝部署。
# 生成随机口令：openssl rand -base64 18

MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-rbac

# JWT 签名密钥，至少 32 字节。生成：openssl rand -base64 48
RBAC_JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# 镜像仓库前缀（末尾带 /）。集群部署用华为云 SWR，组织名在 SWR 控制台「组织管理」里建：
#   REGISTRY=swr.cn-north-4.myhuaweicloud.com/<组织名>/
# 单机部署留空
REGISTRY=
# 留空时 build.sh 用当前提交的短哈希；stack.sh 留空时部署 latest
TAG=

# 服务器拉不到 Docker Hub 时改用 SWR 上的镜像。老师在实验二里给的 MySQL 是 9.2 版，
# 本项目已用 9.2 验证过 Flyway 建表（docs/13-deployment.md §6）：
#   MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/mysql:latest
# Redis、JRE 基础镜像同理，可推一份到自己组织下再填这里
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
BASE_IMAGE=eclipse-temurin:21-jre

# 2 核 2G 的应用节点只放得下 1 个副本
APP_REPLICAS=1
# 值里有空格，必须加引号，否则 stack.sh 用 shell 读 .env 时会出错
APP_JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"
