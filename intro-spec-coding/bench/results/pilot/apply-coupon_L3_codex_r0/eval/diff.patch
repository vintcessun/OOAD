diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..73a2ec8 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,49 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies one coupon to a pending order, lowering the amount due. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim().toUpperCase();
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has a coupon`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `coupon ${code} requires at least ${coupon.minAmountCents} cents`);
+    }
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.min(discount, order.amountCents);
+
+    this.orders.applyCoupon({
+      orderId: id,
+      couponCode: coupon.code,
+      discountCents: discount,
+      finalAmountCents: order.amountCents - discount,
+      now: now.toISOString(),
+    });
+    return this.get(id);
+  }
 }
diff --git a/tests/apply-coupon.test.ts b/tests/apply-coupon.test.ts
new file mode 100644
index 0000000..2a68bc3
--- /dev/null
+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00.000Z";
+const fixedClock = () => new Date(NOW);
+
+function setup(coupon: Record<string, unknown> = {}, amountCents = 10000) {
+  const app = createApp({ clock: fixedClock });
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...coupon,
+  });
+  expect(res.status).toBe(201);
+  const order = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(order.status).toBe(201);
+  return { app, orderId: (order.body as any).id as number };
+}
+
+const apply = (app: App, id: number, couponCode: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, { couponCode });
+
+describe("apply coupon: amounts", () => {
+  it("AC-01 percent discount", () => {
+    const { app, orderId } = setup({ type: "PERCENT", value: 20 });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02 fixed discount", () => {
+    const { app, orderId } = setup({ type: "FIXED", value: 1500 });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 max discount cap applies to percent coupons", () => {
+    const { app, orderId } = setup({ type: "PERCENT", value: 20, maxDiscountCents: 5000 }, 100000);
+    expect(apply(app, orderId, "SAVE20").body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-04 fixed discount never pushes the total below zero", () => {
+    const { app, orderId } = setup({ type: "FIXED", value: 3000 }, 1000);
+    expect(apply(app, orderId, "SAVE20").body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05 percent discount is floored", () => {
+    const { app, orderId } = setup({ type: "PERCENT", value: 15 }, 999);
+    expect(apply(app, orderId, "SAVE20").body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("keeps the order status unchanged", () => {
+    const { app, orderId } = setup();
+    expect(apply(app, orderId, "SAVE20").body).toMatchObject({ status: "PENDING" });
+  });
+});
+
+describe("apply coupon: matching", () => {
+  it("AC-10 normalises whitespace and case", () => {
+    const { app, orderId } = setup();
+    const res = apply(app, orderId, " save20 ");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("AC-14 response matches the subsequent GET", () => {
+    const { app, orderId } = setup();
+    const applied = apply(app, orderId, "SAVE20");
+    expect(app.request("GET", `/orders/${orderId}`).body).toEqual(applied.body);
+  });
+});
+
+describe("apply coupon: validity windows", () => {
+  it("AC-06 succeeds when the amount equals the minimum", () => {
+    const { app, orderId } = setup({ minAmountCents: 10000 });
+    expect(apply(app, orderId, "SAVE20").status).toBe(200);
+  });
+
+  it("AC-07 rejects now == validUntil and accepts now == validFrom", () => {
+    const expired = setup({ validUntil: NOW });
+    expect(apply(expired.app, expired.orderId, "SAVE20")).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_EXPIRED" } },
+    });
+
+    const fresh = setup({ validFrom: NOW });
+    expect(apply(fresh.app, fresh.orderId, "SAVE20").status).toBe(200);
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const { app, orderId } = setup({ validFrom: "2027-01-01T00:00:00Z" });
+    expect(apply(app, orderId, "SAVE20")).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_NOT_YET_VALID" } },
+    });
+  });
+});
+
+describe("apply coupon: usage", () => {
+  it("AC-08 rejects a second coupon on the same order without changing amounts", () => {
+    const { app, orderId } = setup();
+    const first = apply(app, orderId, "SAVE20");
+    expect(first.status).toBe(200);
+
+    const second = apply(app, orderId, "SAVE20");
+    expect(second).toMatchObject({ status: 409, body: { error: { code: "COUPON_ALREADY_APPLIED" } } });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("AC-09 increments usedCount and records one redemption", () => {
+    const { app, orderId } = setup();
+    apply(app, orderId, "SAVE20");
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db.prepare("SELECT * FROM coupon_redemptions").all() as any[];
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ order_id: orderId, coupon_code: "SAVE20", discount_cents: 2000, created_at: NOW });
+  });
+
+  it("rejects a coupon that reached its usage limit", () => {
+    const { app, orderId } = setup({ usageLimit: 1 });
+    apply(app, orderId, "SAVE20");
+    const other = app.request("POST", "/orders", { customer: "bob", amountCents: 10000 });
+    const res = apply(app, (other.body as any).id, "SAVE20");
+    expect(res).toMatchObject({ status: 400, body: { error: { code: "COUPON_USAGE_EXHAUSTED" } } });
+  });
+});
+
+describe("apply coupon: rejections leave the database untouched", () => {
+  const snapshot = (app: App) => ({
+    order: app.request("GET", "/orders/1").body,
+    coupon: app.request("GET", "/coupons/SAVE20").body,
+    redemptions: (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as any).n,
+  });
+
+  it("rejects a missing or blank couponCode with INVALID_REQUEST", () => {
+    const { app, orderId } = setup();
+    for (const body of [{}, { couponCode: 42 }, { couponCode: "   " }]) {
+      const before = snapshot(app);
+      const res = app.request("POST", `/orders/${orderId}/apply-coupon`, body as any);
+      expect(res).toMatchObject({ status: 400, body: { error: { code: "INVALID_REQUEST" } } });
+      expect(snapshot(app)).toEqual(before);
+    }
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const { app } = setup();
+    expect(apply(app, 999, "SAVE20")).toMatchObject({
+      status: 404,
+      body: { error: { code: "ORDER_NOT_FOUND" } },
+    });
+  });
+
+  it("rejects non-pending orders", () => {
+    const { app, orderId } = setup();
+    app.request("POST", `/orders/${orderId}/pay`);
+    const before = snapshot(app);
+    expect(apply(app, orderId, "SAVE20")).toMatchObject({
+      status: 409,
+      body: { error: { code: "ORDER_NOT_PENDING" } },
+    });
+    expect(snapshot(app)).toEqual(before);
+  });
+
+  it("returns 404 for an unknown coupon", () => {
+    const { app, orderId } = setup();
+    const before = snapshot(app);
+    expect(apply(app, orderId, "NOPE")).toMatchObject({
+      status: 404,
+      body: { error: { code: "COUPON_NOT_FOUND" } },
+    });
+    expect(snapshot(app)).toEqual(before);
+  });
+
+  it("rejects a disabled coupon", () => {
+    const { app, orderId } = setup({ status: "DISABLED" });
+    const before = snapshot(app);
+    expect(apply(app, orderId, "SAVE20")).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_INACTIVE" } },
+    });
+    expect(snapshot(app)).toEqual(before);
+  });
+
+  it("rejects an amount below the coupon minimum", () => {
+    const { app, orderId } = setup({ minAmountCents: 10001 });
+    const before = snapshot(app);
+    expect(apply(app, orderId, "SAVE20")).toMatchObject({
+      status: 400,
+      body: { error: { code: "MINIMUM_NOT_MET" } },
+    });
+    expect(snapshot(app)).toEqual(before);
+  });
+});
