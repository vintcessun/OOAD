diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..116046f 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,34 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  /**
+   * Applies a coupon to an order atomically: updates the order amounts and coupon
+   * code, records a redemption and bumps the coupon usage counter. Any failure
+   * rolls all three statements back.
+   */
+  applyCoupon(input: {
+    orderId: number;
+    couponCode: string;
+    discountCents: number;
+    finalAmountCents: number;
+    now: string;
+  }): void {
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      this.db
+        .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+        .run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(input.orderId, input.couponCode, input.discountCents, input.now);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
