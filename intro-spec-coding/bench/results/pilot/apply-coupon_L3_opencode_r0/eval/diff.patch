--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,50 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, rawCouponCode: unknown): Order {
+    if (typeof rawCouponCode !== "string" || rawCouponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = rawCouponCode.trim().toUpperCase();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is not active`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below coupon minimum`);
+    }
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.min(discount, order.amountCents);
+    const finalAmountCents = order.amountCents - discount;
+
+    this.orders.transaction(() => {
+      this.orders.applyCoupon(id, code, discount, finalAmountCents);
+      this.coupons.recordRedemption(id, code, discount, now.toISOString());
+      this.coupons.incrementUsedCount(code);
+    });
+
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..d2ecc68
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,208 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+const clockAt = (iso: string) => () => new Date(iso);
+
+function createOrder(app: App, amountCents: number, customer = "alice"): number {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as any).id;
+}
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+const apply = (app: App, id: number, body: unknown) => app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+describe("apply coupon - acceptance", () => {
+  it("AC-01 percent", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    createCoupon(app, { type: "PERCENT", value: 20 });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02 fixed", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    createCoupon(app, { type: "FIXED", value: 1500 });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 respects max discount", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 100000);
+    createCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-04 never discounts below zero", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 1000);
+    createCoupon(app, { type: "FIXED", value: 3000 });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05 floors percent discount", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 999);
+    createCoupon(app, { type: "PERCENT", value: 15 });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("AC-06 allows amount equal to the minimum", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 5000);
+    createCoupon(app, { type: "PERCENT", value: 10, minAmountCents: 5000 });
+    expect(apply(app, id, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("AC-07 validFrom inclusive, validUntil exclusive", () => {
+    const atFrom = createApp({ clock: clockAt("2026-01-01T00:00:00Z") });
+    createCoupon(atFrom, { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" });
+    expect(apply(atFrom, createOrder(atFrom, 10000), { couponCode: "SAVE20" }).status).toBe(200);
+
+    const atUntil = createApp({ clock: clockAt("2027-01-01T00:00:00Z") });
+    createCoupon(atUntil, { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" });
+    const res = apply(atUntil, createOrder(atUntil, 10000), { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("AC-08 rejects a second coupon and leaves amounts unchanged", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    createCoupon(app);
+    apply(app, id, { couponCode: "SAVE20" });
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-09 increments usedCount and records a redemption", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app);
+    apply(app, createOrder(app, 10000), { couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const row = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .get() as any;
+    expect(row).toMatchObject({
+      order_id: 1,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: new Date(NOW).toISOString(),
+    });
+  });
+
+  it("AC-10 normalizes the coupon code", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    createCoupon(app);
+    const res = apply(app, id, { couponCode: "  save20  " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+});
+
+describe("apply coupon - error mapping", () => {
+  it("rejects missing / blank / non-string couponCode", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    for (const body of [{}, { couponCode: "" }, { couponCode: "   " }, { couponCode: 5 }]) {
+      const res = apply(app, id, body);
+      expect(res.status).toBe(400);
+      expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+    }
+  });
+
+  it("returns ORDER_NOT_FOUND", () => {
+    const app = createApp({ clock: fixedClock });
+    const res = apply(app, 99, { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns ORDER_NOT_PENDING for non-pending orders", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    createCoupon(app);
+    app.request("POST", `/orders/${id}/pay`);
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns COUPON_NOT_FOUND", () => {
+    const app = createApp({ clock: fixedClock });
+    const res = apply(app, createOrder(app, 10000), { couponCode: "NOPE" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns COUPON_INACTIVE", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { status: "DISABLED" });
+    const res = apply(app, createOrder(app, 10000), { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("returns COUPON_NOT_YET_VALID", () => {
+    const app = createApp({ clock: clockAt("2025-12-31T00:00:00Z") });
+    createCoupon(app, { validFrom: "2026-01-01T00:00:00Z" });
+    const res = apply(app, createOrder(app, 10000), { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("returns COUPON_USAGE_EXHAUSTED", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { usageLimit: 1 });
+    const first = createOrder(app, 10000);
+    apply(app, first, { couponCode: "SAVE20" });
+    const res = apply(app, createOrder(app, 10000, "bob"), { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("returns MINIMUM_NOT_MET", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { minAmountCents: 10001 });
+    const res = apply(app, createOrder(app, 10000), { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+  });
+
+  it("leaves the database untouched on rejection", () => {
+    const app = createApp({ clock: clockAt("2025-12-31T00:00:00Z") });
+    createCoupon(app, { validFrom: "2026-01-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    apply(app, id, { couponCode: "SAVE20" });
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect((app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as any).n).toBe(0);
+  });
+});
