@@ -41,4 +43,57 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and returns the updated order. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already uses coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (now.getTime() > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has reached its usage limit`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict(
+        "ORDER_BELOW_MIN_AMOUNT",
+        `order amount ${order.amountCents} is below coupon ${code} minimum ${coupon.minAmountCents}`,
+      );
+    }
+
+    const discountCents = OrderService.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const createdAt = now.toISOString();
+
+    this.orders.transaction(() => {
+      this.orders.applyCoupon(id, code, discountCents, finalAmountCents);
+      this.coupons.insertRedemption(id, code, discountCents, createdAt);
+      this.coupons.incrementUsedCount(code);
+    });
+    return this.get(id);
+  }
+
+  /** Discount in cents: never negative, never above the order amount, capped by maxDiscountCents. */
+  private static discountFor(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    let discount = Math.max(0, raw);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    return Math.min(discount, amountCents);
+  }
 }
