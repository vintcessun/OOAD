+import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 
-/** Coupon administration (create / look up). Applying coupons to orders is not implemented yet. */
+/** Coupon administration (create / look up) and validation for order redemption. */
 export class CouponService {
-  constructor(private readonly coupons: CouponRepository) {}
+  constructor(
+    private readonly coupons: CouponRepository,
+    private readonly clock: Clock,
+  ) {}
 
   create(input: Record<string, unknown>): Coupon {
     const code = input.code;
@@ -41,4 +45,43 @@ export class CouponService {
     if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
     return coupon;
   }
+
+  /** Validates a coupon against an order amount and returns it. Invalid coupons raise 400. */
+  validateForOrder(code: unknown, amountCents: number): Coupon {
+    if (typeof code !== "string" || code.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT", `order amount is below the minimum for coupon ${code}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT", `coupon ${code} has reached its usage limit`);
+    }
+    return coupon;
+  }
+
+  /** Records a successful redemption, incrementing the coupon's used count. */
+  recordRedemption(code: string): void {
+    this.coupons.incrementUsedCount(code);
+  }
+
+  /** Discount in whole cents for an order amount; never exceeds the order amount. */
+  discountFor(coupon: Coupon, amountCents: number): number {
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(discount, amountCents));
+  }
 }
