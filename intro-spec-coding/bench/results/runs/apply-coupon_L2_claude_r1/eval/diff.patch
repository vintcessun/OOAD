@@ -41,4 +43,42 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and returns the updated order. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom) || now.getTime() > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} is not valid at ${now.toISOString()}`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has reached its usage limit`);
+    }
+
+    const discount = Math.min(this.discountFor(order.amountCents, coupon), order.amountCents);
+    const finalAmount = order.amountCents - discount;
+    this.orders.applyCoupon(id, discount, finalAmount, code);
+    this.coupons.incrementUsed(code);
+    this.coupons.recordRedemption(id, code, discount, now.toISOString());
+    return this.get(id);
+  }
+
+  private discountFor(amountCents: number, coupon: Coupon): number {
+    const raw =
+      coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    return coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  }
 }
