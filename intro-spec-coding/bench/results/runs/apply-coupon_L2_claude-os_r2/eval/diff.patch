@@ -0,0 +1,232 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const makeApp = (): App => createApp({ clock: fixedClock });
+
+const createOrder = (app: App, amountCents = 12000) =>
+  app.request("POST", "/orders", { customer: "alice", amountCents });
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}) {
+  return app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+}
+
+describe("repositories", () => {
+  it("writes an order discount and a redemption and increments usage in a transaction", () => {
+    const app = makeApp();
+    createCoupon(app);
+    createOrder(app);
+    const orders = new OrderRepository(app.db);
+    const coupons = new CouponRepository(app.db);
+    const redemptions = new CouponRedemptionRepository(app.db);
+
+    redemptions.transaction(() => {
+      orders.applyCoupon(1, 2400, 9600, "SAVE20");
+      coupons.incrementUsedCount("SAVE20");
+      redemptions.insert(1, "SAVE20", 2400, "2026-10-01T08:00:00.000Z");
+    });
+
+    expect(orders.findById(1)).toMatchObject({ discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+    expect(coupons.findByCode("SAVE20")?.usedCount).toBe(1);
+    expect(redemptions.listByOrder(1)).toHaveLength(1);
+  });
+
+  it("rolls the transaction back on throw", () => {
+    const app = makeApp();
+    createCoupon(app);
+    createOrder(app);
+    const redemptions = new CouponRedemptionRepository(app.db);
+
+    expect(() =>
+      redemptions.transaction(() => {
+        redemptions.insert(1, "SAVE20", 2400, "2026-10-01T08:00:00.000Z");
+        throw new Error("boom");
+      }),
+    ).toThrow("boom");
+    expect(redemptions.listByOrder(1)).toHaveLength(0);
+  });
+});
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a valid PERCENT coupon and returns 200", () => {
+    const app = makeApp();
+    createCoupon(app);
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a valid FIXED coupon", () => {
+    const app = makeApp();
+    createCoupon(app, { code: "MINUS5", type: "FIXED", value: 500 });
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "MINUS5" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 500, finalAmountCents: 11500 });
+  });
+
+  it("rounds PERCENT discounts down to whole cents", () => {
+    const app = makeApp();
+    createCoupon(app, { code: "PCT15", type: "PERCENT", value: 15 });
+    createOrder(app, 999);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "PCT15" });
+
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("caps the discount at maxDiscountCents", () => {
+    const app = makeApp();
+    createCoupon(app, { code: "CAP", type: "PERCENT", value: 20, maxDiscountCents: 1000 });
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "CAP" });
+
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 11000 });
+  });
+
+  it("never discounts below zero", () => {
+    const app = makeApp();
+    createCoupon(app, { code: "BIGFIX", type: "FIXED", value: 20000 });
+    createOrder(app, 12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIGFIX" });
+
+    expect(res.body).toMatchObject({ discountCents: 12000, finalAmountCents: 0 });
+  });
+
+  it("rejects an unknown coupon with 400", () => {
+    const app = makeApp();
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: { code: "COUPON_NOT_FOUND", message: expect.any(String) } });
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const app = makeApp();
+    createCoupon(app, { status: "DISABLED" });
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = makeApp();
+    createCoupon(app, { validFrom: "2026-01-01T00:00:00Z", validUntil: "2026-09-01T00:00:00Z" });
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a not-yet-valid coupon with 400", () => {
+    const app = makeApp();
+    createCoupon(app, { validFrom: "2026-11-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" });
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an order below the coupon minimum with 400", () => {
+    const app = makeApp();
+    createCoupon(app, { minAmountCents: 20000 });
+    createOrder(app, 12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("ORDER_BELOW_MIN_AMOUNT");
+  });
+
+  it("rejects a coupon whose usage limit is reached with 400", () => {
+    const app = makeApp();
+    createCoupon(app, { usageLimit: 1 });
+    createOrder(app, 12000);
+    createOrder(app, 12000);
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = app.request("POST", "/orders/2/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_LIMIT_REACHED");
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("rejects a non-pending order with 409", () => {
+    const app = makeApp();
+    createCoupon(app);
+    createOrder(app);
+    app.request("POST", "/orders/1/pay");
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects a second coupon on the same order with 409", () => {
+    const app = makeApp();
+    createCoupon(app);
+    createOrder(app);
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = makeApp();
+    createCoupon(app);
+
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns 400 when couponCode is missing", () => {
+    const app = makeApp();
+    createOrder(app);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", {});
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+});
