index 0000000..4c5784a
--- /dev/null
+++ b/src/repositories/couponRedemptionRepository.ts
@@ -0,0 +1,61 @@
+import type { Db } from "../db.ts";
+
+export interface CouponRedemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+interface RedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
+const toRedemption = (r: RedemptionRow): CouponRedemption => ({
+  id: r.id,
+  orderId: r.order_id,
+  couponCode: r.coupon_code,
+  discountCents: r.discount_cents,
+  createdAt: r.created_at,
+});
+
+export class CouponRedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  insert(orderId: number, couponCode: string, discountCents: number, createdAt: string): void {
+    this.db
+      .prepare(
+        "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+      )
+      .run(orderId, couponCode, discountCents, createdAt);
+  }
+
+  listByOrder(orderId: number): CouponRedemption[] {
+    return (
+      this.db
+        .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ? ORDER BY id")
+        .all(orderId) as unknown as RedemptionRow[]
+    ).map(toRedemption);
+  }
+
+  /**
+   * Runs `fn` on the shared connection in a single transaction. Used to apply an
+   * order update, a usage-count increment and a redemption insert atomically.
+   */
+  transaction<T>(fn: () => T): T {
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const result = fn();
+      this.db.exec("COMMIT");
+      return result;
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
+}
