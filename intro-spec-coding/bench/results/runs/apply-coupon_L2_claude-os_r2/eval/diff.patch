diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..80ccd9d 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,11 +1,15 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
+import type { CouponRedemptionRepository } from "../repositories/couponRedemptionRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
     private readonly clock: Clock,
+    private readonly coupons: CouponRepository,
+    private readonly redemptions: CouponRedemptionRepository,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +45,59 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /**
+   * Redeems a coupon against a pending order: validates eligibility, computes the
+   * integer-cents discount and records the redemption atomically.
+   */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    const now = this.clock();
+    const order = this.get(id);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (now.getTime() > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "ORDER_BELOW_MIN_AMOUNT",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} usage limit reached`);
+    }
+
+    const discountCents = computeDiscount(order.amountCents, coupon);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    this.redemptions.transaction(() => {
+      this.orders.applyCoupon(id, discountCents, finalAmountCents, coupon.code);
+      this.coupons.incrementUsedCount(coupon.code);
+      this.redemptions.insert(id, coupon.code, discountCents, now.toISOString());
+    });
+    return this.get(id);
+  }
+}
+
+/** Discount in whole cents, capped by `maxDiscountCents` and never above the amount. */
+function computeDiscount(amountCents: number, coupon: Coupon): number {
+  const raw =
+    coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.min(capped, amountCents);
 }
