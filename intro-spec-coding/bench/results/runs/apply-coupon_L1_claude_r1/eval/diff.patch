 );
 `;
 
+/** Runs fn inside a transaction, rolling back if it throws. */
+export function withTransaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (e) {
+    db.exec("ROLLBACK");
+    throw e;
+  }
+}
+
 export function openDb(path = ":memory:"): Db {
   const db = new DatabaseSync(path);
   db.exec("PRAGMA foreign_keys = ON");
