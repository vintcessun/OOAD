@@ -41,4 +45,53 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and records the redemption. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already has coupon ${order.couponCode}`);
+    }
+    this.assertApplicable(coupon, order);
+    const discountCents = this.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const now = this.clock().toISOString();
+    withTransaction(this.db, () => {
+      this.orders.applyCoupon(id, coupon.code, discountCents, finalAmountCents);
+      this.coupons.incrementUsedCount(coupon.code);
+      this.coupons.insertRedemption(id, coupon.code, discountCents, now);
+    });
+    return this.get(id);
+  }
+
+  private assertApplicable(coupon: Coupon, order: Order): void {
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${coupon.code} is ${coupon.status}`);
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT", `order ${order.id} is below coupon minimum of ${coupon.minAmountCents}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} has reached its usage limit`);
+    }
+  }
+
+  /** FIXED: cents off. PERCENT: percentage off, rounded to the nearest cent. Capped by maxDiscountCents and the order amount. */
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    let discount = coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    return Math.min(discount, amountCents);
+  }
 }
