 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import type { RedemptionRepository } from "../repositories/redemptionRepository.ts";
+
+/**
+ * Discount in cents for an order, before capping to the order amount.
+ * PERCENT rounds down so an order is never discounted by more than the stated share.
+ */
+function computeDiscount(amountCents: number, coupon: Coupon): number {
+  const raw = coupon.type === "PERCENT" ? Math.floor((amountCents * coupon.value) / 100) : coupon.value;
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.min(capped, amountCents);
+}
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
+    private readonly redemptions: RedemptionRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +55,47 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and returns the updated order. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    const order = this.get(id);
+
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+    }
+    if (order.status !== "PENDING") {
+      throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${code} is disabled`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now.getTime() > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has reached its usage limit`);
+    }
+
+    const discountCents = computeDiscount(order.amountCents, coupon);
+    this.orders.applyCoupon(id, discountCents, order.amountCents - discountCents, code);
+    this.redemptions.insert(id, code, discountCents, now.toISOString());
+    this.coupons.incrementUsedCount(code);
+    return this.get(id);
+  }
 }
