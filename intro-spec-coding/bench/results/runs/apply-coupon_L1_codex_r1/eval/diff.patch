diff --git a/src/repositories/redemptionRepository.ts b/src/repositories/redemptionRepository.ts
new file mode 100644
index 0000000..f73f9dd
--- /dev/null
+++ b/src/repositories/redemptionRepository.ts
@@ -0,0 +1,53 @@
+import type { Db } from "../db.ts";
+
+export interface Redemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+interface RedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
+const toRedemption = (r: RedemptionRow): Redemption => ({
+  id: r.id,
+  orderId: r.order_id,
+  couponCode: r.coupon_code,
+  discountCents: r.discount_cents,
+  createdAt: r.created_at,
+});
+
+/** Audit trail of coupon redemptions (coupon_redemptions table). */
+export class RedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  insert(orderId: number, couponCode: string, discountCents: number, createdAt: string): Redemption {
+    const res = this.db
+      .prepare(
+        `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+         VALUES (?, ?, ?, ?)`,
+      )
+      .run(orderId, couponCode, discountCents, createdAt);
+    return this.findById(Number(res.lastInsertRowid))!;
+  }
+
+  findById(id: number): Redemption | undefined {
+    const row = this.db.prepare("SELECT * FROM coupon_redemptions WHERE id = ?").get(id) as
+      | RedemptionRow
+      | undefined;
+    return row && toRedemption(row);
+  }
+
+  listByOrder(orderId: number): Redemption[] {
+    return (
+      this.db.prepare("SELECT * FROM coupon_redemptions WHERE order_id = ? ORDER BY id").all(orderId) as unknown as RedemptionRow[]
+    ).map(toRedemption);
+  }
+}
