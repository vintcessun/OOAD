index 0000000..5644770
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,190 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const VALID_FROM = "2026-01-01T00:00:00Z";
+const VALID_UNTIL = "2027-01-01T00:00:00Z";
+
+function makeApp() {
+  const app = createApp({ clock: fixedClock });
+  const createCoupon = (coupon: Record<string, unknown>) =>
+    app.request("POST", "/coupons", {
+      validFrom: VALID_FROM,
+      validUntil: VALID_UNTIL,
+      ...coupon,
+    });
+  const createOrder = (amountCents: number) =>
+    app.request("POST", "/orders", { customer: "alice", amountCents });
+  return { app, createCoupon, createOrder };
+}
+
+describe("apply coupon", () => {
+  it("applies a percentage coupon", () => {
+    const { app, createCoupon, createOrder } = makeApp();
+    createCoupon({ code: "SAVE20", type: "PERCENT", value: 20 });
+    createOrder(12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+    expect(app.request("GET", "/orders/1").body).toMatchObject({
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("applies a fixed coupon", () => {
+    const { app, createCoupon, createOrder } = makeApp();
+    createCoupon({ code: "MINUS2000", type: "FIXED", value: 2000 });
+    createOrder(12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "MINUS2000" });
+
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 10000 });
+  });
+
+  it("never discounts below zero", () => {
+    const { app, createCoupon, createOrder } = makeApp();
+    createCoupon({ code: "HUGE", type: "FIXED", value: 5000 });
+    createOrder(1000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "HUGE" });
+
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("respects maxDiscountCents", () => {
+    const { app, createCoupon, createOrder } = makeApp();
+    createCoupon({ code: "HALF", type: "PERCENT", value: 50, maxDiscountCents: 3000 });
+    createOrder(12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "HALF" });
+
+    expect(res.body).toMatchObject({ discountCents: 3000, finalAmountCents: 9000 });
+  });
+
+  it("rounds percentage discounts down to whole cents", () => {
+    const { app, createCoupon, createOrder } = makeApp();
+    createCoupon({ code: "THIRTYTHREE", type: "PERCENT", value: 33 });
+    createOrder(100);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "THIRTYTHREE" });
+
+    expect(res.body).toMatchObject({ discountCents: 33, finalAmountCents: 67 });
+  });
+
