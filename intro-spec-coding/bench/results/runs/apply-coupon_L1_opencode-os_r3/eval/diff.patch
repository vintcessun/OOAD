 }
 
+export interface CouponRedemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+interface CouponRedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
 interface CouponRow {
   code: string;
   type: Coupon["type"];
@@ -57,4 +73,29 @@ export class CouponRepository {
     const row = this.db.prepare("SELECT * FROM coupons WHERE code = ?").get(code) as CouponRow | undefined;
     return row && toCoupon(row);
   }
+
+  insertRedemption(orderId: number, couponCode: string, discountCents: number, createdAt: string): void {
+    this.db
+      .prepare(
+        "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+      )
+      .run(orderId, couponCode, discountCents, createdAt);
+  }
+
+  incrementUsedCount(code: string): void {
+    this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(code);
+  }
+
+  listRedemptions(): CouponRedemption[] {
+    const rows = this.db
+      .prepare("SELECT * FROM coupon_redemptions ORDER BY id")
+      .all() as unknown as CouponRedemptionRow[];
+    return rows.map((r) => ({
+      id: r.id,
+      orderId: r.order_id,
+      couponCode: r.coupon_code,
+      discountCents: r.discount_cents,
+      createdAt: r.created_at,
+    }));
+  }
 }
diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..d7efb3f 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,22 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  applyCoupon(id: number, discountCents: number, finalAmountCents: number, couponCode: string): void {
+    this.db
+      .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+      .run(discountCents, finalAmountCents, couponCode, id);
+  }
+
+  transaction<T>(fn: () => T): T {
+    this.db.exec("BEGIN");
+    try {
+      const result = fn();
+      this.db.exec("COMMIT");
+      return result;
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
