 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 
-/** Coupon administration (create / look up). Applying coupons to orders is not implemented yet. */
+/** Coupon administration (create / look up) and coupon validation for order redemption. */
 export class CouponService {
   constructor(private readonly coupons: CouponRepository) {}
 
@@ -41,4 +41,43 @@ export class CouponService {
     if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
     return coupon;
   }
+
+  /** Validates a coupon against an order amount and returns it. Throws 400 when it cannot be used. */
+  resolveForOrder(code: unknown, amountCents: number, now: Date): Coupon {
+    if (typeof code !== "string" || code.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+    const t = now.getTime();
+    if (t < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (t > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT", `order amount ${amountCents} is below coupon minimum ${coupon.minAmountCents}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT", `coupon ${code} has reached its usage limit`);
+    }
+    return coupon;
+  }
+
+  /** Discount in cents for an order amount, capped by maxDiscountCents and never above the amount. */
+  discountFor(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(capped, amountCents));
+  }
+
+  /** Records a redemption and bumps the coupon's used count. */
+  redeem(coupon: Coupon, orderId: number, discountCents: number, now: Date): void {
+    this.coupons.insertRedemption(orderId, coupon.code, discountCents, now.toISOString());
+    this.coupons.incrementUsedCount(coupon.code);
+  }
 }
