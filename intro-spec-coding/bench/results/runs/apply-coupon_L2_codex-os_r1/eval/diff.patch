+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const IN_WINDOW = { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" };
+
+function newOrder(app: ReturnType<typeof createApp>, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function newCoupon(app: ReturnType<typeof createApp>, coupon: Record<string, unknown>): void {
+  const res = app.request("POST", "/coupons", { ...IN_WINDOW, ...coupon });
+  expect(res.status).toBe(201);
+}
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a FIXED coupon and returns the updated order", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { code: "MINUS500", type: "FIXED", value: 500, minAmountCents: 1000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "MINUS500" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "MINUS500",
+    });
+  });
+
+  it("applies a PERCENT coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+  });
+
+  it("caps a PERCENT coupon at maxDiscountCents", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { code: "SAVE50", type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE50" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 11000 });
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      couponCode: null,
+      discountCents: 0,
+      finalAmountCents: 12000,
+    });
+  });
+
+  it("rejects a DISABLED coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { code: "OFF10", type: "FIXED", value: 1000, status: "DISABLED" });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OFF10" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, {
+      code: "OLD10",
+      type: "PERCENT",
+      value: 10,
+      validFrom: "2025-01-01T00:00:00Z",
+      validUntil: "2025-06-01T00:00:00Z",
+    });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OLD10" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a coupon that is not valid yet", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, {
+      code: "SOON10",
+      type: "PERCENT",
+      value: 10,
+      validFrom: "2027-01-01T00:00:00Z",
+      validUntil: "2027-06-01T00:00:00Z",
+    });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SOON10" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a coupon when the order is below minAmountCents", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 500);
+    newCoupon(app, { code: "BIGMIN", type: "FIXED", value: 100, minAmountCents: 1000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "BIGMIN" });
+    expect(res.status).toBe(400);
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({ discountCents: 0, couponCode: null });
+  });
+
+  it("records the redemption on the coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
