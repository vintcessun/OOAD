+
+  /** Applies a coupon to a pending order, recomputing its discount and final amount. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (order.status !== "PENDING") {
+      throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    }
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+
+    this.assertCouponApplicable(coupon, order.amountCents);
+
+    const discountCents = this.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    this.coupons.incrementUsedCount(coupon.code);
+    this.coupons.recordRedemption(order.id, coupon.code, discountCents, this.clock().toISOString());
+    this.orders.applyCoupon(order.id, coupon.code, discountCents, finalAmountCents);
+
+    return this.get(id);
+  }
+
+  private assertCouponApplicable(coupon: Coupon, amountCents: number): void {
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_NOT_ACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    }
+    const now = this.clock().getTime();
+    const validFrom = Date.parse(coupon.validFrom);
+    const validUntil = Date.parse(coupon.validUntil);
+    if (!Number.isNaN(validFrom) && now < validFrom) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (!Number.isNaN(validUntil) && now > validUntil) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT",
+        `order amount ${amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT_EXCEEDED", `coupon ${coupon.code} reached its usage limit`);
+    }
+  }
+
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    let discount = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(discount, amountCents));
+  }
 }
