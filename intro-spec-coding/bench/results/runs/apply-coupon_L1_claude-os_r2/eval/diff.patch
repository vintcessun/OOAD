diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..d6385b1 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,45 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a single coupon to a pending order and records the redemption. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already has coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict("ORDER_BELOW_MIN_AMOUNT", `order ${id} is below the coupon minimum of ${coupon.minAmountCents}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has reached its usage limit`);
+    }
+
+    const raw =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    let discountCents = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    discountCents = Math.min(discountCents, order.amountCents);
+
+    const updated = this.orders.applyCoupon(id, discountCents, order.amountCents - discountCents, coupon.code);
+    this.coupons.recordRedemption(id, coupon.code, discountCents, this.clock().toISOString());
+    return updated;
+  }
 }
diff --git a/tests/coupon-application.test.ts b/tests/coupon-application.test.ts
new file mode 100644
index 0000000..a707a95
--- /dev/null
+++ b/tests/coupon-application.test.ts
@@ -0,0 +1,183 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+const makeApp = (): App => createApp({ clock: fixedClock });
+
+function addCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+function addOrder(app: App, amountCents = 12000, customer = "alice") {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return res.body as { id: number };
+}
+
+describe("apply coupon - discount math", () => {
+  it("applies a fixed amount coupon", () => {
+    const app = makeApp();
+    addCoupon(app, { type: "FIXED", value: 500 });
+    const order = addOrder(app);
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: order.id,
+      amountCents: 12000,
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("applies a percentage coupon", () => {
+    const app = makeApp();
+    addCoupon(app);
+    const order = addOrder(app);
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+  });
+
+  it("rounds a percentage discount down to whole cents", () => {
+    const app = makeApp();
+    addCoupon(app, { value: 10 });
+    const order = addOrder(app, 999);
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 99, finalAmountCents: 900 });
+  });
+
+  it("caps the discount at maxDiscountCents", () => {
+    const app = makeApp();
+    addCoupon(app, { value: 100, maxDiscountCents: 300 });
+    const order = addOrder(app, 1000);
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
