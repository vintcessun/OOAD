@@ -41,4 +43,77 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /**
+   * Applies one coupon to a pending order and returns the updated order.
+   * Checks run in the order defined by the API contract.
+   */
+  applyCoupon(id: number, rawCode: unknown): Order {
+    // 1. request body
+    if (typeof rawCode !== "string" || rawCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = rawCode.trim().toUpperCase();
+
+    // 2. order exists
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+
+    // 3. order is pending
+    if (order.status !== "PENDING") {
+      throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    }
+
+    // 4. one coupon per order
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    // 5. coupon exists
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+
+    // 6. coupon is active
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+
+    // 7/8. validity window: validFrom <= now < validUntil
+    const now = this.clock();
+    const nowMs = now.getTime();
+    if (nowMs < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (nowMs >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+
+    // 9. usage limit
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} has reached its usage limit`);
+    }
+
+    // 10. minimum amount
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below ${coupon.minAmountCents}`);
+    }
+
+    const discount = computeDiscount(order.amountCents, coupon);
+    this.orders.applyCoupon(id, code, discount, order.amountCents - discount, now.toISOString());
+    return this.get(id);
+  }
+}
+
+/** Discount in cents, never below 0 and never above the order amount. */
+function computeDiscount(
+  amountCents: number,
+  coupon: { type: "FIXED" | "PERCENT"; value: number; maxDiscountCents: number | null },
+): number {
+  let discount =
+    coupon.type === "FIXED"
+      ? coupon.value
+      : Math.floor((amountCents * coupon.value) / 100); // percent, rounded down
+  if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+  discount = Math.min(discount, amountCents);
+  return Math.max(discount, 0);
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..ec2e453
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,218 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+interface CouponInput {
+  code: string;
+  type: "FIXED" | "PERCENT";
+  value: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function setup(coupon: CouponInput, amountCents = 10000): { app: App; orderId: number } {
+  const app = createApp({ clock: fixedClock });
+  const created = app.request("POST", "/coupons", {
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...coupon,
+  });
+  expect(created.status).toBe(201);
+  const order = app.request("POST", "/orders", { customer: "alice", amountCents });
+  return { app, orderId: (order.body as any).id };
+}
+
+const apply = (app: App, orderId: number, couponCode: unknown) =>
+  app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode });
+
+const redemptionCount = (app: App): number =>
+  (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number }).n;
+
+describe("apply coupon", () => {
+  it("AC-01: percent discount", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: orderId,
+      amountCents: 10000,
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("AC-02: fixed discount", () => {
+    const { app, orderId } = setup({ code: "OFF1500", type: "FIXED", value: 1500 });
+    expect(apply(app, orderId, "OFF1500").body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 8500,
+    });
+  });
+
+  it("AC-03: percent discount is capped for large orders", () => {
+    const { app, orderId } = setup(
+      { code: "BIG20", type: "PERCENT", value: 20, maxDiscountCents: 5000 },
+      1_000_000,
+    );
+    expect(apply(app, orderId, "BIG20").body).toMatchObject({
+      discountCents: 5000,
+      finalAmountCents: 995_000,
+    });
+  });
+
+  it("AC-04: discount never exceeds the order amount", () => {
+    const { app, orderId } = setup({ code: "FIXED3000", type: "FIXED", value: 3000 }, 1000);
+    expect(apply(app, orderId, "FIXED3000").body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("AC-06: allows an order exactly at the minimum amount", () => {
+    const { app, orderId } = setup(
+      { code: "MIN5000", type: "FIXED", value: 100, minAmountCents: 5000 },
+      5000,
+    );
+    expect(apply(app, orderId, "MIN5000").status).toBe(200);
+  });
+
+  it("AC-07: validFrom is inclusive, validUntil is exclusive", () => {
+    const { app, orderId } = setup({
+      code: "EDGE",
+      type: "FIXED",
+      value: 100,
+      validFrom: NOW,
+      validUntil: NOW,
+    });
+    expect(apply(app, orderId, "EDGE")).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_EXPIRED" } },
+    });
+
+    const at = setup({ code: "EDGE2", type: "FIXED", value: 100, validFrom: NOW, validUntil: "2027-01-01T00:00:00Z" });
+    expect(apply(at.app, at.orderId, "EDGE2").status).toBe(200);
+  });
+
+  it("AC-08: an order cannot use a second coupon", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    apply(app, orderId, "SAVE20");
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 409, body: { error: { code: "COUPON_ALREADY_APPLIED" } } });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(redemptionCount(app)).toBe(1);
+  });
+
+  it("AC-09: records usage on the coupon", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    apply(app, orderId, "SAVE20");
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const row = app.db
+      .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ?")
+      .get(orderId) as any;
+    expect(row).toMatchObject({
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: new Date(NOW).toISOString(),
+    });
+  });
+
+  it("AC-10: trims and upper-cases the coupon code", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    expect(apply(app, orderId, " save20 ").status).toBe(200);
+  });
+
+  it("returns the same order as GET", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const applied = apply(app, orderId, "SAVE20");
+    expect(applied.body).toEqual(app.request("GET", `/orders/${orderId}`).body);
+  });
+});
+
+describe("apply coupon errors", () => {
+  const cases: Array<[string, unknown, number, string]> = [
+    ["missing code", undefined, 400, "INVALID_REQUEST"],
+    ["non-string code", 123, 400, "INVALID_REQUEST"],
+    ["blank code", "   ", 400, "INVALID_REQUEST"],
+  ];
+
+  it.each(cases)("rejects %s", (_label, code, status, errorCode) => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = apply(app, orderId, code);
+    expect(res).toMatchObject({ status, body: { error: { code: errorCode } } });
+  });
+
+  it("rejects an unknown order before anything else", () => {
+    const app = createApp({ clock: fixedClock });
+    const res = apply(app, 99, "SAVE20");
+    expect(res).toMatchObject({ status: 404, body: { error: { code: "ORDER_NOT_FOUND" } } });
+  });
+
+  it("rejects a paid order", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    app.request("POST", `/orders/${orderId}/pay`);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 409, body: { error: { code: "ORDER_NOT_PENDING" } } });
+  });
+
+  it("rejects an unknown coupon", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = apply(app, orderId, "NOPE");
+    expect(res).toMatchObject({ status: 404, body: { error: { code: "COUPON_NOT_FOUND" } } });
+  });
+
+  it("rejects a disabled coupon", () => {
+    const { app, orderId } = setup({ code: "SAVE20", type: "PERCENT", value: 20, status: "DISABLED" });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 400, body: { error: { code: "COUPON_INACTIVE" } } });
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const { app, orderId } = setup({
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      validFrom: "2027-01-01T00:00:00Z",
+    });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 400, body: { error: { code: "COUPON_NOT_YET_VALID" } } });
+  });
+
+  it("rejects an exhausted coupon", () => {
+    const { app, orderId } = setup({
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      usageLimit: 0,
+    });
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 400, body: { error: { code: "COUPON_USAGE_EXHAUSTED" } } });
+  });
+
+  it("rejects an order below the minimum amount without changing anything", () => {
+    const { app, orderId } = setup(
+      { code: "SAVE20", type: "PERCENT", value: 20, minAmountCents: 20000 },
+      10000,
+    );
+    const res = apply(app, orderId, "SAVE20");
+    expect(res).toMatchObject({ status: 400, body: { error: { code: "MINIMUM_NOT_MET" } } });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(redemptionCount(app)).toBe(0);
+  });
+});
