+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,268 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+function newApp(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}): any {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+function createOrder(app: App, amountCents: number): any {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+function apply(app: App, id: number, couponCode: unknown) {
+  return app.request("POST", `/orders/${id}/apply-coupon`, { couponCode });
+}
+
+function redemptionCount(app: App, orderId: number, code: string): number {
+  const row = app.db
+    .prepare("SELECT COUNT(*) AS n FROM coupon_redemptions WHERE order_id = ? AND coupon_code = ?")
+    .get(orderId, code) as { n: number };
+  return row.n;
+}
+
+describe("apply coupon: discounts", () => {
+  it("AC-01 percent reduces the amount", () => {
+    const app = newApp();
+    createCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    const order = createOrder(app, 10000);
+    const res = apply(app, order.id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-02 fixed reduces the amount", () => {
+    const app = newApp();
+    createCoupon(app, { code: "FIX1500", type: "FIXED", value: 1500 });
+    const order = createOrder(app, 10000);
+    expect(apply(app, order.id, "FIX1500").body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 uncapped percent can exceed the per-order hard cap check is 20000 > 10000 so capped", () => {
+    const app = newApp();
+    createCoupon(app, { code: "BIG20", type: "PERCENT", value: 20, maxDiscountCents: null });
+    const order = createOrder(app, 100000);
+    expect(apply(app, order.id, "BIG20").body).toMatchObject({ discountCents: 10000, finalAmountCents: 90000 });
+  });
+
+  it("AC-04 fixed larger than the amount discounts to zero", () => {
+    const app = newApp();
+    createCoupon(app, { code: "FIX3000", type: "FIXED", value: 3000 });
+    const order = createOrder(app, 1000);
+    expect(apply(app, order.id, "FIX3000").body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05 percent rounds down", () => {
+    const app = newApp();
+    createCoupon(app, { code: "P15", type: "PERCENT", value: 15 });
+    const order = createOrder(app, 999);
+    expect(apply(app, order.id, "P15").body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("AC-06 amount equal to the minimum is accepted", () => {
+    const app = newApp();
+    createCoupon(app, { code: "MIN1000", type: "FIXED", value: 100, minAmountCents: 1000 });
+    const order = createOrder(app, 1000);
+    expect(apply(app, order.id, "MIN1000").status).toBe(200);
+  });
+
