+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+function setup(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function createOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+const apply = (app: App, id: number, body: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+const order = (app: App, id: number) => app.request("GET", `/orders/${id}`).body as Record<string, unknown>;
+
+describe("apply coupon - discount computation", () => {
+  it("AC-01 applies a percent coupon", () => {
+    const app = setup();
+    createCoupon(app, { type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20", status: "PENDING" });
+  });
+
+  it("AC-02 applies a fixed coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "FLAT15", type: "FIXED", value: 1500 });
+    const id = createOrder(app, 10000);
+
+    expect(apply(app, id, { couponCode: "FLAT15" }).body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 caps a percent coupon at maxDiscountCents", () => {
+    const app = setup();
+    createCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const id = createOrder(app, 100000);
+
+    expect(apply(app, id, { couponCode: "SAVE20" }).body).toMatchObject({ discountCents: 5000 });
+  });
+
+  it("AC-04 never discounts below zero", () => {
+    const app = setup();
+    createCoupon(app, { code: "BIG", type: "FIXED", value: 3000 });
+    const id = createOrder(app, 1000);
+
+    expect(apply(app, id, { couponCode: "BIG" }).body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05 floors a fractional percent discount", () => {
+    const app = setup();
+    createCoupon(app, { code: "OFF15", type: "PERCENT", value: 15 });
+    const id = createOrder(app, 999);
+
+    expect(apply(app, id, { couponCode: "OFF15" }).body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-06 accepts an amount exactly at the minimum", () => {
+    const app = setup();
+    createCoupon(app, { code: "MIN5K", type: "FIXED", value: 500, minAmountCents: 5000 });
+    const id = createOrder(app, 5000);
+
+    expect(apply(app, id, { couponCode: "MIN5K" }).status).toBe(200);
+  });
+
+  it("AC-10 normalizes case and surrounding whitespace", () => {
+    const app = setup();
+    createCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+
+    const res = apply(app, id, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2000 });
+  });
+});
+
+describe("apply coupon - validity window", () => {
+  it("AC-07 rejects when now equals validUntil", () => {
+    const app = setup();
+    createCoupon(app, { validFrom: "2025-01-01T00:00:00Z", validUntil: NOW });
+    const id = createOrder(app, 10000);
+
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("AC-07 accepts when now equals validFrom", () => {
+    const app = setup();
+    createCoupon(app, { validFrom: NOW, validUntil: "2027-01-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+
+    expect(apply(app, id, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const app = setup();
+    createCoupon(app, { validFrom: "2026-11-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+});
+
+describe("apply coupon - single use per order", () => {
+  it("AC-08 rejects a second application and leaves amounts unchanged", () => {
+    const app = setup();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    expect(apply(app, id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(order(app, id)).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("rejects a different coupon once one is applied", () => {
+    const app = setup();
+    createCoupon(app, { code: "SAVE20" });
+    createCoupon(app, { code: "OTHER", type: "FIXED", value: 100 });
+    const id = createOrder(app, 10000);
+    apply(app, id, { couponCode: "SAVE20" });
+
+    const res = apply(app, id, { couponCode: "OTHER" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+});
+
+describe("apply coupon - persistence", () => {
+  it("AC-09 increments usedCount and records a redemption", () => {
+    const app = setup();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    apply(app, id, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(new CouponRepository(app.db).countRedemptions("SAVE20")).toBe(1);
+  });
+
+  it("returns exactly what GET /orders/:id returns", () => {
+    const app = setup();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+
+    const applied = apply(app, id, { couponCode: "SAVE20" });
+    expect(applied.body).toEqual(app.request("GET", `/orders/${id}`).body);
+  });
+
+  it("rolls back every write when a statement fails mid-transaction", () => {
+    const app = setup();
+    const id = createOrder(app, 10000);
+    const orders = new OrderRepository(app.db);
+    const coupons = new CouponRepository(app.db);
+
+    expect(() => orders.applyCoupon(id, "GHOST", 100, 9900, NOW)).toThrow();
+    expect(orders.findById(id)).toMatchObject({ discountCents: 0, finalAmountCents: 10000, couponCode: null });
+    expect(coupons.countRedemptions("GHOST")).toBe(0);
+  });
+});
+
+describe("apply coupon - rejections", () => {
+  it.each([
+    ["missing couponCode", {}],
+    ["non-string couponCode", { couponCode: 123 }],
+    ["blank couponCode", { couponCode: "   " }],
+  ])("rejects %s with INVALID_REQUEST", (_name, body) => {
+    const app = setup();
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, body);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("rejects an unknown order with ORDER_NOT_FOUND", () => {
+    const app = setup();
+    const res = apply(app, 999, { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects unknown, disabled, exhausted and below-minimum coupons", () => {
+    const app = setup();
+    createCoupon(app, { code: "OFF", status: "DISABLED" });
+    createCoupon(app, { code: "USED", usageLimit: 1 });
+    createCoupon(app, { code: "MIN", minAmountCents: 999999 });
+
+    const cases: Array<[string, number]> = [
+      ["NOSUCH", 404],
+      ["OFF", 400],
+      ["MIN", 400],
+    ];
+    for (const [code, status] of cases) {
+      const id = createOrder(app, 10000);
+      const res = apply(app, id, { couponCode: code });
+      expect(res.status).toBe(status);
+      expect((res.body as any).error.code).toBe(
+        code === "NOSUCH" ? "COUPON_NOT_FOUND" : code === "OFF" ? "COUPON_INACTIVE" : "MINIMUM_NOT_MET",
+      );
+    }
+  });
+
+  it("rejects an exhausted coupon with COUPON_USAGE_EXHAUSTED", () => {
