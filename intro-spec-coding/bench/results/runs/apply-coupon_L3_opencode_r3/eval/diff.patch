diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..93491dd 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,29 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  /** Atomically records a coupon application: order totals, redemption row and usage counter. */
+  applyCoupon(params: {
+    orderId: number;
+    discountCents: number;
+    finalAmountCents: number;
+    couponCode: string;
+    createdAt: string;
+  }): void {
+    const db = this.db;
+    db.exec("BEGIN");
+    try {
+      db.prepare(
+        "UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?",
+      ).run(params.discountCents, params.finalAmountCents, params.couponCode, params.orderId);
+      db.prepare(
+        "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+      ).run(params.orderId, params.couponCode, params.discountCents, params.createdAt);
+      db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(params.couponCode);
+      db.exec("COMMIT");
+    } catch (e) {
+      db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
