@@ -41,4 +43,45 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(couponCode.trim());
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw conflict("COUPON_NOT_ACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    }
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} usage limit reached`);
+    }
+
+    const raw = coupon.type === "PERCENT" ? Math.floor((order.amountCents * coupon.value) / 100) : coupon.value;
+    let discount = coupon.maxDiscountCents !== null ? Math.min(raw, coupon.maxDiscountCents) : raw;
+    discount = Math.max(0, Math.min(discount, order.amountCents));
+
+    this.orders.applyCoupon(id, coupon.code, discount, order.amountCents - discount, this.clock().toISOString());
+    return this.get(id);
+  }
 }
