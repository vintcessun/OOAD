   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +43,51 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    if (order.status !== "PENDING") {
+      throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    }
+
+    const code = couponCode.trim();
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has no remaining uses`);
+    }
+
+    const discountCents = discountFor(order.amountCents, coupon);
+    this.orders.applyCoupon(id, coupon.code, discountCents);
+    this.coupons.recordRedemption(id, coupon.code, discountCents, this.clock().toISOString());
+    return this.get(id);
+  }
+}
+
+/** Discount in cents for an order amount; never more than the amount itself. */
+function discountFor(amountCents: number, coupon: Coupon): number {
+  const raw =
+    coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.max(0, Math.min(capped, amountCents));
 }
