@@ -0,0 +1,134 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const COUPON = {
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+function setup() {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  return app;
+}
+
+function createCoupon(app: ReturnType<typeof createApp>, coupon: Record<string, unknown>) {
+  const res = app.request("POST", "/coupons", { ...COUPON, ...coupon });
+  expect(res.status).toBe(201);
+}
+
+describe("apply coupon", () => {
+  it("applies a valid FIXED coupon and returns 200", () => {
+    const app = setup();
+    createCoupon(app, { code: "SAVE20", type: "FIXED", value: 2000 });
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 10000,
+    });
+  });
+
+  it("applies a valid PERCENT coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "PCT20", type: "PERCENT", value: 20 });
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "PCT20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600 });
+  });
+
+  it("caps a PERCENT discount at maxDiscountCents", () => {
+    const app = setup();
+    createCoupon(app, { code: "CAP", type: "PERCENT", value: 50, maxDiscountCents: 3000 });
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "CAP" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 3000, finalAmountCents: 9000 });
+  });
+
+  it("records a redemption and increments used_count", () => {
+    const app = setup();
+    createCoupon(app, { code: "USE", type: "FIXED", value: 500 });
+
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "USE" });
+
+    expect(app.request("GET", "/coupons/USE").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("rejects an unknown coupon with 400", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const app = setup();
+    createCoupon(app, { code: "OFF", type: "FIXED", value: 500, status: "DISABLED" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = setup();
+    createCoupon(app, {
+      code: "OLD",
+      type: "FIXED",
+      value: 500,
+      validFrom: "2025-01-01T00:00:00Z",
+      validUntil: "2026-09-01T00:00:00Z",
+    });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a not-yet-valid coupon with 400", () => {
+    const app = setup();
+    createCoupon(app, {
+      code: "SOON",
+      type: "FIXED",
+      value: 500,
+      validFrom: "2027-01-01T00:00:00Z",
+      validUntil: "2028-01-01T00:00:00Z",
+    });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SOON" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects an order below minAmountCents with 400", () => {
+    const app = setup();
+    createCoupon(app, { code: "BIG", type: "FIXED", value: 500, minAmountCents: 20000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIG" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a missing couponCode with 400", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", {});
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = createApp({ clock: fixedClock });
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+  });
+
+  it("does not change the order when the coupon is rejected", () => {
+    const app = setup();
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(app.request("GET", "/orders/1").body).toMatchObject({
+      couponCode: null,
+      discountCents: 0,
+      finalAmountCents: 12000,
+    });
+  });
+});
