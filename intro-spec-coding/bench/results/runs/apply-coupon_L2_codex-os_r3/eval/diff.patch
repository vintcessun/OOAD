+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function makeApp() {
+  const app = createApp({ clock: fixedClock });
+  const order = app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  return { app, orderId: (order.body as any).id as number };
+}
+
+function createCoupon(app: ReturnType<typeof createApp>, overrides: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+describe("apply coupon", () => {
+  it("applies a FIXED coupon and returns the discounted order", () => {
+    const { app, orderId } = makeApp();
+    createCoupon(app, { code: "FLAT5", type: "FIXED", value: 500 });
+
+    const res = app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode: "FLAT5" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: orderId,
+      amountCents: 12000,
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "FLAT5",
+    });
+  });
+
+  it("applies a PERCENT coupon", () => {
+    const { app, orderId } = makeApp();
+    createCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+
+    const res = app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+  });
+
+  it("rejects an unknown coupon", () => {
+    const { app, orderId } = makeApp();
+    const res = app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const { app, orderId } = makeApp();
+    createCoupon(app, { code: "OFF", type: "FIXED", value: 100, status: "DISABLED" });
+    const res = app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("rejects an expired coupon", () => {
+    const { app, orderId } = makeApp();
+    createCoupon(app, {
+      code: "OLD",
+      type: "FIXED",
+      value: 100,
+      validFrom: "2025-01-01T00:00:00Z",
+      validUntil: "2026-01-01T00:00:00Z",
+    });
+    const res = app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a coupon below the order minimum", () => {
