diff --git a/src/db.ts b/src/db.ts
index de673a1..6fe0368 100755
--- a/src/db.ts
+++ b/src/db.ts
@@ -42,3 +42,16 @@ export function openDb(path = ":memory:"): Db {
   db.exec(SCHEMA);
   return db;
 }
+
+/** Runs `fn` inside a single SQLite transaction, rolling back if it throws. */
+export function transaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (error) {
+    db.exec("ROLLBACK");
+    throw error;
+  }
+}
