diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..9314cdb 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -1,3 +1,4 @@
+import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Db } from "../db.ts";
 
 export interface Order {
@@ -57,4 +58,52 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  /**
+   * Applies a coupon to a pending order: order totals, the redemption row and the
+   * coupon's usage counter land together or not at all.
+   *
+   * The service checks every rule before calling this, so the conditions re-checked
+   * here only close the race window between that check and the write.
+   */
+  applyCoupon(orderId: number, couponCode: string, discountCents: number, createdAt: string): Order {
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const order = this.findById(orderId);
+      if (!order) throw notFound("ORDER_NOT_FOUND", `order ${orderId} not found`);
+      if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${orderId} is ${order.status}`);
+      if (order.couponCode !== null) {
+        throw conflict("COUPON_ALREADY_APPLIED", `order ${orderId} already used coupon ${order.couponCode}`);
+      }
+
+      const used = this.db
+        .prepare(
+          `UPDATE coupons SET used_count = used_count + 1
+            WHERE code = ? AND (usage_limit IS NULL OR used_count < usage_limit)`,
+        )
+        .run(couponCode);
+      if (Number(used.changes) === 0) {
+        throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${couponCode} has no uses left`);
+      }
+
+      this.db
+        .prepare(
+          `UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?`,
+        )
+        .run(discountCents, order.amountCents - discountCents, couponCode, orderId);
+      this.db
+        .prepare(
+          `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+           VALUES (?, ?, ?, ?)`,
+        )
+        .run(orderId, couponCode, discountCents, createdAt);
+
+      const updated = this.findById(orderId)!;
+      this.db.exec("COMMIT");
+      return updated;
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
 }
