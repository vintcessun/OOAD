+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = createApp({ clock: fixedClock });
+    setupCoupon(app, { validFrom: "2025-01-01T00:00:00Z", validUntil: "2025-12-31T00:00:00Z" });
