@@ -0,0 +1,12 @@
+import type { Coupon } from "../repositories/couponRepository.ts";
+
+/**
+ * Discount for a coupon against an order amount, in integer cents.
+ * FIXED subtracts its value; PERCENT takes a rounded percentage. The result is
+ * capped by maxDiscountCents (when set) and never exceeds the order amount.
+ */
+export function computeDiscount(coupon: Coupon, amountCents: number): number {
+  const raw = coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.min(capped, amountCents);
+}
diff --git a/src/services/redemptionService.ts b/src/services/redemptionService.ts
