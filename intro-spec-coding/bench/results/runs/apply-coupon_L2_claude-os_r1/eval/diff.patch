@@ -0,0 +1,211 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import type { Coupon } from "../src/repositories/couponRepository.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+import { computeDiscount } from "../src/services/discount.ts";
+
+const coupon = (over: Partial<Coupon> = {}): Coupon => ({
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  minAmountCents: 0,
+  maxDiscountCents: null,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  status: "ACTIVE",
+  usageLimit: null,
+  usedCount: 0,
+  ...over,
+});
+
+describe("computeDiscount", () => {
+  it("subtracts a fixed amount", () => {
+    expect(computeDiscount(coupon({ type: "FIXED", value: 2000 }), 12000)).toBe(2000);
+  });
+
+  it("takes a percentage of the order amount", () => {
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 20 }), 12000)).toBe(2400);
+  });
+
+  it("caps a percentage at maxDiscountCents", () => {
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 50, maxDiscountCents: 1000 }), 12000)).toBe(1000);
+  });
+
+  it("never exceeds the order amount", () => {
+    expect(computeDiscount(coupon({ type: "FIXED", value: 99999 }), 500)).toBe(500);
+  });
+});
+
+describe("redemption repositories", () => {
+  it("writes the discount onto the order", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const order = orders.insert("alice", 12000, "2026-10-01T00:00:00.000Z");
+    orders.updateDiscount(order.id, { discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("records a redemption and increments the used count", () => {
+    const db = openDb();
+    const coupons = new CouponRepository(db);
+    const orders = new OrderRepository(db);
+    const order = orders.insert("alice", 12000, "2026-10-01T00:00:00.000Z");
+    coupons.insert(coupon());
+    coupons.recordRedemption(order.id, "SAVE20", 2400, "2026-10-01T00:00:00.000Z");
+    coupons.incrementUsedCount("SAVE20");
+    expect(coupons.findByCode("SAVE20")!.usedCount).toBe(1);
+    const row = db.prepare("SELECT * FROM coupon_redemptions").get() as any;
+    expect(row).toMatchObject({ order_id: order.id, coupon_code: "SAVE20", discount_cents: 2400 });
+  });
+});
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function setupCoupon(app: ReturnType<typeof createApp>, over: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...over,
+  });
+  if (res.status !== 201) throw new Error(`coupon setup failed: ${JSON.stringify(res.body)}`);
+  return res;
+}
+
+function setupOrder(app: ReturnType<typeof createApp>, amountCents = 12000) {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  if (res.status !== 201) throw new Error(`order setup failed: ${JSON.stringify(res.body)}`);
+  return res.body as { id: number };
+}
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a PERCENT coupon and returns the updated order", () => {
+    const app = createApp({ clock: fixedClock });
+    setupCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    const order = setupOrder(app, 12000);
+
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: order.id,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("applies a FIXED coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    setupCoupon(app, { code: "FLAT20", type: "FIXED", value: 2000 });
+    const order = setupOrder(app, 12000);
+
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "FLAT20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 10000, couponCode: "FLAT20" });
+  });
+
+  it("persists the discount so a later read shows it", () => {
+    const app = createApp({ clock: fixedClock });
+    setupCoupon(app);
+    const order = setupOrder(app, 12000);
+    app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+  });
+});
+
+describe("apply-coupon rejections", () => {
+  it("rejects a missing or non-string couponCode", () => {
+    const app = createApp({ clock: fixedClock });
+    const order = setupOrder(app);
+    expect(app.request("POST", `/orders/${order.id}/apply-coupon`, {}).status).toBe(400);
+    expect(app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: 7 }).status).toBe(400);
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = createApp({ clock: fixedClock });
+    setupCoupon(app);
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects an unknown coupon with 400", () => {
+    const app = createApp({ clock: fixedClock });
+    const order = setupOrder(app);
+    const res = app.request("POST", `/orders/${order.id}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon with 400", () => {
