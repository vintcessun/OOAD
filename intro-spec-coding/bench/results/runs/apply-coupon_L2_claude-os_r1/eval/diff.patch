--- /dev/null
+++ b/src/services/redemptionService.ts
@@ -0,0 +1,66 @@
+import type { Clock } from "../clock.ts";
+import type { Db } from "../db.ts";
+import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
+import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import { computeDiscount } from "./discount.ts";
+
+/** Applies a coupon to an order: validates it, writes the discount and records the redemption. */
+export class RedemptionService {
+  constructor(
+    private readonly db: Db,
+    private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
+    private readonly clock: Clock,
+  ) {}
+
+  apply(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+
+    const coupon = this.findRedeemableCoupon(couponCode.trim(), order);
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const now = this.clock().toISOString();
+
+    this.db.exec("BEGIN");
+    try {
+      this.orders.updateDiscount(id, { discountCents, finalAmountCents, couponCode: coupon.code });
+      this.coupons.recordRedemption(id, coupon.code, discountCents, now);
+      this.coupons.incrementUsedCount(coupon.code);
+      this.db.exec("COMMIT");
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+
+    return this.orders.findById(id)!;
+  }
+
+  private findRedeemableCoupon(code: string, order: Order): Coupon {
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    }
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order ${order.id} amount ${order.amountCents} is below minimum ${coupon.minAmountCents}`,
+      );
+    }
+    return coupon;
+  }
+}
diff --git a/tests/redemption.test.ts b/tests/redemption.test.ts
new file mode 100644
index 0000000..ac0d173
