@@ -0,0 +1,246 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = new Date("2026-10-01T08:00:00Z");
+const fixedClock = () => NOW;
+
+const newApp = (): App => createApp({ clock: fixedClock });
+
+interface CouponOverrides {
+  code?: string;
+  type?: "FIXED" | "PERCENT";
+  value?: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function createCoupon(app: App, overrides: CouponOverrides = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    minAmountCents: 0,
+    maxDiscountCents: null,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    status: "ACTIVE",
+    usageLimit: null,
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+function createOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function apply(app: App, orderId: number, couponCode: unknown) {
+  return app.request("POST", `/orders/${orderId}/apply-coupon`, { couponCode });
+}
+
+function expectError(res: { status: number; body: unknown }, status: number, code: string) {
+  expect(res.status).toBe(status);
+  expect((res.body as any).error.code).toBe(code);
+}
+
+describe("apply coupon - discount calculation", () => {
+  it("AC-01: PERCENT computes floor(amount * value / 100)", () => {
+    const app = newApp();
+    createCoupon(app, { type: "PERCENT", value: 20 });
+    const orderId = createOrder(app, 10000);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02: FIXED subtracts its value", () => {
+    const app = newApp();
+    createCoupon(app, { type: "FIXED", value: 1500 });
+    const orderId = createOrder(app, 10000);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: maxDiscountCents caps a PERCENT discount", () => {
+    const app = newApp();
+    createCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const orderId = createOrder(app, 100000);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 5000 });
+  });
+
+  it("AC-05: PERCENT rounds down", () => {
+    const app = newApp();
+    createCoupon(app, { type: "PERCENT", value: 15 });
+    const orderId = createOrder(app, 999);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-04: discount never exceeds the order amount", () => {
+    const app = newApp();
+    createCoupon(app, { type: "FIXED", value: 3000 });
+    const orderId = createOrder(app, 1000);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-06: amount equal to minAmountCents is allowed", () => {
+    const app = newApp();
+    createCoupon(app, { minAmountCents: 5000 });
+    const orderId = createOrder(app, 5000);
+    const res = apply(app, orderId, "SAVE20");
+    expect(res.status).toBe(200);
+  });
+});
+
+describe("apply coupon - validity window", () => {
+  it("AC-07: now == validFrom is accepted", () => {
+    const app = newApp();
+    createCoupon(app, { validFrom: NOW.toISOString(), validUntil: "2027-01-01T00:00:00Z" });
+    const orderId = createOrder(app, 10000);
+    expect(apply(app, orderId, "SAVE20").status).toBe(200);
+  });
+
+  it("AC-07: now == validUntil is expired", () => {
+    const app = newApp();
+    createCoupon(app, { validFrom: "2026-01-01T00:00:00Z", validUntil: NOW.toISOString() });
+    const orderId = createOrder(app, 10000);
+    expectError(apply(app, orderId, "SAVE20"), 400, "COUPON_EXPIRED");
+  });
+});
+
+describe("apply coupon - normalization and response", () => {
+  it("AC-10: trims and uppercases the submitted code", () => {
+    const app = newApp();
+    createCoupon(app, { code: "SAVE20" });
+    const orderId = createOrder(app, 10000);
+    const res = apply(app, orderId, " save20 ");
+    expect(res.status).toBe(200);
+    expect((res.body as any).couponCode).toBe("SAVE20");
+  });
+
+  it("REQ-14: response equals the subsequent GET /orders/:id", () => {
+    const app = newApp();
+    createCoupon(app, { code: "SAVE20" });
+    const orderId = createOrder(app, 10000);
+    const applied = apply(app, orderId, "SAVE20");
