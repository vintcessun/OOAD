+    expect(applied.status).toBe(200);
+    expect(applied.body).toEqual(fetched.body);
+  });
+});
+
+describe("apply coupon - rejections leave no side effects", () => {
+  it("REQ-13: missing, non-string or blank code is INVALID_REQUEST", () => {
+    const app = newApp();
+    const orderId = createOrder(app, 10000);
+    expectError(app.request("POST", `/orders/${orderId}/apply-coupon`, {}), 400, "INVALID_REQUEST");
+    expectError(apply(app, orderId, 123), 400, "INVALID_REQUEST");
+    expectError(apply(app, orderId, "   "), 400, "INVALID_REQUEST");
+  });
+
+  it("unknown order is ORDER_NOT_FOUND", () => {
+    const app = newApp();
+    expectError(apply(app, 99, "SAVE20"), 404, "ORDER_NOT_FOUND");
+  });
+
+  it("non-pending order is ORDER_NOT_PENDING", () => {
+    const app = newApp();
+    createCoupon(app);
+    const orderId = createOrder(app, 10000);
+    app.request("POST", `/orders/${orderId}/pay`);
+    expectError(apply(app, orderId, "SAVE20"), 409, "ORDER_NOT_PENDING");
+  });
+
+  it("unknown coupon is COUPON_NOT_FOUND", () => {
+    const app = newApp();
+    const orderId = createOrder(app, 10000);
+    expectError(apply(app, orderId, "NOPE"), 404, "COUPON_NOT_FOUND");
+  });
+
+  it("disabled coupon is COUPON_INACTIVE", () => {
+    const app = newApp();
+    createCoupon(app, { status: "DISABLED" });
+    const orderId = createOrder(app, 10000);
+    expectError(apply(app, orderId, "SAVE20"), 400, "COUPON_INACTIVE");
+  });
+
+  it("not-yet-valid coupon is COUPON_NOT_YET_VALID", () => {
+    const app = newApp();
+    createCoupon(app, { validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const orderId = createOrder(app, 10000);
+    expectError(apply(app, orderId, "SAVE20"), 400, "COUPON_NOT_YET_VALID");
+  });
+
+  it("exhausted usage is COUPON_USAGE_EXHAUSTED", () => {
+    const app = newApp();
+    createCoupon(app, { usageLimit: 1 });
+    const first = createOrder(app, 10000);
+    const second = createOrder(app, 10000);
+    expect(apply(app, first, "SAVE20").status).toBe(200);
+    expectError(apply(app, second, "SAVE20"), 400, "COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("below minimum is MINIMUM_NOT_MET", () => {
+    const app = newApp();
+    createCoupon(app, { minAmountCents: 5000 });
+    const orderId = createOrder(app, 4999);
+    expectError(apply(app, orderId, "SAVE20"), 400, "MINIMUM_NOT_MET");
+  });
+
+  it("error precedence: order checks precede coupon checks", () => {
+    const app = newApp();
+    const orderId = createOrder(app, 10000);
+    app.request("POST", `/orders/${orderId}/pay`);
+    expectError(apply(app, orderId, "DOES-NOT-EXIST"), 409, "ORDER_NOT_PENDING");
+  });
+});
+
+describe("apply coupon - single use per order and persistence", () => {
+  it("AC-08: a second application is rejected and amounts are unchanged", () => {
+    const app = newApp();
+    createCoupon(app);
+    const orderId = createOrder(app, 10000);
+    const first = apply(app, orderId, "SAVE20");
