+describe("apply coupon — redemption tracking", () => {
+  it("increments usedCount and writes a redemption row", () => {
+    const app = setup();
+    newCoupon(app, { code: "P20", type: "PERCENT", value: 20 });
+    const id = newOrder(app, 10000);
+
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "P20" });
+
+    expect(app.request("GET", "/coupons/P20").body).toMatchObject({ usedCount: 1 });
+
+    const rows = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents FROM coupon_redemptions")
+      .all() as Array<{ order_id: number; coupon_code: string; discount_cents: number }>;
+    expect(rows).toEqual([{ order_id: id, coupon_code: "P20", discount_cents: 2000 }]);
+  });
+
+  it("leaves no side effects when a rule rejects the request", () => {
+    const app = setup();
+    newCoupon(app, { code: "MIN", type: "FIXED", value: 100, minAmountCents: 2000 });
+    const id = newOrder(app, 1000);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "MIN" });
+
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("COUPON_MIN_AMOUNT_NOT_MET");
+    expect(app.request("GET", "/coupons/MIN").body).toMatchObject({ usedCount: 0 });
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 1000,
+      couponCode: null,
+    });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 0 });
+  });
+});
