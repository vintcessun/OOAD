index 0000000..3e5e165
--- /dev/null
+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,216 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const OPEN = { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" };
+
+function setup(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function newOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function newCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    ...OPEN,
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+const errorCode = (res: { body: unknown }) => (res.body as any).error.code;
+
+describe("apply coupon — discount math", () => {
+  it("applies a fixed discount", () => {
+    const app = setup();
+    newCoupon(app, { code: "FLAT500", type: "FIXED", value: 500 });
+    const id = newOrder(app, 12000);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "FLAT500" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "FLAT500",
+      status: "PENDING",
+    });
+  });
+
+  it("floors a percentage discount", () => {
