@@ -8,4 +8,8 @@ export function registerOrderRoutes(router: Router, orders: OrderService): void
   router.add("GET", "/orders/:id", (p) => ({ status: 200, body: orders.get(parseId(p.id)) }));
   router.add("POST", "/orders/:id/pay", (p) => ({ status: 200, body: orders.pay(parseId(p.id)) }));
   router.add("POST", "/orders/:id/cancel", (p) => ({ status: 200, body: orders.cancel(parseId(p.id)) }));
+  router.add("POST", "/orders/:id/apply-coupon", (p, b) => ({
+    status: 200,
+    body: orders.applyCoupon(parseId(p.id), b?.couponCode),
+  }));
 }
diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..a455fb5 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,11 +1,15 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
+import type { CouponRedemptionRepository } from "../repositories/couponRedemptionRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
     private readonly clock: Clock,
+    private readonly coupons: CouponRepository,
+    private readonly redemptions: CouponRedemptionRepository,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +45,56 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /**
+   * Applies at most one coupon to a pending order. Checks run in the order
+   * defined by TASK.md §6, so the first matching condition wins; nothing is
+   * written unless every check passes.
+   */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim().toUpperCase();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} reached its usage limit`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "MINIMUM_NOT_MET",
+        `order amount ${order.amountCents} is below the coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+
+    this.redemptions.apply({
+      orderId: id,
+      couponCode: code,
+      discountCents: discount,
+      finalAmountCents: order.amountCents - discount,
+      createdAt: now.toISOString(),
+    });
+    return this.get(id);
+  }
 }
diff --git a/tests/apply-coupon.test.ts b/tests/apply-coupon.test.ts
new file mode 100644
index 0000000..6f3af20
--- /dev/null
+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,378 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+
+const NOW = "2026-06-01T12:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+const baseCoupon = {
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+function newApp() {
+  return createApp({ clock: fixedClock });
+}
+
+function createCoupon(app: ReturnType<typeof newApp>, overrides: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", { ...baseCoupon, ...overrides });
+  expect(res.status).toBe(201);
+  return res.body as any;
+}
+
+function createOrder(app: ReturnType<typeof newApp>, amountCents: number, customer = "alice") {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as any).id as number;
+}
+
+const apply = (app: ReturnType<typeof newApp>, orderId: number, couponCode: unknown) =>
+  app.request("POST", `/orders/${orderId}/apply-coupon`, couponCode === undefined ? {} : { couponCode });
+
+const errorCode = (res: { body: unknown }) => (res.body as any).error.code;
+
+describe("apply-coupon repository", () => {
+  it("updates the order, records the redemption and increments usage in one call", () => {
+    const db = openDb();
+    db.prepare(
+      `INSERT INTO coupons (code, type, value, min_amount_cents, max_discount_cents,
+                            valid_from, valid_until, status, usage_limit)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    ).run("SAVE20", "PERCENT", 20, 0, null, "2026-01-01T00:00:00Z", "2027-01-01T00:00:00Z", "ACTIVE", null);
+    db.prepare("INSERT INTO orders (customer, amount_cents, final_amount_cents, created_at) VALUES (?, ?, ?, ?)").run(
+      "alice",
+      10000,
+      10000,
+      "2026-06-01T00:00:00Z",
+    );
+
+    new CouponRedemptionRepository(db).apply({
+      orderId: 1,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      createdAt: NOW,
+    });
+
+    expect(db.prepare("SELECT * FROM orders WHERE id = 1").get()).toMatchObject({
+      discount_cents: 2000,
+      final_amount_cents: 8000,
+      coupon_code: "SAVE20",
+    });
+    expect(db.prepare("SELECT * FROM coupon_redemptions WHERE order_id = 1").get()).toMatchObject({
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: NOW,
+    });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = ?").get("SAVE20")).toMatchObject({ used_count: 1 });
+  });
+
+  it("rolls back every change when a statement in the transaction fails", () => {
+    const db = openDb();
+    db.prepare(
+      `INSERT INTO coupons (code, type, value, min_amount_cents, max_discount_cents,
+                            valid_from, valid_until, status, usage_limit)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    ).run("SAVE20", "PERCENT", 20, 0, null, "2026-01-01T00:00:00Z", "2027-01-01T00:00:00Z", "ACTIVE", null);
+    db.prepare("INSERT INTO orders (customer, amount_cents, final_amount_cents, created_at) VALUES (?, ?, ?, ?)").run(
+      "alice",
+      10000,
+      10000,
+      "2026-06-01T00:00:00Z",
+    );
+    const repo = new CouponRedemptionRepository(db);
+
+    // "MISSING" does not exist in coupons, so the redemption insert violates the
+    // foreign key and the whole transaction must roll back.
+    expect(() =>
+      repo.apply({
+        orderId: 1,
+        couponCode: "MISSING",
+        discountCents: 2000,
+        finalAmountCents: 8000,
+        createdAt: NOW,
+      }),
+    ).toThrow();
+
+    expect(db.prepare("SELECT * FROM orders WHERE id = 1").get()).toMatchObject({
+      discount_cents: 0,
+      final_amount_cents: 10000,
+      coupon_code: null,
+    });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = ?").get("SAVE20")).toMatchObject({ used_count: 0 });
+    expect(db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toMatchObject({ n: 0 });
+  });
+});
+
+describe("apply-coupon request validation", () => {
+  it("rejects a missing couponCode", () => {
+    const app = newApp();
+    const id = createOrder(app, 10000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, {});
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+
+  it("rejects a non-string couponCode", () => {
+    const app = newApp();
+    const id = createOrder(app, 10000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: 42 });
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+
+  it("rejects a whitespace-only couponCode", () => {
+    const app = newApp();
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "   ");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+});
+
+describe("apply-coupon order checks", () => {
+  it("returns 404 ORDER_NOT_FOUND for an unknown order", () => {
+    const app = newApp();
+    createCoupon(app);
+    const res = apply(app, 999, "SAVE20");
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns 409 ORDER_NOT_PENDING for a paid order", () => {
+    const app = newApp();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    app.request("POST", `/orders/${id}/pay`);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns 409 ORDER_NOT_PENDING for a cancelled order", () => {
+    const app = newApp();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    app.request("POST", `/orders/${id}/cancel`);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+});
+
+describe("apply-coupon coupon checks", () => {
+  it("returns 404 COUPON_NOT_FOUND for an unknown code", () => {
+    const app = newApp();
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "NOPE99");
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns 400 COUPON_INACTIVE for a disabled coupon", () => {
+    const app = newApp();
+    createCoupon(app, { status: "DISABLED" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_INACTIVE");
+  });
+
+  it("returns 400 COUPON_NOT_YET_VALID before the window", () => {
+    const app = newApp();
+    createCoupon(app, { validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("returns 400 COUPON_EXPIRED at or after validUntil", () => {
+    const app = newApp();
+    createCoupon(app, { validFrom: "2025-01-01T00:00:00Z", validUntil: "2026-01-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_EXPIRED");
+  });
+
+  it("returns 400 COUPON_USAGE_EXHAUSTED when usedCount reaches usageLimit", () => {
+    const app = newApp();
+    createCoupon(app, { usageLimit: 1 });
+    app.db.prepare("UPDATE coupons SET used_count = 1 WHERE code = ?").run("SAVE20");
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("returns 400 MINIMUM_NOT_MET below the coupon minimum", () => {
+    const app = newApp();
+    createCoupon(app, { minAmountCents: 5000 });
+    const id = createOrder(app, 4999);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("MINIMUM_NOT_MET");
+  });
+
+  it("succeeds when the order amount equals the minimum", () => {
+    const app = newApp();
+    createCoupon(app, { minAmountCents: 10000 });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+});
+
+describe("apply-coupon error precedence", () => {
+  it("reports an invalid body before a missing order", () => {
+    const app = newApp();
+    const res = app.request("POST", "/orders/999/apply-coupon", {});
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+
+  it("reports a non-pending order before a missing coupon", () => {
+    const app = newApp();
+    const id = createOrder(app, 10000);
+    app.request("POST", `/orders/${id}/cancel`);
+    const res = apply(app, id, "NOPE99");
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("reports an already-applied order before coupon problems", () => {
+    const app = newApp();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    apply(app, id, "SAVE20");
+    createCoupon(app, { code: "OFF50", status: "DISABLED" });
+    const res = apply(app, id, "OFF50");
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("reports an inactive coupon before the validity window", () => {
+    const app = newApp();
+    createCoupon(app, { status: "DISABLED", validFrom: "2025-01-01T00:00:00Z", validUntil: "2026-01-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_INACTIVE");
+  });
+});
+
+describe("apply-coupon discount computation", () => {
+  it("applies a percentage coupon (AC-01)", () => {
+    const app = newApp();
+    createCoupon(app, { type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+    expect(apply(app, id, "SAVE20").body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("applies a fixed coupon (AC-02)", () => {
+    const app = newApp();
+    createCoupon(app, { code: "FIX15", type: "FIXED", value: 1500 });
+    const id = createOrder(app, 10000);
+    expect(apply(app, id, "FIX15").body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("caps the discount at maxDiscountCents (AC-03)", () => {
+    const app = newApp();
+    createCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const id = createOrder(app, 100000);
+    expect(apply(app, id, "SAVE20").body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("rounds a percentage discount down (AC-05)", () => {
+    const app = newApp();
+    createCoupon(app, { code: "PCT15", type: "PERCENT", value: 15 });
+    const id = createOrder(app, 999);
+    expect(apply(app, id, "PCT15").body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+});
+
+describe("apply-coupon persistence and repeat rules", () => {
+  it("returns the same body as GET /orders/:id and keeps the status pending", () => {
+    const app = newApp();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual(app.request("GET", `/orders/${id}`).body);
+    expect((res.body as any).status).toBe("PENDING");
+  });
+
+  it("normalizes case and surrounding whitespace (AC-10)", () => {
+    const app = newApp();
+    createCoupon(app);
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, " save20 ");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("rejects a second coupon and leaves the order unchanged (AC-08)", () => {
+    const app = newApp();
+    createCoupon(app);
+    createCoupon(app, { code: "OFF50", type: "FIXED", value: 500 });
