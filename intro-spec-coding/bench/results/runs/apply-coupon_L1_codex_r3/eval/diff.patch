diff --git a/src/repositories/couponRepository.ts b/src/repositories/couponRepository.ts
index 094341d..ca88a9f 100755
--- a/src/repositories/couponRepository.ts
+++ b/src/repositories/couponRepository.ts
@@ -57,4 +57,25 @@ export class CouponRepository {
     const row = this.db.prepare("SELECT * FROM coupons WHERE code = ?").get(code) as CouponRow | undefined;
     return row && toCoupon(row);
   }
+
+  /**
+   * Records one redemption of a coupon and bumps its counter as a single unit,
+   * so a coupon can never be consumed without a matching redemption row.
+   */
+  redeem(code: string, orderId: number, discountCents: number, createdAt: string): void {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare(
+          `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+           VALUES (?, ?, ?, ?)`,
+        )
+        .run(orderId, code, discountCents, createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(code);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
