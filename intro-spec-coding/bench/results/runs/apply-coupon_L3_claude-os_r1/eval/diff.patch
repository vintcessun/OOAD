+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,290 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+function makeApp(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function makeCoupon(app: App, overrides: Record<string, unknown> = {}): any {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+function makeOrder(app: App, amountCents: number): any {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+const apply = (app: App, id: number, body: unknown) => app.request("POST", `/orders/${id}/apply-coupon`, body);
+const redemptions = (app: App) =>
+  (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number }).n;
+
+describe("apply coupon — discount calculation", () => {
+  it("AC-01: PERCENT 20 on 10000 yields 2000 / 8000", () => {
+    const app = makeApp();
+    makeCoupon(app, { type: "PERCENT", value: 20 });
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20", status: "PENDING" });
+  });
+
+  it("AC-02: FIXED 1500 on 10000 yields 8500", () => {
+    const app = makeApp();
+    makeCoupon(app, { code: "FLAT15", type: "FIXED", value: 1500 });
+    const order = makeOrder(app, 10000);
+    expect(apply(app, order.id, { couponCode: "FLAT15" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 8500,
+    });
+  });
+
+  it("AC-03: PERCENT 20 capped at 5000 on 100000 yields 5000", () => {
+    const app = makeApp();
+    makeCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const order = makeOrder(app, 100000);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).body).toMatchObject({ discountCents: 5000 });
+  });
+
+  it("AC-04: FIXED 3000 on 1000 clamps to 1000 / 0", () => {
+    const app = makeApp();
+    makeCoupon(app, { code: "BIG", type: "FIXED", value: 3000 });
+    const order = makeOrder(app, 1000);
+    expect(apply(app, order.id, { couponCode: "BIG" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("AC-05: PERCENT 15 on 999 truncates to 149", () => {
+    const app = makeApp();
+    makeCoupon(app, { type: "PERCENT", value: 15 });
+    const order = makeOrder(app, 999);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-06: amount equal to minAmountCents succeeds", () => {
+    const app = makeApp();
+    makeCoupon(app, { minAmountCents: 5000 });
+    const order = makeOrder(app, 5000);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+});
+
+describe("apply coupon — validity window", () => {
+  const validFrom = "2026-06-01T00:00:00Z";
+  const validUntil = "2026-07-01T00:00:00Z";
+
+  function couponAt(clockIso: string) {
+    const app = createApp({ clock: () => new Date(clockIso) });
+    makeCoupon(app, { validFrom, validUntil });
+    const order = makeOrder(app, 10000);
+    return { app, order };
+  }
+
+  it("AC-07: now == validFrom succeeds", () => {
+    const { app, order } = couponAt(validFrom);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("AC-07: now == validUntil is COUPON_EXPIRED", () => {
+    const { app, order } = couponAt(validUntil);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("now < validFrom is COUPON_NOT_YET_VALID", () => {
+    const { app, order } = couponAt("2026-05-31T23:59:59Z");
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+});
+
+describe("apply coupon — order and coupon state", () => {
+  it("AC-08: second apply on the same order is rejected and changes nothing", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("AC-09: success increments usedCount and records one redemption", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    expect(redemptions(app)).toBe(0);
+    apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(redemptions(app)).toBe(1);
+    expect(app.db.prepare("SELECT * FROM coupon_redemptions").get()).toMatchObject({
+      order_id: order.id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+
+  it("AC-10: padded lowercase code matches the uppercase coupon", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("rejects a paid order with ORDER_NOT_PENDING", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    app.request("POST", `/orders/${order.id}/pay`);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects a disabled coupon with COUPON_INACTIVE", () => {
+    const app = makeApp();
+    makeCoupon(app, { status: "DISABLED" });
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects an exhausted usage limit", () => {
+    const app = makeApp();
+    makeCoupon(app, { usageLimit: 1 });
+    const first = makeOrder(app, 10000);
+    expect(apply(app, first.id, { couponCode: "SAVE20" }).status).toBe(200);
+    const second = makeOrder(app, 10000);
+    const res = apply(app, second.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("rejects an order below the minimum amount", () => {
+    const app = makeApp();
+    makeCoupon(app, { minAmountCents: 5000 });
+    const order = makeOrder(app, 4999);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+  });
+});
+
+describe("apply coupon — error precedence and contract", () => {
+  it("REQ-13: missing, non-string, and blank codes are INVALID_REQUEST", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    for (const body of [{}, { couponCode: 123 }, { couponCode: "   " }, { couponCode: null }]) {
+      const res = apply(app, order.id, body);
+      expect(res.status).toBe(400);
+      expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+    }
+  });
+
+  it("precedence: invalid body beats a missing order", () => {
+    const app = makeApp();
+    const res = apply(app, 99, {});
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("precedence: missing order beats an unknown coupon", () => {
+    const app = makeApp();
+    const res = apply(app, 99, { couponCode: "NOPE1" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("precedence: already applied beats an unknown coupon", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    apply(app, order.id, { couponCode: "SAVE20" });
+    const res = apply(app, order.id, { couponCode: "NOPE1" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("precedence: inactive coupon beats an expired window", () => {
+    const app = makeApp();
+    makeCoupon(app, { status: "DISABLED", validUntil: "2026-01-01T00:00:00Z" });
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("precedence: exhausted usage beats an unmet minimum", () => {
+    const app = makeApp();
+    makeCoupon(app, { usageLimit: 1, minAmountCents: 1000 });
+    const first = makeOrder(app, 5000);
+    apply(app, first.id, { couponCode: "SAVE20" });
+    const second = makeOrder(app, 500);
+    const res = apply(app, second.id, { couponCode: "SAVE20" });
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("rejects an unknown coupon with COUPON_NOT_FOUND", () => {
+    const app = makeApp();
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: "NOPE1" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a malformed order id with INVALID_REQUEST", () => {
+    const app = makeApp();
+    const res = app.request("POST", "/orders/abc/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("rejections leave no side effects", () => {
+    const app = makeApp();
+    makeCoupon(app, { minAmountCents: 5000 });
+    const order = makeOrder(app, 4999);
+    apply(app, order.id, { couponCode: "SAVE20" });
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 4999,
+      couponCode: null,
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(redemptions(app)).toBe(0);
+  });
+
+  it("REQ-14: response body equals the order resource", () => {
+    const app = makeApp();
+    makeCoupon(app);
+    const order = makeOrder(app, 10000);
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual(app.request("GET", `/orders/${order.id}`).body);
+  });
+});
