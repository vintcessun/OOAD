+import { describe, expect, it } from "vitest";
+import type { Coupon } from "../src/repositories/couponRepository.ts";
+import { computeDiscount } from "../src/services/discount.ts";
+
+const coupon = (overrides: Partial<Coupon>): Coupon => ({
+  code: "TEST",
+  type: "FIXED",
+  value: 0,
+  minAmountCents: 0,
+  maxDiscountCents: null,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  status: "ACTIVE",
+  usageLimit: null,
+  usedCount: 0,
+  ...overrides,
+});
+
+describe("computeDiscount", () => {
+  it("returns the value for a FIXED coupon", () => {
+    expect(computeDiscount(coupon({ type: "FIXED", value: 1500 }), 10000)).toBe(1500);
+  });
+
+  it("truncates a PERCENT coupon", () => {
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 20 }), 10000)).toBe(2000);
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 15 }), 999)).toBe(149);
+  });
+
+  it("caps at maxDiscountCents when set", () => {
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 20, maxDiscountCents: 5000 }), 100000)).toBe(5000);
+    expect(computeDiscount(coupon({ type: "FIXED", value: 9000, maxDiscountCents: 5000 }), 100000)).toBe(5000);
+  });
+
+  it("does not cap when maxDiscountCents is null", () => {
+    expect(computeDiscount(coupon({ type: "PERCENT", value: 20, maxDiscountCents: null }), 100000)).toBe(20000);
+  });
+
+  it("never exceeds the order amount", () => {
+    expect(computeDiscount(coupon({ type: "FIXED", value: 3000 }), 1000)).toBe(1000);
+  });
+});
