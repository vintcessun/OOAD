--- /dev/null
+++ b/src/services/discount.ts
@@ -0,0 +1,12 @@
+import type { Coupon } from "../repositories/couponRepository.ts";
+
+/**
+ * Discount in integer cents for applying `coupon` to an order of `amountCents`.
+ * FIXED uses the value directly, PERCENT truncates, the optional cap is applied
+ * before clamping so the result never exceeds the order amount.
+ */
+export function computeDiscount(coupon: Coupon, amountCents: number): number {
+  const base = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? base : Math.min(base, coupon.maxDiscountCents);
+  return Math.min(capped, amountCents);
+}
diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..604fa5b 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,13 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import { computeDiscount } from "./discount.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +44,47 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies at most one coupon to a pending order; checks follow the documented precedence. */
+  applyCoupon(id: number, rawCode: unknown): Order {
+    if (typeof rawCode !== "string") throw badRequest("INVALID_REQUEST", "couponCode is required");
+    const code = rawCode.trim().toUpperCase();
+    if (code === "") throw badRequest("INVALID_REQUEST", "couponCode is required");
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order ${id} does not meet minimum ${coupon.minAmountCents}`);
+    }
+
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    this.orders.transaction(() => {
+      this.orders.applyCoupon(id, code, discountCents, finalAmountCents);
+      this.coupons.insertRedemption(id, code, discountCents, now.toISOString());
+      this.coupons.incrementUsedCount(code);
+    });
+
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
