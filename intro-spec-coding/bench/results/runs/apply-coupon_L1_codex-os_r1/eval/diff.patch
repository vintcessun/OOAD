   }
+
+  /**
+   * Applies a coupon to a pending order: validates eligibility, computes the discount,
+   * then writes the order, the coupon usage counter and the redemption row atomically.
+   */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    this.assertUsable(coupon, order.amountCents);
+
+    const discountCents = this.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const createdAt = this.clock().toISOString();
+
+    const db = this.orders.db;
+    db.exec("BEGIN IMMEDIATE");
+    try {
+      this.orders.applyDiscount(id, discountCents, finalAmountCents, coupon.code);
+      this.coupons.incrementUsage(coupon.code);
+      this.coupons.recordRedemption({ orderId: id, couponCode: coupon.code, discountCents, createdAt });
+      db.exec("COMMIT");
+    } catch (e) {
+      db.exec("ROLLBACK");
+      throw e;
+    }
+    return this.get(id);
+  }
+
+  private assertUsable(coupon: Coupon, amountCents: number): void {
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${coupon.code} is disabled`);
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT", `order amount is below coupon minimum ${coupon.minAmountCents}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_EXCEEDED", `coupon ${coupon.code} reached its usage limit`);
+    }
+  }
+
+  /** Computes the discount in whole cents, capped by maxDiscountCents and by the order amount. */
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "PERCENT" ? Math.round((amountCents * coupon.value) / 100) : coupon.value;
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.min(capped, amountCents);
+  }
 }
