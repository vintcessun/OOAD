diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..7a778fe 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,47 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim().toUpperCase();
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has a coupon`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below coupon minimum`);
+    }
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+
+    this.orders.applyCoupon(
+      order.id,
+      code,
+      discount,
+      order.amountCents - discount,
+      now.toISOString(),
+    );
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..2d06dc1
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,150 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-06-01T00:00:00Z");
+
+const createBaseCoupon = (overrides: Record<string, unknown> = {}) => ({
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  ...overrides,
+});
+
+function setup(orderAmountCents: number, coupon: Record<string, unknown> = {}) {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: orderAmountCents });
+  app.request("POST", "/coupons", createBaseCoupon(coupon));
+  return app;
+}
+
+describe("apply coupon", () => {
+  it("AC-01: PERCENT discount", () => {
+    const app = setup(10000);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-02: FIXED discount", () => {
+    const app = setup(10000, { type: "FIXED", value: 1500 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: caps PERCENT discount at maxDiscountCents", () => {
+    const app = setup(100000, { value: 20, maxDiscountCents: 5000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-05: floors PERCENT discount", () => {
+    const app = setup(999, { value: 15 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("AC-06: allows amount equal to minAmountCents", () => {
+    const app = setup(1000, { value: 10, minAmountCents: 1000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+  });
+
+  it("AC-08: rejects second coupon on the same order", () => {
+    const app = setup(10000);
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).status).toBe(200);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-09: increments usedCount and records a redemption", () => {
+    const app = setup(10000);
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db.prepare("SELECT * FROM coupon_redemptions").all() as unknown[];
+    expect(rows).toHaveLength(1);
+  });
+
+  it("AC-10: normalizes code with whitespace and casing", () => {
+    const app = setup(10000);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("returns the same body as GET /orders/:id", () => {
+    const app = setup(10000);
+    const applied = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(applied.body).toEqual(app.request("GET", "/orders/1").body);
+  });
+
+  it("rejects an invalid body", () => {
+    const app = setup(10000);
+    for (const body of [{}, { couponCode: 5 }, { couponCode: "   " }]) {
+      const res = app.request("POST", "/orders/1/apply-coupon", body);
+      expect(res.status).toBe(400);
+      expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+    }
+  });
+
+  it("rejects an unknown order", () => {
+    const app = setup(10000);
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects a non-pending order", () => {
+    const app = setup(10000);
+    app.request("POST", "/orders/1/pay");
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = setup(10000);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const app = setup(10000, { status: "DISABLED" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const app = setup(10000, { validFrom: "2026-07-01T00:00:00Z" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = setup(10000, { validUntil: "2026-05-01T00:00:00Z" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects an exhausted coupon", () => {
+    const app = setup(10000, { usageLimit: 1 });
+    app.db.prepare("UPDATE coupons SET used_count = 1 WHERE code = 'SAVE20'").run();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("rejects when the order is below the minimum", () => {
+    const app = setup(500, { minAmountCents: 1000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+  });
+});
