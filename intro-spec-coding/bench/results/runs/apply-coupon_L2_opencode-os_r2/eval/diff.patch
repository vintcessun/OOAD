+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,113 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function setup(): App {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  return app;
+}
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}) {
+  return app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+}
+
+describe("apply coupon", () => {
+  it("applies a valid PERCENT coupon", () => {
+    const app = setup();
+    createCoupon(app);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ amountCents: 12000, discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+  });
+
+  it("applies a FIXED coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "MINUS2000", type: "FIXED", value: 2000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "MINUS2000" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 10000 });
+  });
+
+  it("caps a PERCENT discount at maxDiscountCents", () => {
+    const app = setup();
+    createCoupon(app, { code: "CAP500", type: "PERCENT", value: 50, maxDiscountCents: 500 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "CAP500" });
+    expect(res.body).toMatchObject({ discountCents: 500, finalAmountCents: 11500 });
+  });
+
+  it("returns 400 for an unknown coupon", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 for an expired coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "OLD", validUntil: "2026-06-01T00:00:00Z" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 for a disabled coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "OFF", status: "DISABLED" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when the order is below the minimum amount", () => {
+    const app = setup();
+    createCoupon(app, { code: "BIG", minAmountCents: 50000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIG" });
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when the usage limit is reached", () => {
+    const app = setup();
+    createCoupon(app, { code: "ONCE", usageLimit: 1 });
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "ONCE" });
+    app.request("POST", "/orders", { customer: "bob", amountCents: 12000 });
+    const res = app.request("POST", "/orders/2/apply-coupon", { couponCode: "ONCE" });
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = setup();
+    createCoupon(app);
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+  });
+
+  it("rolls back the order update when the redemption fails", () => {
+    const app = setup();
+    const orders = new OrderRepository(app.db);
+    const coupons = new CouponRepository(app.db);
+    expect(() =>
+      orders.transaction(() => {
+        orders.applyCoupon(1, 2000, 10000, "SAVE20");
+        coupons.recordRedemption(1, "MISSING", 2000, fixedClock().toISOString());
+      }),
+    ).toThrow();
+    expect(orders.findById(1)).toMatchObject({ discountCents: 0, finalAmountCents: 12000, couponCode: null });
+  });
+
+  it("increments usedCount and records the redemption", () => {
+    const app = setup();
+    createCoupon(app);
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db.prepare("SELECT * FROM coupon_redemptions").all();
+    expect(rows).toHaveLength(1);
+  });
+});
