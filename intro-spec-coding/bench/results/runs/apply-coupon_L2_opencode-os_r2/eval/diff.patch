index 8fc45d5..d7efb3f 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,22 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  applyCoupon(id: number, discountCents: number, finalAmountCents: number, couponCode: string): void {
+    this.db
+      .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+      .run(discountCents, finalAmountCents, couponCode, id);
+  }
+
+  transaction<T>(fn: () => T): T {
+    this.db.exec("BEGIN");
+    try {
+      const result = fn();
+      this.db.exec("COMMIT");
+      return result;
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
