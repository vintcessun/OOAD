index 63b29b4..808ac72 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,39 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const order = this.get(id);
+    const coupon = this.coupons.findByCode(couponCode.trim());
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_NOT_ACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    const now = this.clock();
+    if (now < new Date(coupon.validFrom) || now > new Date(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${coupon.code} is not valid at this time`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT", `order amount is below coupon minimum`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT", `coupon ${coupon.code} usage limit reached`);
+    }
+    const discountCents = this.calculateDiscount(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const createdAt = now.toISOString();
+    this.orders.transaction(() => {
+      this.orders.applyCoupon(id, discountCents, finalAmountCents, coupon.code);
+      this.coupons.recordRedemption(id, coupon.code, discountCents, createdAt);
+      this.coupons.incrementUsedCount(coupon.code);
+    });
+    return this.get(id);
+  }
+
+  private calculateDiscount(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(capped, amountCents));
+  }
 }
diff --git a/tests/apply-coupon.test.ts b/tests/apply-coupon.test.ts
