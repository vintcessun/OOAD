diff --git a/src/repositories/redemptionRepository.ts b/src/repositories/redemptionRepository.ts
new file mode 100644
index 0000000..5ce74d3
--- /dev/null
+++ b/src/repositories/redemptionRepository.ts
@@ -0,0 +1,36 @@
+import type { Db } from "../db.ts";
+
+export interface RedemptionInput {
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  finalAmountCents: number;
+  createdAt: string;
+}
+
+/**
+ * Writes the coupon-application effects. REQ-12 requires the order update, the
+ * redemption row and the coupon usage bump to happen in a single transaction.
+ */
+export class RedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  apply(input: RedemptionInput): void {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+        .run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(input.orderId, input.couponCode, input.discountCents, input.createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+      this.db.exec("COMMIT");
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+}
