@@ -1,10 +1,14 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import type { RedemptionRepository } from "../repositories/redemptionRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
+    private readonly redemptions: RedemptionRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +45,57 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** REQ-01..REQ-14: apply a coupon to a pending order which has none yet. */
+  applyCoupon(id: number, rawCouponCode: unknown): Order {
+    const couponCode = normalizeCouponCode(rawCouponCode);
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+
+    const coupon = this.coupons.findByCode(couponCode);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${couponCode} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${couponCode} is not valid yet`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${couponCode} expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${couponCode} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount ${order.amountCents} is below ${coupon.minAmountCents}`);
+    }
+
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    this.redemptions.apply({
+      orderId: id,
+      couponCode,
+      discountCents,
+      finalAmountCents: order.amountCents - discountCents,
+      createdAt: now.toISOString(),
+    });
+    return this.get(id);
+  }
+}
+
+/** REQ-01: trim, upper-case, then reject a missing / non-string / blank code. */
+function normalizeCouponCode(raw: unknown): string {
+  if (typeof raw !== "string") throw badRequest("INVALID_REQUEST", "couponCode is required");
+  const code = raw.trim().toUpperCase();
+  if (code === "") throw badRequest("INVALID_REQUEST", "couponCode must not be empty");
+  return code;
+}
+
+/** REQ-06..REQ-09: FIXED / PERCENT, optional cap, never below zero. */
+function computeDiscount(coupon: Coupon, amountCents: number): number {
+  let discount = coupon.type === "PERCENT" ? Math.floor((amountCents * coupon.value) / 100) : coupon.value;
+  if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+  return Math.min(discount, amountCents);
 }
diff --git a/tests/apply-coupon.test.ts b/tests/apply-coupon.test.ts
new file mode 100644
index 0000000..ccfcfdf
--- /dev/null
+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,237 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const now = () => new Date("2026-10-01T08:00:00Z");
+
+interface CouponInput {
+  code: string;
+  type: "FIXED" | "PERCENT";
+  value: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function setup(coupon?: CouponInput): { app: App; orderId: number } {
+  const app = createApp({ clock: now });
+  if (coupon) {
+    const res = app.request("POST", "/coupons", {
+      validFrom: "2026-01-01T00:00:00Z",
+      validUntil: "2027-01-01T00:00:00Z",
+      ...coupon,
+    });
+    expect(res.status).toBe(201);
+  }
+  return { app, orderId: 1 };
+}
+
+function createOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as any).id;
+}
+
+function apply(app: App, orderId: number, body: unknown) {
+  return app.request("POST", `/orders/${orderId}/apply-coupon`, body);
+}
+
+describe("apply coupon — discounts (AC-01..AC-06)", () => {
+  it("AC-01 applies a percent coupon", () => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("AC-02 applies a fixed coupon", () => {
+    const { app } = setup({ code: "FIX1500", type: "FIXED", value: 1500 });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "FIX1500" });
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 caps a percent discount", () => {
+    const { app } = setup({ code: "CAP5", type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const id = createOrder(app, 100000);
+    expect(apply(app, id, { couponCode: "CAP5" }).body).toMatchObject({
+      discountCents: 5000,
+      finalAmountCents: 95000,
+    });
+  });
+
+  it("AC-04 never discounts below zero", () => {
+    const { app } = setup({ code: "BIG", type: "FIXED", value: 3000 });
+    const id = createOrder(app, 1000);
+    expect(apply(app, id, { couponCode: "BIG" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("AC-05 floors percent discounts", () => {
+    const { app } = setup({ code: "P15", type: "PERCENT", value: 15 });
+    const id = createOrder(app, 999);
+    expect(apply(app, id, { couponCode: "P15" }).body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-06 allows an amount equal to the minimum", () => {
+    const { app } = setup({ code: "MIN1000", type: "FIXED", value: 100, minAmountCents: 1000 });
+    const id = createOrder(app, 1000);
+    expect(apply(app, id, { couponCode: "MIN1000" }).status).toBe(200);
+  });
+});
+
+describe("apply coupon — validity window (AC-07)", () => {
+  it("treats now == validUntil as expired and now == validFrom as valid", () => {
+    const { app } = setup({ code: "EDGE", type: "FIXED", value: 100, validUntil: "2026-10-01T08:00:00Z" });
+    const id = createOrder(app, 5000);
+    expect(apply(app, id, { couponCode: "EDGE" }).body).toEqual({
+      error: { code: "COUPON_EXPIRED", message: expect.any(String) },
+    });
+
+    const { app: app2 } = setup({ code: "EDGE", type: "FIXED", value: 100, validFrom: "2026-10-01T08:00:00Z" });
+    const id2 = createOrder(app2, 5000);
+    expect(apply(app2, id2, { couponCode: "EDGE" }).status).toBe(200);
+  });
+});
+
+describe("apply coupon — one coupon per order (AC-08)", () => {
+  it("rejects a second coupon and leaves the order untouched", () => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+    expect(apply(app, id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const second = apply(app, id, { couponCode: "SAVE20" });
+    expect(second.status).toBe(409);
+    expect((second.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toMatchObject({ n: 1 });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+});
+
+describe("apply coupon — side effects (AC-09, AC-10, REQ-14)", () => {
+  it("bumps usedCount, records a redemption and mirrors GET /orders/:id", () => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+
+    const res = apply(app, id, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual(app.request("GET", `/orders/${id}`).body);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+
+    const redemption = app.db
+      .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ?")
+      .get(id) as any;
+    expect(redemption).toMatchObject({
+      order_id: id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+});
+
+describe("apply coupon — rejections", () => {
+  const cases: Array<{ name: string; body: unknown; status: number; code: string }> = [
+    { name: "missing couponCode", body: {}, status: 400, code: "INVALID_REQUEST" },
+    { name: "non-string couponCode", body: { couponCode: 42 }, status: 400, code: "INVALID_REQUEST" },
+    { name: "blank couponCode", body: { couponCode: "   " }, status: 400, code: "INVALID_REQUEST" },
+    { name: "unknown order (body checked first)", body: {}, status: 400, code: "INVALID_REQUEST" },
+  ];
+
+  it.each(cases)("$name", ({ body, status, code }) => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = apply(app, 999, body);
+    expect(res.status).toBe(status);
+    expect((res.body as any).error.code).toBe(code);
+  });
+
+  it("rejects an unknown order", () => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = apply(app, 999, { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects a non-pending order", () => {
+    const { app } = setup({ code: "SAVE20", type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+    app.request("POST", `/orders/${id}/pay`);
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const { app } = setup();
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "nope" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const { app } = setup({ code: "OFF", type: "FIXED", value: 100, status: "DISABLED" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects a coupon that is not valid yet", () => {
+    const { app } = setup({ code: "SOON", type: "FIXED", value: 100, validFrom: "2026-10-02T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "SOON" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an expired coupon", () => {
+    const { app } = setup({ code: "OLD", type: "FIXED", value: 100, validUntil: "2026-09-01T00:00:00Z" });
+    const id = createOrder(app, 10000);
+    const res = apply(app, id, { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a coupon whose usage limit is reached", () => {
+    const { app } = setup({ code: "ONCE", type: "FIXED", value: 100, usageLimit: 1 });
+    const first = createOrder(app, 10000);
+    expect(apply(app, first, { couponCode: "ONCE" }).status).toBe(200);
+
+    const second = createOrder(app, 10000);
+    const res = apply(app, second, { couponCode: "ONCE" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("rejects an order below the minimum amount without touching the database", () => {
+    const { app } = setup({ code: "MIN2000", type: "FIXED", value: 100, minAmountCents: 2000 });
+    const id = createOrder(app, 1999);
+    const res = apply(app, id, { couponCode: "MIN2000" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 1999,
+      couponCode: null,
+    });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toMatchObject({ n: 0 });
+    expect(app.request("GET", "/coupons/MIN2000").body).toMatchObject({ usedCount: 0 });
+  });
+});
