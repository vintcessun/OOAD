@@ -41,4 +45,48 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+
+    const now = this.clock().getTime();
+    const validFrom = Date.parse(coupon.validFrom);
+    const validUntil = Date.parse(coupon.validUntil);
+    if (now < validFrom) throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    if (now > validUntil) throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT", `coupon ${code} usage limit reached`);
+    }
+
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT", `order amount is below the coupon minimum`);
+    }
+
+    let discount =
+      coupon.type === "FIXED"
+        ? coupon.value
+        : Math.round((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.max(0, Math.min(discount, order.amountCents));
+
+    const finalAmountCents = order.amountCents - discount;
+    this.orders.applyCoupon(id, coupon.code, discount, finalAmountCents);
+    this.coupons.incrementUsedCount(coupon.code);
+    this.redemptions.insert(id, coupon.code, discount, this.clock().toISOString());
+    return this.get(id);
+  }
 }
