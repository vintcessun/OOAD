diff --git a/src/repositories/redemptionRepository.ts b/src/repositories/redemptionRepository.ts
new file mode 100755
index 0000000..72d9382
--- /dev/null
+++ b/src/repositories/redemptionRepository.ts
@@ -0,0 +1,44 @@
+import type { Db } from "../db.ts";
+
+export interface ApplyCouponInput {
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  finalAmountCents: number;
+  createdAt: string;
+}
+
+/**
+ * Persists the effects of redeeming a coupon: the order is updated, a redemption
+ * row is inserted and the coupon usage counter is bumped. All three writes are
+ * part of a single transaction (REQ-12).
+ */
+export class RedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  applyCoupon(input: ApplyCouponInput): void {
+    const db = this.db;
+    db.exec("BEGIN IMMEDIATE");
+    try {
+      db.prepare(
+        `UPDATE orders
+            SET discount_cents = ?, final_amount_cents = ?, coupon_code = ?
+          WHERE id = ?`,
+      ).run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+
+      db.prepare(
+        `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+         VALUES (?, ?, ?, ?)`,
+      ).run(input.orderId, input.couponCode, input.discountCents, input.createdAt);
+
+      db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+
+      db.exec("COMMIT");
+    } catch (error) {
+      db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+}
+
+
