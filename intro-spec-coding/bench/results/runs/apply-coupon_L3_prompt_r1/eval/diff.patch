diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100755
index 0000000..73711aa
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,316 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const AT = "2026-10-01T08:00:00Z";
+const fixedClock = (iso: string) => () => new Date(iso);
+
+function makeApp(now: string = AT): App {
+  return createApp({ clock: fixedClock(now) });
+}
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}): Record<string, any> {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+  return res.body as Record<string, any>;
+}
+
+function createOrder(app: App, amountCents: number, customer = "alice"): Record<string, any> {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return res.body as Record<string, any>;
+}
+
+const apply = (app: App, id: number, body: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+const codeOf = (res: { body: unknown }) => (res.body as any).error.code;
+
+describe("POST /orders/:id/apply-coupon - discounts", () => {
+  it("AC-01: percentage coupon lowers the payable amount", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      id: order.id,
+      customer: "alice",
+      amountCents: 10000,
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+      createdAt: "2026-10-01T08:00:00.000Z",
+    });
+  });
+
+  it("AC-02: fixed coupon discount", () => {
+    const app = makeApp();
+    createCoupon(app, { type: "FIXED", value: 1500 });
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: maxDiscountCents caps a percentage coupon", () => {
+    const app = makeApp();
+    createCoupon(app, { maxDiscountCents: 5000 });
+    const order = createOrder(app, 100000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-04: discount never exceeds the order amount", () => {
+    const app = makeApp();
+    createCoupon(app, { type: "FIXED", value: 3000 });
+    const order = createOrder(app, 1000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05: percentage discounts are floored", () => {
+    const app = makeApp();
+    createCoupon(app, { value: 15 });
+    const order = createOrder(app, 999);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("AC-06: an amount equal to minAmountCents is accepted", () => {
+    const app = makeApp();
+    createCoupon(app, { minAmountCents: 10000 });
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-07: validFrom boundary is inclusive, validUntil boundary is exclusive", () => {
+    const atFrom = makeApp("2026-01-01T00:00:00Z");
+    createCoupon(atFrom, {});
+    const okOrder = createOrder(atFrom, 10000);
+    expect(apply(atFrom, okOrder.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const atUntil = makeApp("2027-01-01T00:00:00Z");
+    createCoupon(atUntil, {});
+    const expiredOrder = createOrder(atUntil, 10000);
+    const res = apply(atUntil, expiredOrder.id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect(codeOf(res)).toBe("COUPON_EXPIRED");
+  });
+
+  it("AC-10: the code is trimmed and upper-cased before lookup", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: " save20 " });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2000 });
+  });
+
+  it("REQ-14: the response equals a following GET /orders/:id", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+
+    const applied = apply(app, order.id, { couponCode: "SAVE20" });
+    const fetched = app.request("GET", `/orders/${order.id}`);
+
+    expect(applied.status).toBe(200);
+    expect(applied.body).toEqual(fetched.body);
+  });
+});
+
+describe("POST /orders/:id/apply-coupon - rejections", () => {
+  it("rejects a missing order before looking at the coupon", () => {
+    const app = makeApp();
+    const res = apply(app, 99, { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect(codeOf(res)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("REQ-13: rejects a missing, non-string or blank code first", () => {
+    const app = makeApp();
+    for (const body of [{}, { couponCode: 42 }, { couponCode: "   " }, { couponCode: null }]) {
+      const res = apply(app, 999, body);
+      expect(res.status).toBe(400);
+      expect(codeOf(res)).toBe("INVALID_REQUEST");
+    }
+  });
+
+  it("rejects an order that is not PENDING", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${order.id}/pay`).status).toBe(200);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect(codeOf(res)).toBe("ORDER_NOT_PENDING");
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      status: "PAID",
+      discountCents: 0,
+      couponCode: null,
+    });
+  });
+
+  it("rejects a cancelled order", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+    app.request("POST", `/orders/${order.id}/cancel`);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect(codeOf(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = makeApp();
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(404);
+    expect(codeOf(res)).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const app = makeApp();
+    createCoupon(app, { status: "DISABLED" });
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(codeOf(res)).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects a coupon that is not valid yet", () => {
+    const app = makeApp();
+    createCoupon(app, { validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(codeOf(res)).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects a coupon whose usage limit is reached", () => {
+    const app = makeApp();
+    createCoupon(app, { usageLimit: 1 });
+    const first = createOrder(app, 10000);
+    expect(apply(app, first.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const second = createOrder(app, 10000, "bob");
+    const res = apply(app, second.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(codeOf(res)).toBe("COUPON_USAGE_EXHAUSTED");
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("rejects an order below the coupon minimum and leaves the database untouched", () => {
+    const app = makeApp();
+    createCoupon(app, { minAmountCents: 20000 });
+    const order = createOrder(app, 10000);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(codeOf(res)).toBe("MINIMUM_NOT_MET");
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+      status: "PENDING",
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toMatchObject({ n: 0 });
+  });
+});
+
+describe("POST /orders/:id/apply-coupon - single use per order", () => {
+  it("AC-08: a second attempt on the same order is rejected and changes nothing", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, order.id, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect(codeOf(res)).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toMatchObject({ n: 1 });
+  });
+
+  it("rejects a different coupon on an order that already has one", () => {
+    const app = makeApp();
+    createCoupon(app, { code: "SAVE20" });
+    createCoupon(app, { code: "EXTRA5", type: "FIXED", value: 500 });
+    const order = createOrder(app, 10000);
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, order.id, { couponCode: "EXTRA5" });
+
+    expect(res.status).toBe(409);
+    expect(codeOf(res)).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${order.id}`).body).toMatchObject({
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 8000,
+    });
+  });
+
+  it("AC-09: a successful application records a redemption and bumps usedCount", () => {
+    const app = makeApp();
+    createCoupon(app);
+    const order = createOrder(app, 10000);
+
+    expect(apply(app, order.id, { couponCode: "SAVE20" }).status).toBe(200);
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .all() as Array<Record<string, unknown>>;
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      order_id: order.id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+});
