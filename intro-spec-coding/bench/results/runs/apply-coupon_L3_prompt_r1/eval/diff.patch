@@ -41,4 +45,80 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /**
+   * Applies a single coupon to a still pending order. Rules are checked in the
+   * order defined by TASK.md section 6; nothing is written until every check has
+   * passed, and the writes themselves are atomic.
+   */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    // 1. REQ-13: the body must carry a usable code.
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    // REQ-01: trim first, then upper-case before looking the coupon up.
+    const code = couponCode.trim().toUpperCase();
+
+    // 2. REQ-04: the order exists and is PENDING.
+    const order = this.get(id);
+    if (order.status !== "PENDING") {
+      throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    }
+
+    // 3. REQ-10: one coupon per order, the same one or another one.
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    // 4. REQ-01 / REQ-02: the coupon exists and is ACTIVE.
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+    }
+
+    // 5. REQ-03: validFrom <= now < validUntil, using the injected clock.
+    const now = this.clock();
+    const at = now.getTime();
+    if (at < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (at >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+
+    // 6. REQ-11: usage limit (NULL means unlimited).
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} reached its usage limit`);
+    }
+
+    // 7. REQ-05: minimum amount is inclusive.
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "MINIMUM_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+
+    // 8. REQ-06..REQ-09: compute the discount in integer cents.
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.min(discount, order.amountCents);
+    const finalAmountCents = order.amountCents - discount;
+
+    // 9. REQ-12: order + redemption + usage counter in one transaction.
+    this.redemptions.applyCoupon({
+      orderId: id,
+      couponCode: code,
+      discountCents: discount,
+      finalAmountCents,
+      createdAt: now.toISOString(),
+    });
+
+    // REQ-14: return exactly what GET /orders/:id would return.
+    return this.get(id);
+  }
 }
+
