@@ -57,4 +66,36 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  /**
+   * REQ-12: updates the order, records the redemption and bumps the coupon usage
+   * counter inside a single transaction. Any failure rolls everything back.
+   */
+  applyCoupon(input: ApplyCouponInput): Order {
+    this.db.exec("BEGIN");
+    try {
+      const updated = this.db
+        .prepare(
+          `UPDATE orders
+              SET discount_cents = ?, final_amount_cents = ?, coupon_code = ?
+            WHERE id = ? AND coupon_code IS NULL`,
+        )
+        .run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+      if (Number(updated.changes) === 0) {
+        throw conflict("COUPON_ALREADY_APPLIED", `order ${input.orderId} already has a coupon`);
+      }
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(input.orderId, input.couponCode, input.discountCents, input.createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+    return this.findById(input.orderId)!;
+  }
 }
