diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100755
index 0000000..8fa99a2
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,345 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const clockAt = (iso: string) => () => new Date(iso);
+
+const BASE_COUPON = {
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+const makeApp = (iso = "2026-10-01T08:00:00Z"): App => createApp({ clock: clockAt(iso) });
+
+const addCoupon = (app: App, overrides: Record<string, unknown> = {}): any => {
+  const res = app.request("POST", "/coupons", { ...BASE_COUPON, ...overrides });
+  expect(res.status).toBe(201);
+  return res.body;
+};
+
+const addOrder = (app: App, amountCents: number, customer = "alice"): any => {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return res.body;
+};
+
+const apply = (app: App, id: number, body: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+const errorCode = (res: { body: unknown }): unknown => (res.body as any).error.code;
+
+const redemptionCount = (app: App): number =>
+  Number((app.db.prepare("SELECT COUNT(*) AS c FROM coupon_redemptions").get() as any).c);
+
+const couponUsedCount = (app: App, code: string): number =>
+  Number((app.db.prepare("SELECT used_count AS c FROM coupons WHERE code = ?").get(code) as any).c);
+
+describe("POST /orders/:id/apply-coupon - discount calculation", () => {
+  it("AC-01 applies a PERCENT coupon", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      customer: "alice",
+      amountCents: 10000,
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+      createdAt: "2026-10-01T08:00:00.000Z",
+    });
+  });
+
+  it("AC-02 applies a FIXED coupon", () => {
+    const app = makeApp();
+    addCoupon(app, { type: "FIXED", value: 1500 });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03 caps a PERCENT discount at maxDiscountCents", () => {
+    const app = makeApp();
+    addCoupon(app, { value: 20, maxDiscountCents: 5000 });
+    addOrder(app, 100000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-03 caps a FIXED discount at maxDiscountCents", () => {
+    const app = makeApp();
+    addCoupon(app, { type: "FIXED", value: 1500, maxDiscountCents: 1000 });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 9000 });
+  });
+
+  it("AC-04 never discounts more than the order amount", () => {
+    const app = makeApp();
+    addCoupon(app, { type: "FIXED", value: 3000 });
+    addOrder(app, 1000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05 floors PERCENT discounts", () => {
+    const app = makeApp();
+    addCoupon(app, { value: 15 });
+    addOrder(app, 999);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("AC-06 allows an order exactly at the minimum amount", () => {
+    const app = makeApp();
+    addCoupon(app, { type: "FIXED", value: 500, minAmountCents: 1000 });
+    addOrder(app, 1000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 500, finalAmountCents: 500 });
+  });
+
+  it("REQ-14 returns exactly what GET /orders/:id returns", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+
+    const applied = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(applied.status).toBe(200);
+    expect(applied.body).toEqual(app.request("GET", "/orders/1").body);
+  });
+
+  it("does not change the order status", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+
+    expect(apply(app, 1, { couponCode: "SAVE20" }).body).toMatchObject({ status: "PENDING" });
+    expect(app.request("POST", "/orders/1/pay").status).toBe(200);
+  });
+
+  it("AC-10 normalizes the coupon code before lookup", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: " save20 " });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+});
+
+describe("POST /orders/:id/apply-coupon - validity window", () => {
+  const FROM = "2026-01-01T00:00:00Z";
+  const UNTIL = "2026-02-01T00:00:00Z";
+
+  it("AC-07 succeeds when now equals validFrom", () => {
+    const app = makeApp(FROM);
+    addCoupon(app, { validFrom: FROM, validUntil: UNTIL });
+    addOrder(app, 10000);
+
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("AC-07 rejects when now equals validUntil", () => {
+    const app = makeApp(UNTIL);
+    addCoupon(app, { validFrom: FROM, validUntil: UNTIL });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a coupon that is not valid yet", () => {
+    const app = makeApp("2025-12-31T23:59:59Z");
+    addCoupon(app, { validFrom: FROM, validUntil: UNTIL });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_NOT_YET_VALID");
+    expect(couponUsedCount(app, "SAVE20")).toBe(0);
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = makeApp("2027-01-02T00:00:00Z");
+    addCoupon(app, { validFrom: FROM, validUntil: UNTIL });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_EXPIRED");
+  });
+});
+
+describe("POST /orders/:id/apply-coupon - side effects", () => {
+  it("AC-09 records the redemption and increments usedCount", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+
+    expect(couponUsedCount(app, "SAVE20")).toBe(1);
+    expect(redemptionCount(app)).toBe(1);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+
+    const row = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .get() as any;
+    expect(row).toMatchObject({
+      order_id: 1,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+
+  it("AC-08 rejects a second coupon on the same order without changing anything", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addCoupon(app, { code: "SAVE10", value: 10 });
+    addOrder(app, 10000);
+
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, 1, { couponCode: "SAVE10" });
+
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(couponUsedCount(app, "SAVE10")).toBe(0);
+    expect(redemptionCount(app)).toBe(1);
+  });
+});
+
+describe("POST /orders/:id/apply-coupon - error precedence and codes", () => {
+  it("rejects an invalid request body first", () => {
+    const app = makeApp();
+
+    expect(errorCode(apply(app, 1, {}))).toBe("INVALID_REQUEST");
+    expect(errorCode(apply(app, 1, { couponCode: 123 }))).toBe("INVALID_REQUEST");
+    expect(errorCode(apply(app, 1, { couponCode: "   " }))).toBe("INVALID_REQUEST");
+    expect(errorCode(apply(app, 1, { couponCode: null }))).toBe("INVALID_REQUEST");
+  });
+
+  it("returns ORDER_NOT_FOUND before looking at the coupon", () => {
+    const app = makeApp();
+
+    const res = apply(app, 99, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns ORDER_NOT_PENDING for a paid order", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+    app.request("POST", "/orders/1/pay");
+
+    const res = apply(app, 1, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns ORDER_NOT_PENDING for a cancelled order", () => {
+    const app = makeApp();
+    addCoupon(app);
+    addOrder(app, 10000);
+    app.request("POST", "/orders/1/cancel");
+
+    const res = apply(app, 1, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown coupon", () => {
+    const app = makeApp();
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns COUPON_INACTIVE for a disabled coupon", () => {
+    const app = makeApp();
+    addCoupon(app, { status: "DISABLED" });
+    addOrder(app, 10000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_INACTIVE");
+  });
+
+  it("returns COUPON_USAGE_EXHAUSTED once the usage limit is reached", () => {
+    const app = makeApp();
+    addCoupon(app, { usageLimit: 1 });
+    addOrder(app, 10000, "alice");
+    addOrder(app, 10000, "bob");
+
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = apply(app, 2, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_USAGE_EXHAUSTED");
+    expect(couponUsedCount(app, "SAVE20")).toBe(1);
+    expect(redemptionCount(app)).toBe(1);
+  });
+
+  it("returns MINIMUM_NOT_MET and leaves the database untouched", () => {
+    const app = makeApp();
+    addCoupon(app, { minAmountCents: 2000 });
+    addOrder(app, 1000);
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("MINIMUM_NOT_MET");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 1000,
+      couponCode: null,
+      status: "PENDING",
+    });
+    expect(couponUsedCount(app, "SAVE20")).toBe(0);
+    expect(redemptionCount(app)).toBe(0);
+  });
+});
