@@ -0,0 +1,278 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const VALID_FROM = "2026-01-01T00:00:00Z";
+const VALID_UNTIL = "2027-01-01T00:00:00Z";
+const NOW = "2026-10-01T08:00:00Z";
+
+function appAt(now: string = NOW): App {
+  return createApp({ clock: () => new Date(now) });
+}
+
+function makeCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: VALID_FROM,
+    validUntil: VALID_UNTIL,
+    ...overrides,
+  });
+  if (res.status !== 201) throw new Error(`coupon setup failed: ${JSON.stringify(res.body)}`);
+}
+
+function makeOrder(app: App, amountCents: number, customer = "alice"): number {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  if (res.status !== 201) throw new Error(`order setup failed: ${JSON.stringify(res.body)}`);
+  return (res.body as { id: number }).id;
+}
+
+const apply = (app: App, id: number, couponCode: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, { couponCode });
+
+const errorCode = (body: unknown) => (body as { error: { code: string } }).error.code;
+
+describe("apply coupon - discount computation (AC-01..AC-05)", () => {
+  it("AC-01: PERCENT 20 on 10000 gives 2000 / 8000", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "PERCENT", value: 20 });
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02: FIXED 1500 on 10000 gives final 8500", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "FIXED", value: 1500 });
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: PERCENT cap limits discount to maxDiscountCents", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const id = makeOrder(app, 100000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 5000 });
+  });
+
+  it("AC-04: FIXED above amount clamps to amount, final 0", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "FIXED", value: 3000 });
+    const id = makeOrder(app, 1000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05: PERCENT rounds down", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "PERCENT", value: 15 });
+    const id = makeOrder(app, 999);
+    const res = apply(app, id, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 149 });
+  });
+});
+
+describe("apply coupon - eligibility (AC-06, AC-07, AC-10)", () => {
+  it("AC-06: amount equal to minAmountCents succeeds", () => {
+    const app = appAt();
+    makeCoupon(app, { type: "FIXED", value: 500, minAmountCents: 5000 });
+    const id = makeOrder(app, 5000);
+    expect(apply(app, id, "SAVE20").status).toBe(200);
+  });
+
+  it("AC-07: now == validUntil is expired", () => {
+    const app = appAt(VALID_UNTIL);
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res.body)).toBe("COUPON_EXPIRED");
+  });
+
+  it("AC-07: now == validFrom succeeds", () => {
+    const app = appAt(VALID_FROM);
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    expect(apply(app, id, "SAVE20").status).toBe(200);
+  });
+
+  it("AC-10: ' save20 ' matches SAVE20", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, " save20 ");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+});
+
+describe("apply coupon - response and persistence (AC-08, AC-09)", () => {
+  it("AC-08: a second coupon is rejected and amounts are unchanged", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const first = apply(app, id, "SAVE20");
+    expect(first.status).toBe(200);
+    const second = apply(app, id, "SAVE20");
+    expect(second.status).toBe(409);
+    expect(errorCode(second.body)).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${id}`).body).toEqual(first.body);
+  });
+
+  it("AC-09: success increments usedCount and adds a redemption row", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    expect((app.request("GET", "/coupons/SAVE20").body as { usedCount: number }).usedCount).toBe(0);
+    apply(app, id, "SAVE20");
+    expect((app.request("GET", "/coupons/SAVE20").body as { usedCount: number }).usedCount).toBe(1);
+    const rows = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .all() as unknown as Array<Record<string, unknown>>;
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      order_id: id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+
+  it("returns HTTP 200 with a body identical to GET /orders/:id", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const applied = apply(app, id, "SAVE20");
+    expect(applied.status).toBe(200);
+    expect(applied.body).toEqual(app.request("GET", `/orders/${id}`).body);
+    expect(applied.body).toMatchObject({ status: "PENDING" });
+  });
+});
+
+describe("apply coupon - errors and precedence", () => {
+  it("REQ-13: missing / non-string / blank couponCode are INVALID_REQUEST", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    for (const body of [{}, { couponCode: 123 }, { couponCode: "" }, { couponCode: "   " }]) {
+      const res = app.request("POST", `/orders/${id}/apply-coupon`, body);
+      expect(res.status).toBe(400);
+      expect(errorCode(res.body)).toBe("INVALID_REQUEST");
+    }
+  });
+
+  it("ORDER_NOT_FOUND for an unknown order", () => {
+    const app = appAt();
+    const res = apply(app, 999, "SAVE20");
+    expect(res.status).toBe(404);
+    expect(errorCode(res.body)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("ORDER_NOT_PENDING for a paid order", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    app.request("POST", `/orders/${id}/pay`);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(409);
+    expect(errorCode(res.body)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("COUPON_NOT_FOUND for an unknown code", () => {
+    const app = appAt();
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "NOPE");
+    expect(res.status).toBe(404);
+    expect(errorCode(res.body)).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("COUPON_INACTIVE for a disabled coupon", () => {
+    const app = appAt();
+    makeCoupon(app, { status: "DISABLED" });
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res.body)).toBe("COUPON_INACTIVE");
+  });
+
+  it("COUPON_NOT_YET_VALID before validFrom", () => {
+    const app = appAt("2025-12-31T00:00:00Z");
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res.body)).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("COUPON_USAGE_EXHAUSTED once usageLimit is reached", () => {
+    const app = appAt();
+    makeCoupon(app, { usageLimit: 1 });
+    const first = makeOrder(app, 10000, "alice");
+    const second = makeOrder(app, 10000, "bob");
+    expect(apply(app, first, "SAVE20").status).toBe(200);
+    const res = apply(app, second, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res.body)).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("MINIMUM_NOT_MET below minAmountCents", () => {
+    const app = appAt();
+    makeCoupon(app, { minAmountCents: 20000 });
+    const id = makeOrder(app, 10000);
+    const res = apply(app, id, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(errorCode(res.body)).toBe("MINIMUM_NOT_MET");
+  });
+
+  it("precedence: missing order beats unknown coupon", () => {
+    const app = appAt();
+    const res = apply(app, 999, "NOPE");
+    expect(res.status).toBe(404);
+    expect(errorCode(res.body)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("precedence: already applied beats coupon problems", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    apply(app, id, "SAVE20");
+    const res = apply(app, id, " save20 ");
+    expect(res.status).toBe(409);
+    expect(errorCode(res.body)).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("REQ-12: a rejected request leaves order, usage count and redemptions untouched", () => {
+    const app = appAt();
+    makeCoupon(app, { minAmountCents: 20000 });
+    const id = makeOrder(app, 10000);
+    const before = app.request("GET", `/orders/${id}`).body;
+    apply(app, id, "SAVE20");
+    expect(app.request("GET", `/orders/${id}`).body).toEqual(before);
+    expect((app.request("GET", "/coupons/SAVE20").body as { usedCount: number }).usedCount).toBe(0);
+    const count = app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as unknown as { n: number };
+    expect(count.n).toBe(0);
+  });
+});
+
+describe("OrderRepository.applyCoupon transaction", () => {
+  it("rolls back all writes when a step fails", () => {
+    const app = appAt();
+    makeCoupon(app);
+    const id = makeOrder(app, 10000);
+    const repo = new OrderRepository(app.db);
+    const before = app.request("GET", `/orders/${id}`).body;
+
+    // The redemption insert violates its coupon_code foreign key, so the
+    // transaction must roll back the order update and the usage-count bump.
+    expect(() => repo.applyCoupon(id, "MISSING", 100, 9900, "2026-10-01T08:00:00.000Z")).toThrow();
+
+    expect(app.request("GET", `/orders/${id}`).body).toEqual(before);
+    expect((app.request("GET", "/coupons/SAVE20").body as { usedCount: number }).usedCount).toBe(0);
+    const count = app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as unknown as { n: number };
+    expect(count.n).toBe(0);
+  });
+});
