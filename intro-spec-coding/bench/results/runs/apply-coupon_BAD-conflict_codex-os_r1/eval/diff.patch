@@ -0,0 +1,431 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { CouponRepository, type Coupon } from "../src/repositories/couponRepository.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+import { CouponService, normalizeCouponCode } from "../src/services/couponService.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = (iso: string = NOW) => () => new Date(iso);
+
+interface CouponInput {
+  code?: string;
+  type?: "FIXED" | "PERCENT";
+  value?: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+const couponBody = (overrides: CouponInput = {}) => ({
+  code: "SAVE20",
+  type: "PERCENT" as const,
+  value: 20,
+  minAmountCents: 0,
+  maxDiscountCents: null,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  status: "ACTIVE" as const,
+  usageLimit: null,
+  ...overrides,
+});
+
+function createCoupon(app: App, overrides: CouponInput = {}) {
+  const body = couponBody(overrides);
+  const res = app.request("POST", "/coupons", body);
+  expect(res.status).toBe(201);
+  return body;
+}
+
+function createOrder(app: App, amountCents = 10000, customer = "alice"): number {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+const applyCoupon = (app: App, id: number, couponCode?: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, couponCode === undefined ? {} : { couponCode });
+
+const applyRawBody = (app: App, id: number, body: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+const codeOf = (body: unknown) => (body as { error: { code: string } }).error.code;
+
+function insertCoupon(app: App, overrides: Partial<Omit<Coupon, "usedCount">> = {}): Coupon {
+  return new CouponRepository(app.db).insert({
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    minAmountCents: 0,
+    maxDiscountCents: null,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    status: "ACTIVE",
+    usageLimit: null,
+    ...overrides,
+  });
+}
+
+const makeService = (app: App) => new CouponService(new CouponRepository(app.db));
+const redemptionsOf = (app: App, orderId: number) =>
+  new CouponRedemptionRepository(app.db).findByOrder(orderId);
+const failedCode = (run: () => unknown): string | null => {
+  try {
+    run();
+    return null;
+  } catch (e) {
+    return (e as { code?: string }).code ?? null;
+  }
+};
+
+describe("coupon redemption repository", () => {
+  it("writes the order, the redemption and the usage counter together", () => {
+    const app = createApp({ clock: fixedClock() });
+    createCoupon(app);
+    const orderId = createOrder(app);
+
+    expect(applyCoupon(app, orderId, "SAVE20").status).toBe(200);
+
+    expect(redemptionsOf(app, orderId)).toMatchObject([
+      {
+        orderId,
+        couponCode: "SAVE20",
+        discountCents: 2000,
+        createdAt: "2026-10-01T08:00:00.000Z",
+      },
+    ]);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("rolls the whole redemption back when one write fails", () => {
+    const app = createApp({ clock: fixedClock() });
+    createCoupon(app);
+    const orderId = createOrder(app);
+
+    const failure = failedCode(() =>
+      new CouponRedemptionRepository(app.db).redeem({
+        orderId,
+        couponCode: "DOES-NOT-EXIST",
+        discountCents: 2000,
+        finalAmountCents: 8000,
+        createdAt: NOW,
+      }),
+    );
+    expect(failure).not.toBeNull();
+
+    expect(redemptionsOf(app, orderId)).toHaveLength(0);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+  });
+});
+
+describe("coupon eligibility", () => {
+  it("normalizes codes by trimming and upper-casing them", () => {
+    expect(normalizeCouponCode(" save20 ")).toBe("SAVE20");
+  });
+
+  it("rejects unknown, inactive, early, expired and exhausted coupons", () => {
+    const app = createApp({ clock: fixedClock() });
+    const coupons = makeService(app);
+    insertCoupon(app, { code: "SAVE20" });
+    insertCoupon(app, { code: "OFF", status: "DISABLED" });
+    insertCoupon(app, { code: "LATER", validFrom: "2027-01-01T00:00:00Z" });
+    insertCoupon(app, { code: "GONE", validUntil: "2026-01-01T00:00:00Z" });
+    insertCoupon(app, { code: "USED", usageLimit: 1 });
+    app.db.exec("UPDATE coupons SET used_count = 1 WHERE code = 'USED'");
+    const at = new Date(NOW);
+
+    expect(failedCode(() => coupons.resolveUsable("NOPE", at))).toBe("COUPON_NOT_FOUND");
+    expect(failedCode(() => coupons.resolveUsable("OFF", at))).toBe("COUPON_INACTIVE");
+    expect(failedCode(() => coupons.resolveUsable("LATER", at))).toBe("COUPON_NOT_YET_VALID");
+    expect(failedCode(() => coupons.resolveUsable("GONE", at))).toBe("COUPON_EXPIRED");
+    expect(failedCode(() => coupons.resolveUsable("USED", at))).toBe("COUPON_USAGE_EXHAUSTED");
+    expect(coupons.resolveUsable("SAVE20", at).code).toBe("SAVE20");
+  });
+
+  it("accepts the first instant of validity and rejects the closing instant", () => {
+    const app = createApp({ clock: fixedClock("2026-03-01T00:00:00Z") });
+    const coupons = makeService(app);
+    insertCoupon(app, { code: "START", validFrom: "2026-03-01T00:00:00Z" });
+    insertCoupon(app, { code: "END", validUntil: "2026-03-01T00:00:00Z" });
+    const at = new Date("2026-03-01T00:00:00Z");
+
+    expect(coupons.resolveUsable("START", at).code).toBe("START");
+    expect(failedCode(() => coupons.resolveUsable("END", at))).toBe("COUPON_EXPIRED");
+  });
+});
+
+describe("discount arithmetic", () => {
+  it("applies the documented amounts", () => {
+    const app = createApp({ clock: fixedClock() });
+    const coupons = makeService(app);
+    expect(coupons.discountFor(insertCoupon(app, { code: "P20" }), 10000)).toBe(2000);
+    expect(coupons.discountFor(insertCoupon(app, { code: "F15", type: "FIXED", value: 1500 }), 10000)).toBe(1500);
+    expect(coupons.discountFor(insertCoupon(app, { code: "P15", value: 15 }), 999)).toBe(149);
+    expect(coupons.discountFor(insertCoupon(app, { code: "BIG", type: "FIXED", value: 3000 }), 1000)).toBe(1000);
+  });
+
+  it("caps only when the coupon carries a maximum", () => {
+    const app = createApp({ clock: fixedClock() });
+    const coupons = makeService(app);
+    expect(coupons.discountFor(insertCoupon(app, { code: "UNCAPPED" }), 100000)).toBe(20000);
+    expect(coupons.discountFor(insertCoupon(app, { code: "CAPPED", maxDiscountCents: 5000 }), 100000)).toBe(5000);
+    expect(coupons.discountFor(insertCoupon(app, { code: "SLACK", maxDiscountCents: 50000 }), 100000)).toBe(20000);
+  });
+});
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("AC-01 / AC-14: 20% of 10000 and the response matches the order read", () => {
+    const app = createApp({ clock: fixedClock() });
