+  /**
+   * REQ-01..REQ-14: applies a coupon to a pending order and returns the updated order.
+   * Checks run in the documented order, so the first failing rule decides the response.
+   */
+  applyCoupon(id: number, rawCouponCode: unknown): Order {
+    // REQ-13: the request body is validated before anything is looked up.
+    if (typeof rawCouponCode !== "string" || rawCouponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode must be a non-empty string");
+    }
+
+    // REQ-04: the order must exist and still be pending.
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+
+    const couponCode = normalizeCouponCode(rawCouponCode);
+    // REQ-10: the coupon already on the order cannot be consumed twice.
+    if (order.couponCode === couponCode) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${couponCode}`);
+    }
