+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "MINIMUM_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+
+    // REQ-06..REQ-09: money is derived from the order amount, so replacing an earlier
+    // coupon recomputes the amounts from scratch.
+    const discountCents = this.coupons.discountFor(coupon, order.amountCents);
+    this.redemptions.redeem({
+      orderId: id,
+      couponCode,
+      discountCents,
+      finalAmountCents: order.amountCents - discountCents,
+      createdAt: now.toISOString(),
+    });
+
+    // REQ-14: read back so the response matches GET /orders/:id exactly.
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
