+
+  /**
+   * REQ-01..REQ-03, REQ-11: the coupon a normalized code resolves to, provided it may be
+   * used at `now`. `now` always comes from the injected clock, never from the system time.
+   */
+  resolveUsable(code: string, now: Date): Coupon {
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+    const at = now.getTime();
+    if (at < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is valid from ${coupon.validFrom}`);
+    }
+    if (at >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} reached its usage limit`);
+    }
+    return coupon;
+  }
+
+  /**
+   * REQ-06..REQ-09: the discount `coupon` gives an order of `amountCents`, capped by the
+   * coupon's optional maximum and never larger than the order itself.
+   */
+  discountFor(coupon: Coupon, amountCents: number): number {
+    const computed = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? computed : Math.min(computed, coupon.maxDiscountCents);
+    return Math.min(capped, amountCents);
+  }
 }
