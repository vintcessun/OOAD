+++ b/src/repositories/couponRedemptionRepository.ts
@@ -0,0 +1,74 @@
+import type { Db } from "../db.ts";
+
+export interface Redemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+export interface RedeemInput {
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  finalAmountCents: number;
+  createdAt: string;
+}
+
+interface RedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
+const toRedemption = (r: RedemptionRow): Redemption => ({
+  id: r.id,
+  orderId: r.order_id,
+  couponCode: r.coupon_code,
+  discountCents: r.discount_cents,
+  createdAt: r.created_at,
+});
+
+/**
+ * Persists coupon redemptions. Deciding whether a coupon may be applied is a service
+ * concern; this repository only knows how the three affected tables are written.
+ */
+export class CouponRedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  /**
+   * REQ-12: updating the order, recording the redemption and bumping the coupon's usage
+   * counter happen in one transaction, so a failure anywhere leaves nothing behind.
+   */
+  redeem(input: RedeemInput): void {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare(
+          "UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?",
+        )
+        .run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+      this.db
+        .prepare(
+          `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+           VALUES (?, ?, ?, ?)`,
+        )
+        .run(input.orderId, input.couponCode, input.discountCents, input.createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+      this.db.exec("COMMIT");
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+
+  findByOrder(orderId: number): Redemption[] {
+    const rows = this.db
+      .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ? ORDER BY id")
+      .all(orderId) as unknown as RedemptionRow[];
+    return rows.map(toRedemption);
+  }
+}
