diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..7a26652 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,23 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  applyCoupon(id: number, couponCode: string, discountCents: number, finalAmountCents: number): Order {
+    this.db
+      .prepare("UPDATE orders SET coupon_code = ?, discount_cents = ?, final_amount_cents = ? WHERE id = ?")
+      .run(couponCode, discountCents, finalAmountCents, id);
+    return this.findById(id)!;
+  }
+
+  transaction<T>(fn: () => T): T {
+    this.db.exec("BEGIN");
+    try {
+      const result = fn();
+      this.db.exec("COMMIT");
+      return result;
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
