+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function setup(orderAmountCents = 12000) {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: orderAmountCents });
+  return app;
+}
+
+function addCoupon(app: ReturnType<typeof createApp>, overrides: Record<string, unknown> = {}) {
+  return app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+}
+
+describe("apply coupon", () => {
+  it("applies a valid FIXED coupon and persists the discount", () => {
+    const app = setup();
+    addCoupon(app, { code: "TAKE10", type: "FIXED", value: 2000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "TAKE10" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      couponCode: "TAKE10",
+      discountCents: 2000,
+      finalAmountCents: 10000,
+    });
+  });
+
+  it("applies a valid PERCENT coupon", () => {
+    const app = setup();
+    addCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600 });
+  });
+
+  it("caps a PERCENT discount at maxDiscountCents", () => {
+    const app = setup();
+    addCoupon(app, { code: "CAP10", type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "CAP10" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 11000 });
+  });
+
+  it("never discounts more than the order amount", () => {
+    const app = setup(500);
+    addCoupon(app, { code: "BIG", type: "FIXED", value: 999999 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIG" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 500, finalAmountCents: 0 });
+  });
+
+  it("increments the coupon used count and records a redemption", () => {
+    const app = setup();
+    addCoupon(app, { code: "ONCE", type: "FIXED", value: 100 });
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "ONCE" });
+    expect(app.request("GET", "/coupons/ONCE").body).toMatchObject({ usedCount: 1 });
+    const redemption = app.db.prepare("SELECT * FROM coupon_redemptions WHERE order_id = 1").get() as any;
+    expect(redemption).toMatchObject({ coupon_code: "ONCE", discount_cents: 100 });
+  });
+
+  it("rejects an unknown coupon with 400", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const app = setup();
+    addCoupon(app, { code: "OFF", status: "DISABLED" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OFF" }).status).toBe(400);
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = setup();
+    addCoupon(app, { code: "OLD", validUntil: "2026-09-01T00:00:00Z" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OLD" }).status).toBe(400);
+  });
+
+  it("rejects a not-yet-valid coupon with 400", () => {
+    const app = setup();
+    addCoupon(app, { code: "SOON", validFrom: "2026-11-01T00:00:00Z" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SOON" }).status).toBe(400);
+  });
+
+  it("rejects an order below the coupon minimum with 400", () => {
+    const app = setup(500);
+    addCoupon(app, { code: "MIN1000", type: "FIXED", value: 100, minAmountCents: 1000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "MIN1000" }).status).toBe(400);
+  });
+
+  it("rejects a non-pending order with 400", () => {
+    const app = setup();
+    addCoupon(app, { code: "PAIDONLY" });
+    app.request("POST", "/orders/1/pay");
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "PAIDONLY" }).status).toBe(400);
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = setup();
+    addCoupon(app, { code: "ANY" });
+    expect(app.request("POST", "/orders/99/apply-coupon", { couponCode: "ANY" }).status).toBe(404);
+  });
+
+  it("rejects a missing coupon code with 400", () => {
+    const app = setup();
+    expect(app.request("POST", "/orders/1/apply-coupon", {}).status).toBe(400);
+  });
+});
