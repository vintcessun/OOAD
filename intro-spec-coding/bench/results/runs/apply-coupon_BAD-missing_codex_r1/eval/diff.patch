diff --git a/src/repositories/orderRepository.ts b/src/repositories/orderRepository.ts
index 8fc45d5..486d6cb 100755
--- a/src/repositories/orderRepository.ts
+++ b/src/repositories/orderRepository.ts
@@ -57,4 +57,34 @@ export class OrderRepository {
   updateStatus(id: number, status: Order["status"]): void {
     this.db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
   }
+
+  /**
+   * Applies a coupon to an order atomically: updates the order amounts/coupon,
+   * records a redemption and bumps the coupon usage counter. Rolls back on any failure.
+   */
+  applyCoupon(
+    id: number,
+    discountCents: number,
+    finalAmountCents: number,
+    couponCode: string,
+    now: string,
+  ): Order {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+        .run(discountCents, finalAmountCents, couponCode, id);
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(id, couponCode, discountCents, now);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(couponCode);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+    return this.findById(id)!;
+  }
 }
