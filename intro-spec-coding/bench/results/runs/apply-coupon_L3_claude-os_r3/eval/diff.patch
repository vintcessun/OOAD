+describe("apply-coupon discount computation (AC-01..AC-06, AC-10)", () => {
+  it("AC-01: percent discount", () => {
+    const { app } = makeApp();
+    seedCoupon(app, { type: "PERCENT", value: 20 });
+    const order = seedOrder(app, 10000);
+
+    const res = apply(app, order.id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-02: fixed discount", () => {
+    const { app } = makeApp();
+    seedCoupon(app, { type: "FIXED", value: 1500 });
+    const order = seedOrder(app, 10000);
+
+    const res = apply(app, order.id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: percent discount is capped", () => {
+    const { app } = makeApp();
+    seedCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const order = seedOrder(app, 100000);
+
+    const res = apply(app, order.id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-04: discount never exceeds the amount", () => {
+    const { app } = makeApp();
+    seedCoupon(app, { type: "FIXED", value: 3000 });
+    const order = seedOrder(app, 1000);
+
+    const res = apply(app, order.id, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-05: percent discount is floored", () => {
+    const { app } = makeApp();
+    seedCoupon(app, { type: "PERCENT", value: 15 });
+    const order = seedOrder(app, 999);
+
+    const res = apply(app, order.id, "SAVE20");
