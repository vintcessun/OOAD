@@ -0,0 +1,367 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const DEFAULT_NOW = "2026-10-01T08:00:00Z";
+
+function makeApp(now = DEFAULT_NOW) {
+  let current = now;
+  const app = createApp({ clock: () => new Date(current) });
+  return { app, setNow: (iso: string) => (current = iso) };
+}
+
+interface CouponInput {
+  code?: string;
+  type?: "FIXED" | "PERCENT";
+  value?: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function seedCoupon(app: ReturnType<typeof createApp>, overrides: CouponInput = {}) {
+  const body = {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    minAmountCents: 0,
+    maxDiscountCents: null,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    status: "ACTIVE",
+    usageLimit: null,
+    ...overrides,
+  };
+  const res = app.request("POST", "/coupons", body);
+  expect(res.status).toBe(201);
+}
+
+function seedOrder(app: ReturnType<typeof createApp>, amountCents = 10000) {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return res.body as any;
+}
+
+const apply = (app: ReturnType<typeof createApp>, id: number, couponCode?: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, couponCode === undefined ? {} : { couponCode });
+
+describe("OrderRepository.applyCoupon", () => {
+  const setup = () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const coupons = new CouponRepository(db);
+    coupons.insert({
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      minAmountCents: 0,
+      maxDiscountCents: null,
+      validFrom: "2026-01-01T00:00:00Z",
+      validUntil: "2027-01-01T00:00:00Z",
+      status: "ACTIVE",
+      usageLimit: null,
+    });
+    const order = orders.insert("alice", 10000, "2026-10-01T08:00:00.000Z");
+    return { db, orders, coupons, order };
+  };
+
+  it("commits the order update, redemption row, and used count together", () => {
+    const { db, orders, order } = setup();
+
+    orders.applyCoupon(order.id, "SAVE20", 2000, 8000, "2026-10-01T08:00:00.000Z");
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(
+      db
+        .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions WHERE order_id = ?")
+        .get(order.id),
+    ).toMatchObject({
+      order_id: order.id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = ?").get("SAVE20")).toEqual({ used_count: 1 });
+  });
+
+  it("rolls back every write when a statement fails", () => {
+    const { db, orders, order } = setup();
+
+    expect(() => orders.applyCoupon(order.id, "MISSING", 500, 9500, "2026-10-01T08:00:00.000Z")).toThrow();
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+    expect(db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 0 });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = ?").get("SAVE20")).toEqual({ used_count: 0 });
+  });
+});
