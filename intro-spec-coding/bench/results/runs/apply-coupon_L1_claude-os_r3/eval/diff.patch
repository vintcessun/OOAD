+++ b/src/repositories/couponRedemptionRepository.ts
@@ -0,0 +1,51 @@
+import type { Db } from "../db.ts";
+
+export interface CouponRedemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+interface CouponRedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
+const toRedemption = (r: CouponRedemptionRow): CouponRedemption => ({
+  id: r.id,
+  orderId: r.order_id,
+  couponCode: r.coupon_code,
+  discountCents: r.discount_cents,
+  createdAt: r.created_at,
+});
+
+export class CouponRedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  insert(orderId: number, couponCode: string, discountCents: number, createdAt: string): CouponRedemption {
+    const res = this.db
+      .prepare(
+        `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+         VALUES (?, ?, ?, ?)`,
+      )
+      .run(orderId, couponCode, discountCents, createdAt);
+    return this.findById(Number(res.lastInsertRowid))!;
+  }
+
+  findById(id: number): CouponRedemption | undefined {
+    const row = this.db.prepare("SELECT * FROM coupon_redemptions WHERE id = ?").get(id) as
+      | CouponRedemptionRow
+      | undefined;
+    return row && toRedemption(row);
+  }
+
+  findByOrder(orderId: number): CouponRedemption[] {
+    const rows = this.db.prepare("SELECT * FROM coupon_redemptions WHERE order_id = ? ORDER BY id").all(orderId) as unknown as CouponRedemptionRow[];
+    return rows.map(toRedemption);
+  }
+}
