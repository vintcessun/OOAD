+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const coupon = {
+  code: "SAVE20",
+  type: "PERCENT" as const,
+  value: 20,
+  minAmountCents: 0,
+  maxDiscountCents: null,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  status: "ACTIVE" as const,
+  usageLimit: null,
+};
+
+describe("repository: coupon application", () => {
+  it("writes the discount, final amount and coupon code on an order", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const order = orders.insert("alice", 12000, "2026-10-01T08:00:00.000Z");
+
+    orders.applyCoupon(order.id, { discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("increments a coupon's used count", () => {
+    const db = openDb();
+    const coupons = new CouponRepository(db);
+    coupons.insert(coupon);
+
+    coupons.incrementUsedCount("SAVE20");
+
+    expect(coupons.findByCode("SAVE20")!.usedCount).toBe(1);
+  });
+
+  it("stores and reads back a redemption for its order", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const coupons = new CouponRepository(db);
+    const redemptions = new CouponRedemptionRepository(db);
+    const order = orders.insert("alice", 12000, "2026-10-01T08:00:00.000Z");
+    coupons.insert(coupon);
+
+    redemptions.insert(order.id, "SAVE20", 2400, "2026-10-01T08:00:00.000Z");
+
+    expect(redemptions.findByOrder(order.id)).toMatchObject([
+      { orderId: order.id, couponCode: "SAVE20", discountCents: 2400, createdAt: "2026-10-01T08:00:00.000Z" },
+    ]);
+  });
+});
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function newOrder(app: App, amountCents = 12000): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  return (res.body as any).id;
+}
+
+function newCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  if (res.status !== 201) throw new Error(`coupon setup failed: ${JSON.stringify(res.body)}`);
+}
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a percent coupon and returns the updated order", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("applies a fixed coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { type: "FIXED", value: 1500 });
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 10500,
+    });
+  });
+
+  it("caps a percent coupon at maxDiscountCents", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { value: 50, maxDiscountCents: 1000 });
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 11000,
+    });
+  });
+
+  it("floors a percent discount to whole cents", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 999);
+    newCoupon(app, { value: 10 });
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 99,
+      finalAmountCents: 900,
+    });
+  });
+
+  it("never discounts more than the order amount", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 3000);
+    newCoupon(app, { type: "FIXED", value: 5000 });
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 3000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("increments usedCount and records the redemption", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app);
+
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(new CouponRedemptionRepository(app.db).findByOrder(id)).toMatchObject([
+      { orderId: id, couponCode: "SAVE20", discountCents: 2400 },
+    ]);
+  });
+
+  it("rejects an unknown order", () => {
+    const app = createApp({ clock: fixedClock });
+    newCoupon(app);
+
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects a non-pending order", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app);
+    app.request("POST", `/orders/${id}/pay`);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("rejects a second coupon on the same order", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app);
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("rejects a missing coupon code", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, {});
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "NOPE" });
+
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app);
+    newCoupon(app, { status: "DISABLED" });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_DISABLED");
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app);
+    newCoupon(app, { validFrom: "2026-11-01T00:00:00Z" });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app);
+    newCoupon(app, { validUntil: "2026-09-01T00:00:00Z" });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects an order below the coupon minimum", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 9000);
+    newCoupon(app, { minAmountCents: 10000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_MIN_AMOUNT_NOT_MET");
+  });
+
+  it("rejects a coupon whose usage limit is reached", () => {
+    const app = createApp({ clock: fixedClock });
+    const first = newOrder(app, 12000);
+    const second = newOrder(app, 12000);
+    newCoupon(app, { usageLimit: 1 });
+    app.request("POST", `/orders/${first}/apply-coupon`, { couponCode: "SAVE20" });
+
+    const res = app.request("POST", `/orders/${second}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_LIMIT_REACHED");
+  });
+
+  it("leaves the order, usedCount and redemptions untouched when rejected", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = newOrder(app, 12000);
+    newCoupon(app, { validUntil: "2026-09-01T00:00:00Z" });
+
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", `/orders/${id}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 12000,
+      couponCode: null,
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(new CouponRedemptionRepository(app.db).findByOrder(id)).toEqual([]);
+  });
+});
