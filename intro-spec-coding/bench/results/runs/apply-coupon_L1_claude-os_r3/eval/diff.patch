diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..58bbbef 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,11 +1,22 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
+import type { CouponRedemptionRepository } from "../repositories/couponRedemptionRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
+/** Fixed coupons take their value in cents; percent coupons take a floored percentage, capped by maxDiscountCents. */
+function computeDiscount(coupon: Coupon, amountCents: number): number {
+  let discount = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+  return Math.max(0, Math.min(discount, amountCents));
+}
+
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
     private readonly clock: Clock,
+    private readonly coupons: CouponRepository,
+    private readonly redemptions: CouponRedemptionRepository,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +52,37 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and records the redemption. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_DISABLED", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    if (now > Date.parse(coupon.validUntil)) throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT_NOT_MET", `coupon ${code} requires at least ${coupon.minAmountCents} cents`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has reached its usage limit`);
+    }
+
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    this.orders.applyCoupon(id, { discountCents, finalAmountCents: order.amountCents - discountCents, couponCode: code });
+    this.coupons.incrementUsedCount(code);
+    this.redemptions.insert(id, code, discountCents, this.clock().toISOString());
+    return this.get(id);
+  }
 }
