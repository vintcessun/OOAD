diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..9629f12 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,52 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and returns the updated order. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already applied coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT_NOT_MET", `order amount is below coupon ${code} minimum`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has no remaining uses`);
+    }
+
+    const discountCents = this.computeDiscount(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    if (!this.coupons.redeem(order.id, coupon.code, discountCents, this.clock().toISOString())) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} has no remaining uses`);
+    }
+    this.orders.applyCoupon(order.id, coupon.code, discountCents, finalAmountCents);
+    return this.get(id);
+  }
+
+  /** Discount in integer cents: FIXED is face value, PERCENT is a share of the order, capped and clamped. */
+  private computeDiscount(coupon: Coupon, amountCents: number): number {
+    const raw =
+      coupon.type === "FIXED" ? coupon.value : Math.round((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.min(capped, amountCents);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..3ba46a9
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,273 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+interface CouponInput {
+  code: string;
+  type: "FIXED" | "PERCENT";
+  value: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function newApp() {
+  return createApp({ clock: fixedClock });
+}
+
+function addCoupon(app: ReturnType<typeof createApp>, input: CouponInput) {
+  const res = app.request("POST", "/coupons", {
+    code: input.code,
+    type: input.type,
+    value: input.value,
+    minAmountCents: input.minAmountCents ?? 0,
+    maxDiscountCents: input.maxDiscountCents ?? null,
+    validFrom: input.validFrom ?? "2026-01-01T00:00:00Z",
+    validUntil: input.validUntil ?? "2027-01-01T00:00:00Z",
+    status: input.status ?? "ACTIVE",
+    usageLimit: input.usageLimit ?? null,
+  });
+  expect(res.status).toBe(201);
+  return res;
+}
+
+function addOrder(app: ReturnType<typeof createApp>, amountCents = 12000) {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return res;
+}
+
+const errorCode = (res: { body: unknown }) => (res.body as { error: { code: string } }).error.code;
+
+describe("apply coupon: discount computation", () => {
+  it("applies a fixed coupon as a flat cents discount", () => {
+    const app = newApp();
+    addCoupon(app, { code: "FLAT20", type: "FIXED", value: 2000 });
+    addOrder(app, 12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "FLAT20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      amountCents: 12000,
+      discountCents: 2000,
+      finalAmountCents: 10000,
+      couponCode: "FLAT20",
+      status: "PENDING",
+    });
+  });
+
+  it("applies a percent coupon as a share of the order", () => {
+    const app = newApp();
+    addCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    addOrder(app, 12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+  });
+
+  it("rounds a percent discount to the nearest cent", () => {
+    const app = newApp();
+    addCoupon(app, { code: "TENOFF", type: "PERCENT", value: 10 });
+    addOrder(app, 999);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "TENOFF" });
+    expect(res.body).toMatchObject({ discountCents: 100, finalAmountCents: 899 });
+  });
+
+  it("caps a percent discount with maxDiscountCents", () => {
+    const app = newApp();
+    addCoupon(app, { code: "BIG50", type: "PERCENT", value: 50, maxDiscountCents: 3000 });
+    addOrder(app, 12000);
+
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIG50" });
