diff --git a/src/repositories/couponRepository.ts b/src/repositories/couponRepository.ts
index 094341d..33736d6 100755
--- a/src/repositories/couponRepository.ts
+++ b/src/repositories/couponRepository.ts
@@ -57,4 +57,36 @@ export class CouponRepository {
     const row = this.db.prepare("SELECT * FROM coupons WHERE code = ?").get(code) as CouponRow | undefined;
     return row && toCoupon(row);
   }
+
+  /**
+   * Records a redemption and bumps used_count, but only while the coupon is
+   * still under its usage limit. Returns false (leaving no state behind) when
+   * the limit is already reached, so callers can report it.
+   */
+  redeem(orderId: number, couponCode: string, discountCents: number, createdAt: string): boolean {
+    this.db.exec("BEGIN");
+    try {
+      const res = this.db
+        .prepare(
+          `UPDATE coupons SET used_count = used_count + 1
+           WHERE code = ? AND (usage_limit IS NULL OR used_count < usage_limit)`,
+        )
+        .run(couponCode);
+      if (Number(res.changes) === 0) {
+        this.db.exec("ROLLBACK");
+        return false;
+      }
+      this.db
+        .prepare(
+          `INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at)
+           VALUES (?, ?, ?, ?)`,
+        )
+        .run(orderId, couponCode, discountCents, createdAt);
+      this.db.exec("COMMIT");
+      return true;
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
