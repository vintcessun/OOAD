@@ -41,4 +44,35 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(couponCode);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${couponCode} is ${coupon.status}`);
+
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) throw conflict("COUPON_NOT_YET_VALID", `coupon ${couponCode} is not valid yet`);
+    if (now > Date.parse(coupon.validUntil)) throw conflict("COUPON_EXPIRED", `coupon ${couponCode} has expired`);
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT_NOT_MET", `coupon ${couponCode} requires at least ${coupon.minAmountCents} cents`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${couponCode} has no remaining uses`);
+    }
+
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    this.orders.applyCoupon(id, couponCode, discountCents, order.amountCents - discountCents);
+    this.coupons.incrementUsedCount(couponCode);
+    this.coupons.recordRedemption(id, couponCode, discountCents, this.clock().toISOString());
+    return this.get(id);
+  }
 }
