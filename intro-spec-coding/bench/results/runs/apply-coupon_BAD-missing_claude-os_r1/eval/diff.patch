+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponApplicationRepository } from "../src/repositories/couponApplicationRepository.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const baseCoupon = {
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+function newApp(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function addOrder(app: App, amountCents = 10000, customer = "alice") {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  expect(res.status).toBe(201);
+  return res.body as any;
+}
+
+function addCoupon(app: App, overrides: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", { ...baseCoupon, ...overrides });
+  expect(res.status).toBe(201);
+  return res.body as any;
+}
+
+function apply(app: App, id: number, body: unknown) {
+  return app.request("POST", `/orders/${id}/apply-coupon`, body);
+}
+
+function redemptionCount(app: App): number {
+  return (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number }).n;
+}
+
+describe("coupon application repository", () => {
+  it("writes the order, redemption row, and usage counter in one call", () => {
+    const db = openDb();
+    const order = new OrderRepository(db).insert("alice", 10000, "2026-10-01T08:00:00.000Z");
+    new CouponRepository(db).insert({
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      minAmountCents: 0,
+      maxDiscountCents: null,
+      validFrom: "2026-01-01T00:00:00Z",
+      validUntil: "2027-01-01T00:00:00Z",
+      status: "ACTIVE",
+      usageLimit: null,
+    });
+
+    new CouponApplicationRepository(db).apply({
+      orderId: order.id,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      createdAt: "2026-10-01T08:00:00.000Z",
+    });
+
+    expect(new OrderRepository(db).findById(order.id)).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+    expect(new CouponRepository(db).findByCode("SAVE20")!.usedCount).toBe(1);
+    const rows = db.prepare("SELECT * FROM coupon_redemptions").all() as any[];
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      order_id: order.id,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+  });
+});
+
+describe("apply-coupon request validation", () => {
+  it.each([
+    ["missing", {}],
+    ["non-string", { couponCode: 123 }],
+    ["blank", { couponCode: "   " }],
+  ])("rejects a %s couponCode with INVALID_REQUEST", (_label, body) => {
+    const app = newApp();
+    addOrder(app);
+    const res = apply(app, 1, body);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+});
+
+describe("apply-coupon eligibility and precedence", () => {
+  it("returns ORDER_NOT_FOUND before checking the coupon", () => {
+    const app = newApp();
+    const res = apply(app, 99, { couponCode: "MISSING" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects a non-pending order with ORDER_NOT_PENDING", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app);
+    app.request("POST", "/orders/1/pay");
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns COUPON_ALREADY_APPLIED before looking the new coupon up", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app);
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+    const res = apply(app, 1, { couponCode: "NOPE" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown code", () => {
+    const app = newApp();
+    addOrder(app);
+    const res = apply(app, 1, { couponCode: "MISSING" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns COUPON_INACTIVE before the expiry check", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app, { status: "DISABLED", validFrom: "2025-01-01T00:00:00Z", validUntil: "2026-01-01T00:00:00Z" });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("returns COUPON_NOT_YET_VALID before validFrom", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app, { validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("returns COUPON_EXPIRED at or after validUntil", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app, { validFrom: "2025-01-01T00:00:00Z", validUntil: "2026-01-01T00:00:00Z" });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("returns COUPON_USAGE_EXHAUSTED when the limit is reached", () => {
+    const app = newApp();
+    addCoupon(app, { usageLimit: 1 });
+    addOrder(app, 10000, "a");
+    addOrder(app, 10000, "b");
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+    const res = apply(app, 2, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("returns MINIMUM_NOT_MET below the minimum amount", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app, { minAmountCents: 20000 });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+  });
+
+  it("accepts an order exactly at the minimum amount", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app, { minAmountCents: 10000 });
+    expect(apply(app, 1, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+});
+
+describe("apply-coupon discount calculation", () => {
+  it("AC-01: percent discount", () => {
+    const app = newApp();
+    addOrder(app, 10000);
+    addCoupon(app, { type: "PERCENT", value: 20 });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-02: fixed discount", () => {
+    const app = newApp();
+    addOrder(app, 10000);
+    addCoupon(app, { type: "FIXED", value: 1500 });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: percent discount capped by maxDiscountCents", () => {
+    const app = newApp();
+    addOrder(app, 100000);
+    addCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 5000 });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-05: percent discount rounds down", () => {
+    const app = newApp();
+    addOrder(app, 999);
+    addCoupon(app, { type: "PERCENT", value: 15 });
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-10: trims and upper-cases the coupon code", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app);
+    expect(apply(app, 1, { couponCode: " save20 " }).status).toBe(200);
+  });
+});
+
+describe("apply-coupon persistence semantics", () => {
+  it("AC-09: success records the redemption, bumps usage, and matches GET", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app);
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect((res.body as any).couponCode).toBe("SAVE20");
+    expect((res.body as any).status).toBe("PENDING");
+    expect(app.request("GET", "/orders/1").body).toEqual(res.body);
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(1);
+    expect(redemptionCount(app)).toBe(1);
+  });
+
+  it("AC-08: a rejected second application changes nothing", () => {
+    const app = newApp();
+    addOrder(app);
+    addCoupon(app);
+    const first = apply(app, 1, { couponCode: "SAVE20" });
+    expect(first.status).toBe(200);
+    const before = app.request("GET", "/orders/1").body;
+
+    const res = apply(app, 1, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", "/orders/1").body).toEqual(before);
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(1);
+    expect(redemptionCount(app)).toBe(1);
+  });
+});
