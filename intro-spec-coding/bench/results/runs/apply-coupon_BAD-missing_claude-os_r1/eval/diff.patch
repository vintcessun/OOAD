index 63b29b4..058794c 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,14 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
+import type { CouponApplicationRepository } from "../repositories/couponApplicationRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
+    private readonly applications: CouponApplicationRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +45,63 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies one coupon to a pending order. Rules run in the documented precedence order. */
+  applyCoupon(id: number, body: Record<string, unknown>): Order {
+    // REQ-13: request body must carry a non-blank string code.
+    const raw = body?.couponCode;
+    if (typeof raw !== "string" || raw.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    // REQ-01: normalize before lookup.
+    const code = raw.trim().toUpperCase();
+
+    // REQ-04 / REQ-10: order checks come before coupon checks.
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already has a coupon`);
+
+    // REQ-01: look the normalized code up.
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+
+    // REQ-02: must be ACTIVE.
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    // REQ-03: now comes from the injected clock, compared to the validity window.
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+
+    // REQ-11: usage limit.
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} has reached its usage limit`);
+    }
+
+    // REQ-05: minimum amount (equality is allowed).
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount ${order.amountCents} is below ${coupon.minAmountCents}`);
+    }
+
+    // REQ-06 / REQ-07 / REQ-08 / REQ-09: discount and final amount.
+    let discount = coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    const finalAmountCents = order.amountCents - discount;
+
+    // REQ-12: persist order update, redemption row, and usage increment atomically.
+    this.applications.apply({
+      orderId: id,
+      couponCode: code,
+      discountCents: discount,
+      finalAmountCents,
+      createdAt: now.toISOString(),
+    });
+
+    // REQ-14: return the same representation as GET /orders/:id.
+    return this.get(id);
+  }
 }
