 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 
-/** Coupon administration (create / look up). Applying coupons to orders is not implemented yet. */
+/** Coupon administration (create / look up) and redemption rules. */
 export class CouponService {
   constructor(private readonly coupons: CouponRepository) {}
 
@@ -41,4 +41,32 @@ export class CouponService {
     if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
     return coupon;
   }
+
+  /**
+   * Validates that `code` may be redeemed against an order of `amountCents` at
+   * `now`, and returns the discount in cents without recording the use.
+   */
+  quote(code: string, amountCents: number, now: Date): number {
+    const coupon = this.get(code);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${code} is ${coupon.status}`);
+    const time = now.getTime();
+    if (time < Date.parse(coupon.validFrom)) throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    if (time > Date.parse(coupon.validUntil)) throw conflict("COUPON_EXPIRED", `coupon ${code} has expired`);
+    if (amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT_NOT_MET", `order amount is below the minimum for coupon ${code}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} usage limit reached`);
+    }
+
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    // Never discount more than the order amount: the final amount stays >= 0.
+    return Math.min(capped, amountCents);
+  }
+
+  /** Records one redemption of `code` without re-running the eligibility rules. */
+  markUsed(code: string): void {
+    this.coupons.incrementUsedCount(code);
+  }
 }
