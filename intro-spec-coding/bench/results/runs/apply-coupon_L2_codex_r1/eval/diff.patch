@@ -41,4 +43,40 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is not active`);
+
+    const now = this.clock();
+    const validFrom = Date.parse(coupon.validFrom);
+    const validUntil = Date.parse(coupon.validUntil);
+    if (!Number.isNaN(validFrom) && now.getTime() < validFrom) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (!Number.isNaN(validUntil) && now.getTime() > validUntil) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT", `order amount is below coupon ${code} minimum`);
+    }
+
+    let discountCents =
+      coupon.type === "FIXED" ? coupon.value : Math.round((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discountCents = Math.min(discountCents, coupon.maxDiscountCents);
+    discountCents = Math.max(0, Math.min(discountCents, order.amountCents));
+
+    const finalAmountCents = order.amountCents - discountCents;
+    this.orders.applyCoupon(id, discountCents, finalAmountCents, code);
+    this.coupons.recordRedemption(id, code, discountCents, now.toISOString());
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..fb79cba
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function setup() {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  return app;
+}
+
+function createCoupon(app: ReturnType<typeof createApp>, coupon: Record<string, unknown>) {
+  return app.request("POST", "/coupons", {
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...coupon,
+  });
+}
+
+describe("apply coupon", () => {
+  it("applies a FIXED coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "SAVE5", type: "FIXED", value: 500 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE5" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "SAVE5",
+    });
+    expect(app.request("GET", "/coupons/SAVE5").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a PERCENT coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600 });
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+  });
+
+  it("rejects a disabled coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "OFF", type: "FIXED", value: 100, status: "DISABLED" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OFF" }).status).toBe(400);
+  });
+
+  it("rejects a coupon below the order minimum", () => {
+    const app = setup();
+    createCoupon(app, { code: "BIG", type: "FIXED", value: 100, minAmountCents: 50000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "BIG" }).status).toBe(400);
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = setup();
+    createCoupon(app, { code: "OLD", type: "FIXED", value: 100, validUntil: "2026-06-01T00:00:00Z" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OLD" }).status).toBe(400);
+  });
+
+  it("rejects a missing couponCode", () => {
+    const app = setup();
+    expect(app.request("POST", "/orders/1/apply-coupon", {}).status).toBe(400);
+  });
+});
