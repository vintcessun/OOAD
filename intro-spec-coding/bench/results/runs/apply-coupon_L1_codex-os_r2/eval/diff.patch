+
+  /** Records that an order redeemed a coupon. */
+  recordRedemption(orderId: number, code: string, discountCents: number, createdAt: string): void {
+    this.db
+      .prepare(
+        "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+      )
+      .run(orderId, code, discountCents, createdAt);
+  }
+
+  /** Increments the coupon's redemption counter. */
+  incrementUsedCount(code: string): void {
+    this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(code);
+  }
 }
