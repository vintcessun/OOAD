@@ -41,4 +43,54 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /**
+   * Applies a coupon to a pending order: checks eligibility, computes the
+   * discount, then stores the order change, the redemption and the usage
+   * counter in one transaction.
+   */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already has coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+
+    const now = this.clock();
+    const at = now.getTime();
+    if (coupon.status !== "ACTIVE" || at < Date.parse(coupon.validFrom) || at > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is not active`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("COUPON_MIN_AMOUNT_NOT_MET", `order ${id} is below coupon ${code} minimum`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} usage limit reached`);
+    }
+
+    const discountCents = computeDiscount(order.amountCents, coupon);
+    const finalAmountCents = order.amountCents - discountCents;
+    this.orders.runInTransaction(() => {
+      this.orders.applyDiscount(id, discountCents, finalAmountCents, code);
+      this.coupons.recordRedemption(id, code, discountCents, now.toISOString());
+      this.coupons.incrementUsedCount(code);
+    });
+    return this.get(id);
+  }
+}
+
+/** Fixed coupons discount their face value; percent coupons floor the percentage. */
+function computeDiscount(amountCents: number, coupon: Coupon): number {
+  const raw =
+    coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.max(0, Math.min(capped, amountCents));
 }
diff --git a/tests/apply-coupon.test.ts b/tests/apply-coupon.test.ts
new file mode 100644
index 0000000..8e0a95a
--- /dev/null
+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,214 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const coupon = (app: App, body: Record<string, unknown>) => {
+  const res = app.request("POST", "/coupons", {
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...body,
+  });
+  expect(res.status).toBe(201);
+};
+
+const order = (app: App, amountCents: number) => {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as any).id as number;
+};
+
+const app = () => createApp({ clock: fixedClock });
+
+const errorCode = (res: { body: unknown }) => (res.body as any).error.code;
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a fixed-amount coupon", () => {
+    const a = app();
+    coupon(a, { code: "SAVE20", type: "FIXED", value: 2000 });
+    const id = order(a, 12000);
+
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 2000,
+      finalAmountCents: 10000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+    expect(a.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a percentage coupon", () => {
+    const a = app();
+    coupon(a, { code: "P10", type: "PERCENT", value: 10 });
+    const id = order(a, 10000);
+
+    expect(a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "P10" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 9000,
+    });
+  });
+
+  it("rounds a percentage discount down to whole cents", () => {
+    const a = app();
+    coupon(a, { code: "P15", type: "PERCENT", value: 15 });
+    const id = order(a, 999);
+
+    expect(a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "P15" }).body).toMatchObject({
+      discountCents: 149,
+      finalAmountCents: 850,
+    });
+  });
+
+  it("honours the max discount cap", () => {
+    const a = app();
+    coupon(a, { code: "HALF", type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+    const id = order(a, 10000);
+
+    expect(a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "HALF" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 9000,
+    });
+  });
+
+  it("never discounts more than the order amount", () => {
+    const a = app();
+    coupon(a, { code: "BIG", type: "FIXED", value: 2000 });
+    const id = order(a, 1500);
+
+    expect(a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "BIG" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("rejects a missing couponCode with INVALID_REQUEST", () => {
+    const a = app();
+    const id = order(a, 1000);
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, {});
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+
+  it("rejects an invalid order id", () => {
+    const res = app().request("POST", "/orders/abc/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("INVALID_REQUEST");
+  });
+
+  it("returns ORDER_NOT_FOUND for an unknown order", () => {
+    const res = app().request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown coupon", () => {
+    const a = app();
+    const id = order(a, 1000);
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(404);
+    expect(errorCode(res)).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns ORDER_NOT_PENDING once the order is paid", () => {
+    const a = app();
+    coupon(a, { code: "SAVE20", type: "FIXED", value: 2000 });
+    const id = order(a, 12000);
+    a.request("POST", `/orders/${id}/pay`);
+
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns ORDER_ALREADY_HAS_COUPON for a second coupon", () => {
+    const a = app();
+    coupon(a, { code: "SAVE20", type: "FIXED", value: 2000 });
+    coupon(a, { code: "SAVE10", type: "FIXED", value: 1000 });
+    const id = order(a, 12000);
+    a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE10" });
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("ORDER_ALREADY_HAS_COUPON");
+  });
+
+  it("returns COUPON_NOT_ACTIVE for a disabled coupon", () => {
+    const a = app();
+    coupon(a, { code: "OFF", type: "FIXED", value: 500, status: "DISABLED" });
+    const id = order(a, 10000);
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("returns COUPON_NOT_ACTIVE for an expired coupon", () => {
+    const a = app();
+    coupon(a, {
+      code: "OLD",
+      type: "FIXED",
+      value: 500,
+      validFrom: "2025-01-01T00:00:00Z",
+      validUntil: "2025-12-31T00:00:00Z",
+    });
+    const id = order(a, 10000);
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("returns COUPON_MIN_AMOUNT_NOT_MET below the minimum", () => {
+    const a = app();
+    coupon(a, { code: "MIN", type: "FIXED", value: 500, minAmountCents: 5000 });
+    const id = order(a, 4000);
+    const res = a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "MIN" });
+    expect(res.status).toBe(400);
+    expect(errorCode(res)).toBe("COUPON_MIN_AMOUNT_NOT_MET");
+  });
+
+  it("returns COUPON_USAGE_LIMIT_REACHED when exhausted", () => {
+    const a = app();
+    coupon(a, { code: "ONCE", type: "FIXED", value: 500, usageLimit: 1 });
+    const first = order(a, 10000);
+    a.request("POST", `/orders/${first}/apply-coupon`, { couponCode: "ONCE" });
+    const second = order(a, 10000);
+
+    const res = a.request("POST", `/orders/${second}/apply-coupon`, { couponCode: "ONCE" });
+    expect(res.status).toBe(409);
+    expect(errorCode(res)).toBe("COUPON_USAGE_LIMIT_REACHED");
+  });
+
+  it("records a redemption and increments usage on success", () => {
+    const a = app();
+    coupon(a, { code: "SAVE20", type: "FIXED", value: 2000 });
+    const id = order(a, 12000);
+    a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    const row = a.db
+      .prepare("SELECT order_id, coupon_code, discount_cents FROM coupon_redemptions")
+      .all() as Array<{ order_id: number; coupon_code: string; discount_cents: number }>;
+    expect(row).toEqual([{ order_id: id, coupon_code: "SAVE20", discount_cents: 2000 }]);
+    expect(a.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("records nothing when the application fails", () => {
+    const a = app();
+    coupon(a, {
+      code: "OLD",
+      type: "FIXED",
+      value: 500,
+      validFrom: "2025-01-01T00:00:00Z",
+      validUntil: "2025-12-31T00:00:00Z",
+    });
+    const id = order(a, 10000);
+    a.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OLD" });
+
+    const count = a.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number };
+    expect(count.n).toBe(0);
+    expect(a.request("GET", "/coupons/OLD").body).toMatchObject({ usedCount: 0 });
+    expect(a.request("GET", `/orders/${id}`).body).toMatchObject({ discountCents: 0, couponCode: null });
+  });
+});
