+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function setup(): App {
+  return createApp({ clock: fixedClock });
+}
+
+/** Creates a coupon and asserts it was accepted. */
+function createCoupon(app: App, coupon: Record<string, unknown>): void {
+  const res = app.request("POST", "/coupons", {
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...coupon,
+  });
+  expect(res.status).toBe(201);
+}
+
+function createOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+describe("apply coupon - validation", () => {
+  it("rejects an unknown coupon with 400", () => {
+    const app = setup();
+    const id = createOrder(app, 12000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const app = setup();
+    const id = createOrder(app, 12000);
+    createCoupon(app, { code: "OFF", type: "FIXED", value: 1000, status: "DISABLED" });
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OFF" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = setup();
+    const id = createOrder(app, 12000);
+    createCoupon(app, { code: "OLD", type: "FIXED", value: 1000, validUntil: "2026-09-01T00:00:00Z" });
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "OLD" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a coupon that is not yet valid with 400", () => {
+    const app = setup();
+    const id = createOrder(app, 12000);
+    createCoupon(app, { code: "SOON", type: "FIXED", value: 1000, validFrom: "2026-11-01T00:00:00Z" });
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SOON" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an order below the minimum amount with 400", () => {
+    const app = setup();
