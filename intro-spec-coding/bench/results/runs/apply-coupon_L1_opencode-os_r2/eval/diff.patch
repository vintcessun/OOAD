diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..c7c73af 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,14 @@
 import type { Clock } from "../clock.ts";
+import { withTransaction, type Db } from "../db.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
+    private readonly db: Db,
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +45,53 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCodeInput: unknown): Order {
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already has coupon ${order.couponCode}`);
+    }
+    if (typeof couponCodeInput !== "string" || couponCodeInput.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCodeInput.trim();
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    const nowMs = now.getTime();
+    if (nowMs < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    }
+    if (nowMs > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${code} expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${order.amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${code} usage limit reached`);
+    }
+
+    const discountCents = discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    return withTransaction(this.db, () => {
+      this.orders.applyCoupon(id, code, discountCents, finalAmountCents);
+      this.coupons.recordRedemption(id, code, discountCents, now.toISOString());
+      return this.get(id);
+    });
+  }
+}
+
+function discountFor(coupon: Coupon, amountCents: number): number {
+  let discount = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+  return Math.min(discount, amountCents);
 }
