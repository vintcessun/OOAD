@@ -0,0 +1,149 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const clock = () => new Date("2026-10-01T08:00:00Z");
+const window = { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" };
+
+function setup() {
+  const app = createApp({ clock });
+  const created = app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  expect(created.status).toBe(201);
+  return app;
+}
+
+function coupon(app: ReturnType<typeof createApp>, overrides: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    ...window,
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+describe("apply-coupon", () => {
+  it("applies a percent coupon and records usage", () => {
+    const app = setup();
+    coupon(app);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2400, finalAmountCents: 9600 });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a fixed coupon", () => {
+    const app = setup();
+    coupon(app, { type: "FIXED", value: 500 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 500,
+      finalAmountCents: 11500,
+      couponCode: "SAVE20",
+    });
+  });
+
+  it("never discounts below zero for a fixed coupon larger than the order", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "alice", amountCents: 3000 });
+    coupon(app, { type: "FIXED", value: 5000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 3000, finalAmountCents: 0 });
+  });
+
+  it("floors percentage discounts", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "alice", amountCents: 999 });
+    coupon(app, { value: 15 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 149,
+      finalAmountCents: 850,
+    });
+  });
+
+  it("caps a percentage discount with maxDiscountCents", () => {
+    const app = setup();
+    coupon(app, { value: 50, maxDiscountCents: 1000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1000,
+    });
+  });
+
+  it("rejects a missing couponCode", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", {});
+    expect(res.status).toBe(400);
+    expect(res.body).toEqual({ error: { code: "INVALID_REQUEST", message: expect.any(String) } });
+  });
+
+  it("rejects an unknown order", () => {
+    const app = createApp({ clock });
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const app = setup();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const app = setup();
+    coupon(app, { status: "DISABLED" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const app = setup();
+    coupon(app, { validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("rejects an expired coupon", () => {
+    const app = setup();
+    coupon(app, { validFrom: "2025-01-01T00:00:00Z", validUntil: "2026-01-01T00:00:00Z" });
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects an order below the coupon minimum", () => {
