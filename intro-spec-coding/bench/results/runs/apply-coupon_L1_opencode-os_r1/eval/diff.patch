@@ -0,0 +1,181 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { transaction } from "../src/db.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function createCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  if (res.status !== 201) throw new Error(`coupon setup failed: ${JSON.stringify(res.body)}`);
+}
+
+function createOrder(app: App, amountCents = 12000): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  return (res.body as any).id as number;
+}
+
+describe("apply coupon", () => {
+  it("applies a fixed-amount coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { type: "FIXED", value: 2000 });
+    const id = createOrder(app, 12000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 10000,
+      status: "PENDING",
+    });
+  });
+
+  it("applies a percentage coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { type: "PERCENT", value: 20 });
+    const id = createOrder(app, 12000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600 });
+  });
+
+  it("caps a percentage discount and never exceeds the amount", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app, { type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+    const capped = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${capped}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 9000,
+    });
+
+    createCoupon(app, { code: "BIG", type: "FIXED", value: 5000 });
+    const small = createOrder(app, 3000);
+    expect(app.request("POST", `/orders/${small}/apply-coupon`, { couponCode: "BIG" }).body).toMatchObject({
+      discountCents: 3000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = createApp({ clock: fixedClock });
+    createCoupon(app);
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns 404 for an unknown coupon", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app);
