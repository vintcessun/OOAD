diff --git a/src/db.ts b/src/db.ts
index de673a1..5d0c756 100755
--- a/src/db.ts
+++ b/src/db.ts
@@ -42,3 +42,16 @@ export function openDb(path = ":memory:"): Db {
   db.exec(SCHEMA);
   return db;
 }
+
+/** Runs fn inside a transaction, committing on success and rolling back on any error. */
+export function transaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (e) {
+    db.exec("ROLLBACK");
+    throw e;
+  }
+}
