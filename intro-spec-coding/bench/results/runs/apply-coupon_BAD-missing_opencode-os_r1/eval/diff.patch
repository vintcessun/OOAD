+describe("POST /orders/:id/apply-coupon success", () => {
+  it("applies a percentage discount (AC-01)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow());
+    createOrder(app, 10000);
+
+    const res = applyCoupon(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      customer: "alice",
+      amountCents: 10000,
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("applies a fixed discount (AC-02)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow({ type: "FIXED", value: 1500 }));
+    createOrder(app, 10000);
+
+    const res = applyCoupon(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("caps the discount (AC-03)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow({ maxDiscountCents: 5000 }));
+    createOrder(app, 100000);
+
+    const res = applyCoupon(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("rounds a percentage discount down (AC-05)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow({ value: 15 }));
+    createOrder(app, 999);
+
+    const res = applyCoupon(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.body).toMatchObject({ discountCents: 149, finalAmountCents: 850 });
+  });
+
+  it("allows amount equal to the minimum (AC-06)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow({ minAmountCents: 10000 }));
+    createOrder(app, 10000);
+
+    const res = applyCoupon(app, 1, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("normalizes the coupon code before lookup (AC-10)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow({ code: "SAVE20" }));
+    createOrder(app, 10000);
+
+    const res = applyCoupon(app, 1, { couponCode: " save20 " });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("returns the same body as GET /orders/:id (REQ-14) and records usage (AC-09)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow());
+    createOrder(app, 10000);
+
+    const applied = applyCoupon(app, 1, { couponCode: "SAVE20" });
+    const fetched = app.request("GET", "/orders/1");
+
+    expect(applied.body).toEqual(fetched.body);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(app.db.prepare("SELECT * FROM coupon_redemptions").all()).toHaveLength(1);
+  });
+
+  it("increments usedCount from a previous redemption (AC-09)", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", couponRow());
+    for (let i = 0; i < 2; i++) {
+      createOrder(app, 10000);
+      applyCoupon(app, i + 1, { couponCode: "SAVE20" });
+    }
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 2 });
+    expect(app.db.prepare("SELECT * FROM coupon_redemptions").all()).toHaveLength(2);
+  });
+});
