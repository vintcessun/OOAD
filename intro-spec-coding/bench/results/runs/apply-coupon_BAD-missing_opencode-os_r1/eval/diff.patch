@@ -0,0 +1,357 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const VALID_FROM = "2026-01-01T00:00:00Z";
+const VALID_UNTIL = "2027-01-01T00:00:00Z";
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const couponRow = (overrides: Record<string, unknown> = {}) => ({
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: VALID_FROM,
+  validUntil: VALID_UNTIL,
+  ...overrides,
+});
+
+const errorCode = (body: unknown) => (body as any).error.code;
+
+function createOrder(app: ReturnType<typeof createApp>, amountCents: number) {
+  return app.request("POST", "/orders", { customer: "alice", amountCents });
+}
+
+function applyCoupon(app: ReturnType<typeof createApp>, id: number, body: unknown) {
+  return app.request("POST", `/orders/${id}/apply-coupon`, body);
+}
+
+describe("CouponRedemptionRepository.redeem", () => {
+  it("writes the order, the redemption row, and used_count atomically", () => {
+    const db = openDb();
+    const coupons = new CouponRepository(db);
+    const orders = new OrderRepository(db);
+    coupons.insert({
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      minAmountCents: 0,
+      maxDiscountCents: null,
+      validFrom: VALID_FROM,
+      validUntil: VALID_UNTIL,
+      status: "ACTIVE",
+      usageLimit: null,
+    });
+    const order = orders.insert("alice", 10000, "2026-10-01T00:00:00.000Z");
+
+    new CouponRedemptionRepository(db).redeem({
+      orderId: order.id,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      createdAt: "2026-10-01T08:00:00.000Z",
+    });
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(coupons.findByCode("SAVE20")?.usedCount).toBe(1);
+    expect(db.prepare("SELECT * FROM coupon_redemptions").all()).toHaveLength(1);
+  });
+
+  it("rolls back the order update when the redemption insert fails", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const order = orders.insert("bob", 5000, "2026-10-01T00:00:00.000Z");
+
+    expect(() =>
+      new CouponRedemptionRepository(db).redeem({
+        orderId: order.id,
+        couponCode: "NOPE",
+        discountCents: 100,
+        finalAmountCents: 4900,
+        createdAt: "2026-10-01T08:00:00.000Z",
+      }),
+    ).toThrow();
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 5000,
+      couponCode: null,
+    });
+    expect(db.prepare("SELECT * FROM coupon_redemptions").all()).toHaveLength(0);
+  });
+});
