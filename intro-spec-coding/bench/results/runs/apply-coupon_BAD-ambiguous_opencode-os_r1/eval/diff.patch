@@ -41,4 +43,41 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim().toUpperCase();
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null)
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is not active`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom))
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not yet valid`);
+    if (now.getTime() >= Date.parse(coupon.validUntil))
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit)
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    if (order.amountCents < coupon.minAmountCents)
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below coupon minimum`);
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.round((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.max(0, Math.min(discount, order.amountCents));
+    const finalAmountCents = order.amountCents - discount;
+
+    this.orders.applyCoupon(id, code, discount, finalAmountCents, now.toISOString());
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..683c98c
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,215 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00.000Z";
+const fixedClock = () => new Date(NOW);
+
+interface CouponInput {
+  code: string;
+  type?: "FIXED" | "PERCENT";
+  value?: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function setup(clock: () => Date = fixedClock): { app: App; seed: (c: CouponInput, amountCents: number) => number } {
+  const app = createApp({ clock });
+  return {
+    app,
+    seed(coupon, amountCents) {
+      const res = app.request("POST", "/coupons", {
+        validFrom: "2026-01-01T00:00:00Z",
+        validUntil: "2027-01-01T00:00:00Z",
+        ...coupon,
+      });
+      if (res.status !== 201) throw new Error(`failed to seed coupon: ${JSON.stringify(res.body)}`);
+      const order = app.request("POST", "/orders", { customer: "alice", amountCents });
+      if (order.status !== 201) throw new Error(`failed to seed order: ${JSON.stringify(order.body)}`);
+      return (order.body as { id: number }).id;
+    },
+  };
+}
+
+const apply = (app: App, id: number, body: unknown) => app.request("POST", `/orders/${id}/apply-coupon`, body);
+
+describe("apply coupon", () => {
+  it("AC-01: applies a percent coupon", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "SAVE20", type: "PERCENT", value: 20 }, 10000);
+    const res = apply(app, id, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02: applies a fixed coupon", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "FIXED15", type: "FIXED", value: 1500 }, 10000);
+    const res = apply(app, id, { couponCode: "FIXED15" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: caps a large percent discount", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "BIGPERCENT", type: "PERCENT", value: 50, maxDiscountCents: 10000 }, 1_000_000);
+    const res = apply(app, id, { couponCode: "BIGPERCENT" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 10000, finalAmountCents: 990000 });
+  });
+
+  it("AC-04: never discounts below zero", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "TOOBIG", type: "FIXED", value: 3000 }, 1000);
+    const res = apply(app, id, { couponCode: "TOOBIG" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-06: allows amount equal to the minimum", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "MIN1000", type: "FIXED", value: 100, minAmountCents: 1000 }, 1000);
+    expect(apply(app, id, { couponCode: "MIN1000" }).status).toBe(200);
+  });
+
+  it("AC-07: expires exactly at validUntil and is valid exactly at validFrom", () => {
+    const atBoundary = () => new Date("2026-06-01T00:00:00.000Z");
+    const { app, seed } = setup(atBoundary);
+    const expired = seed({ code: "EXPIRED", type: "FIXED", value: 100, validUntil: "2026-06-01T00:00:00Z" }, 10000);
+    expect(apply(app, expired, { couponCode: "EXPIRED" })).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_EXPIRED" } },
+    });
+    const fresh = seed({ code: "FRESH", type: "FIXED", value: 100, validFrom: "2026-06-01T00:00:00Z" }, 10000);
+    expect(apply(app, fresh, { couponCode: "FRESH" }).status).toBe(200);
+  });
+
+  it("AC-08: rejects a second application and leaves the order unchanged", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "ONCE", type: "FIXED", value: 500 }, 10000);
+    expect(apply(app, id, { couponCode: "ONCE" }).status).toBe(200);
+    const before = app.request("GET", `/orders/${id}`).body;
+    const second = apply(app, id, { couponCode: "ONCE" });
+    expect(second).toMatchObject({ status: 409, body: { error: { code: "COUPON_ALREADY_APPLIED" } } });
+    expect(app.request("GET", `/orders/${id}`).body).toEqual(before);
+  });
+
+  it("AC-09: increments usedCount and records a redemption row", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "TRACK", type: "FIXED", value: 500 }, 10000);
+    expect(apply(app, id, { couponCode: "TRACK" }).status).toBe(200);
+    expect(app.request("GET", "/coupons/TRACK").body).toMatchObject({ usedCount: 1 });
+    const row = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .get() as any;
+    expect(row).toEqual({ order_id: id, coupon_code: "TRACK", discount_cents: 500, created_at: NOW });
+  });
+
+  it("AC-10: normalizes whitespace and case", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "SAVE20", type: "PERCENT", value: 20 }, 10000);
+    const res = apply(app, id, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2000 });
+  });
+
+  it("returns the same body as GET /orders/:id", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "SAME", type: "FIXED", value: 100 }, 5000);
+    const applied = apply(app, id, { couponCode: "SAME" });
+    expect(applied.body).toEqual(app.request("GET", `/orders/${id}`).body);
+  });
+
+  it.each([
+    ["missing", {}],
+    ["non-string", { couponCode: 123 }],
+    ["blank", { couponCode: "   " }],
+  ])("rejects an invalid body (%s)", (_label, body) => {
+    const { app, seed } = setup();
+    const id = seed({ code: "ANY", type: "FIXED", value: 100 }, 1000);
+    expect(apply(app, id, body)).toMatchObject({ status: 400, body: { error: { code: "INVALID_REQUEST" } } });
+  });
+
+  it("checks invalid request before the order is looked up", () => {
+    const { app } = setup();
+    expect(apply(app, 999, {})).toMatchObject({ status: 400, body: { error: { code: "INVALID_REQUEST" } } });
+  });
+
+  it("returns ORDER_NOT_FOUND before coupon lookup", () => {
+    const { app } = setup();
+    expect(apply(app, 999, { couponCode: "GHOST" })).toMatchObject({
+      status: 404,
+      body: { error: { code: "ORDER_NOT_FOUND" } },
+    });
+  });
+
+  it("rejects a non-pending order", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "PAID", type: "FIXED", value: 100 }, 5000);
+    app.request("POST", `/orders/${id}/pay`);
+    expect(apply(app, id, { couponCode: "PAID" })).toMatchObject({
+      status: 409,
+      body: { error: { code: "ORDER_NOT_PENDING" } },
+    });
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown coupon", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "KNOWN", type: "FIXED", value: 100 }, 5000);
+    expect(apply(app, id, { couponCode: "GHOST" })).toMatchObject({
+      status: 404,
+      body: { error: { code: "COUPON_NOT_FOUND" } },
+    });
+  });
+
+  it("rejects an inactive coupon", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "OFF", type: "FIXED", value: 100, status: "DISABLED" }, 5000);
+    expect(apply(app, id, { couponCode: "OFF" })).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_INACTIVE" } },
+    });
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "FUTURE", type: "FIXED", value: 100, validFrom: "2027-01-01T00:00:00Z" }, 5000);
+    expect(apply(app, id, { couponCode: "FUTURE" })).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_NOT_YET_VALID" } },
+    });
+  });
+
+  it("rejects an exhausted usage limit", () => {
+    const { app, seed } = setup();
+    const first = seed({ code: "LIMITED", type: "FIXED", value: 100, usageLimit: 1 }, 5000);
+    const second = seed({ code: "OTHER", type: "FIXED", value: 100 }, 5000);
+    expect(apply(app, first, { couponCode: "LIMITED" }).status).toBe(200);
+    expect(apply(app, second, { couponCode: "LIMITED" })).toMatchObject({
+      status: 400,
+      body: { error: { code: "COUPON_USAGE_EXHAUSTED" } },
+    });
+  });
+
+  it("rejects when the minimum amount is not met", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "BIGMIN", type: "FIXED", value: 100, minAmountCents: 10000 }, 5000);
+    expect(apply(app, id, { couponCode: "BIGMIN" })).toMatchObject({
+      status: 400,
+      body: { error: { code: "MINIMUM_NOT_MET" } },
+    });
+  });
+
+  it("leaves the database unchanged when rejected", () => {
+    const { app, seed } = setup();
+    const id = seed({ code: "EXPIRED", type: "FIXED", value: 100, validUntil: "2026-01-02T00:00:00Z" }, 5000);
+    const before = app.request("GET", `/orders/${id}`).body;
+    expect(apply(app, id, { couponCode: "EXPIRED" }).status).toBe(400);
+    expect(app.request("GET", `/orders/${id}`).body).toEqual(before);
+    expect(app.request("GET", "/coupons/EXPIRED").body).toMatchObject({ usedCount: 0 });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 0 });
+  });
+});
