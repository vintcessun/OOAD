diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..237190c 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,45 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Redeems one coupon on a pending order. Rules are checked in the documented error order. */
+  applyCoupon(id: number, body: { couponCode?: unknown }): Order {
+    const raw = body?.couponCode;
+    if (typeof raw !== "string") throw badRequest("INVALID_REQUEST", "couponCode is required");
+    const code = raw.trim().toUpperCase();
+    if (code === "") throw badRequest("INVALID_REQUEST", "couponCode is required");
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used a coupon`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} reached its usage limit`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order ${id} is below the coupon minimum`);
+    }
+
+    const discount = this.discountFor(order, coupon);
+    this.orders.applyCoupon(id, code, discount, order.amountCents - discount, now.toISOString());
+    return this.get(id);
+  }
+
+  private discountFor(order: Order, coupon: Coupon): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.round((order.amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents !== null ? Math.min(raw, coupon.maxDiscountCents) : raw;
+    return Math.min(capped, order.amountCents);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..38ea27f
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,214 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const nowMs = Date.parse(NOW);
+const fixedClock = () => new Date(nowMs);
+
+const baseCoupon = {
+  code: "SAVE20",
+  type: "PERCENT",
+  value: 20,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+function makeApp(coupon: Record<string, unknown> = {}, amountCents = 10000, clock = fixedClock): App {
+  const app = createApp({ clock });
+  const created = app.request("POST", "/coupons", { ...baseCoupon, ...coupon });
+  expect(created.status).toBe(201);
+  const order = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(order.status).toBe(201);
+  return app;
+}
+
+const apply = (app: App, couponCode: unknown = "SAVE20", id = 1) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, { couponCode });
+
+const redemptionCount = (app: App): number =>
+  (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number }).n;
+
+describe("apply coupon - success", () => {
+  it("AC-01 applies a 20% coupon to a 10000 order", () => {
+    const app = makeApp();
+    const res = apply(app);
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ amountCents: 10000, discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02 applies a fixed 1500 coupon", () => {
+    const app = makeApp({ type: "FIXED", value: 1500 });
+    const res = apply(app);
+    expect((res.body as any).discountCents).toBe(1500);
+    expect((res.body as any).finalAmountCents).toBe(8500);
+  });
+
+  it("AC-03 caps a percent coupon on a large order", () => {
+    const app = makeApp({ type: "PERCENT", value: 50, maxDiscountCents: 5000 }, 100000);
+    const res = apply(app);
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 95000 });
+  });
+
+  it("AC-08 applies the max discount cap to a fixed coupon too", () => {
+    const app = makeApp({ type: "FIXED", value: 5000, maxDiscountCents: 1000 }, 100000);
+    expect((apply(app).body as any).discountCents).toBe(1000);
+  });
+
+  it("AC-04 clamps a fixed discount larger than the order amount", () => {
+    const app = makeApp({ type: "FIXED", value: 3000 }, 1000);
+    const res = apply(app);
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-06 accepts an order exactly at the minimum amount", () => {
+    const app = makeApp({ type: "FIXED", value: 100, minAmountCents: 10000 }, 10000);
+    expect(apply(app).status).toBe(200);
+  });
+
+  it("AC-07 accepts now equal to validFrom", () => {
+    const app = makeApp({ validFrom: NOW });
+    expect(apply(app).status).toBe(200);
+  });
+
+  it("AC-10 normalizes whitespace and case", () => {
+    const app = makeApp();
+    const res = apply(app, " save20 ");
+    expect(res.status).toBe(200);
+    expect((res.body as any).couponCode).toBe("SAVE20");
+  });
+
+  it("leaves the order status PENDING", () => {
+    const app = makeApp();
+    expect((apply(app).body as any).status).toBe("PENDING");
+  });
+
+  it("AC-14 returns the same body as a subsequent GET", () => {
+    const app = makeApp();
+    const res = apply(app);
+    const get = app.request("GET", "/orders/1");
+    expect(get.status).toBe(200);
+    expect(res.body).toEqual(get.body);
+  });
+});
+
+describe("apply coupon - errors", () => {
+  const errorCase = (body: unknown, status: number, code: string, app = makeApp(), id = 1) => {
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, body as any);
+    expect(res.status).toBe(status);
+    expect((res.body as any).error.code).toBe(code);
+    return res;
+  };
+
+  it("rejects a missing, non-string or blank couponCode", () => {
+    errorCase({}, 400, "INVALID_REQUEST");
+    errorCase({ couponCode: 123 }, 400, "INVALID_REQUEST");
+    errorCase({ couponCode: "   " }, 400, "INVALID_REQUEST");
+  });
+
+  it("returns ORDER_NOT_FOUND for an unknown order", () => {
+    errorCase({ couponCode: "SAVE20" }, 404, "ORDER_NOT_FOUND", makeApp(), 99);
+  });
+
+  it("rejects a PAID order", () => {
+    const app = makeApp();
+    app.request("POST", "/orders/1/pay");
+    errorCase({ couponCode: "SAVE20" }, 409, "ORDER_NOT_PENDING", app);
+  });
+
+  it("rejects a CANCELLED order", () => {
+    const app = makeApp();
+    app.request("POST", "/orders/1/cancel");
+    errorCase({ couponCode: "SAVE20" }, 409, "ORDER_NOT_PENDING", app);
+  });
+
+  it("AC-08 rejects a second coupon on the same order and keeps amounts", () => {
+    const app = makeApp();
+    app.request("POST", "/coupons", { ...baseCoupon, code: "EXTRA10", type: "FIXED", value: 1000 });
+    expect(apply(app).status).toBe(200);
+    errorCase({ couponCode: "EXTRA10" }, 409, "COUPON_ALREADY_APPLIED", app);
+    expect(app.request("GET", "/orders/1").body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("rejects the same coupon twice", () => {
+    const app = makeApp();
+    expect(apply(app).status).toBe(200);
+    errorCase({ couponCode: "SAVE20" }, 409, "COUPON_ALREADY_APPLIED", app);
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown code", () => {
+    errorCase({ couponCode: "NOPE" }, 404, "COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    errorCase({ couponCode: "SAVE20" }, 400, "COUPON_INACTIVE", makeApp({ status: "DISABLED" }));
+  });
+
+  it("rejects a coupon that is not yet valid", () => {
+    errorCase({ couponCode: "SAVE20" }, 400, "COUPON_NOT_YET_VALID", makeApp({ validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" }));
+  });
+
+  it("AC-07 rejects now equal to validUntil", () => {
+    errorCase({ couponCode: "SAVE20" }, 400, "COUPON_EXPIRED", makeApp({ validFrom: "2026-01-01T00:00:00Z", validUntil: NOW }));
+  });
+
+  it("rejects an exhausted usage limit", () => {
+    const app = makeApp({ usageLimit: 1 });
+    app.request("POST", "/orders", { customer: "bob", amountCents: 10000 });
+    expect(apply(app, "SAVE20", 1).status).toBe(200);
+    errorCase({ couponCode: "SAVE20" }, 400, "COUPON_USAGE_EXHAUSTED", app, 2);
+  });
+
+  it("rejects an order below the coupon minimum", () => {
+    errorCase({ couponCode: "SAVE20" }, 400, "MINIMUM_NOT_MET", makeApp({ minAmountCents: 10001 }, 10000));
+  });
+
+  it("evaluates higher-priority rules first", () => {
+    const app = makeApp();
+    app.request("POST", "/orders/1/pay");
+    errorCase({ couponCode: "NOPE" }, 409, "ORDER_NOT_PENDING", app);
+    errorCase({ couponCode: "NOPE" }, 404, "ORDER_NOT_FOUND", makeApp(), 99);
+  });
+});
+
+describe("apply coupon - side effects", () => {
+  it("AC-09 increments usedCount and records exactly one redemption", () => {
+    const app = makeApp();
+    expect(redemptionCount(app)).toBe(0);
+    apply(app);
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(1);
+    expect(redemptionCount(app)).toBe(1);
+    const row = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .get() as any;
+    expect(row).toEqual({ order_id: 1, coupon_code: "SAVE20", discount_cents: 2000, created_at: new Date(nowMs).toISOString() });
+  });
+
+  it("changes nothing when a request is rejected", () => {
+    const app = makeApp({ minAmountCents: 10001 }, 10000);
+    const before = app.request("GET", "/orders/1").body;
+    const res = apply(app);
+    expect(res.status).toBe(400);
+    expect(app.request("GET", "/orders/1").body).toEqual(before);
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(0);
+    expect(redemptionCount(app)).toBe(0);
+  });
+});
+
+describe("OrderRepository.applyCoupon transaction", () => {
+  it("rolls back the order update when a later step fails", () => {
+    const db = openDb();
+    const repo = new OrderRepository(db);
+    const order = repo.insert("alice", 10000, NOW);
+
+    // "NOPE" violates the coupon_redemptions -> coupons foreign key after the order update ran.
+    expect(() => repo.applyCoupon(order.id, "NOPE", 100, 9900, NOW)).toThrow();
+
+    const after = repo.findById(order.id)!;
+    expect(after.discountCents).toBe(0);
+    expect(after.finalAmountCents).toBe(10000);
+    expect(after.couponCode).toBeNull();
+    expect((db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as { n: number }).n).toBe(0);
+  });
+});
