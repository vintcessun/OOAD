@@ -1,11 +1,15 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import type { Transaction } from "../repositories/transaction.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
+    private readonly transaction: Transaction,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +45,50 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order, lowering the amount due. */
+  applyCoupon(id: number, rawCode: unknown): Order {
+    if (typeof rawCode !== "string" || rawCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = rawCode.trim().toUpperCase();
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used a coupon`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    const at = now.getTime();
+    if (at < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (at >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} has no uses left`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below ${coupon.minAmountCents}`);
+    }
+
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((order.amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    discount = Math.min(discount, order.amountCents);
+    const finalAmountCents = order.amountCents - discount;
+
+    this.transaction(() => {
+      this.orders.applyCoupon(id, discount, finalAmountCents, code);
+      this.coupons.insertRedemption(id, code, discount, now.toISOString());
+      this.coupons.incrementUsedCount(code);
+    });
+
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..f363597
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,205 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW = "2026-10-01T08:00:00Z";
+const fixedClock = () => new Date(NOW);
+
+interface CouponInput {
+  code?: string;
+  type?: "FIXED" | "PERCENT";
+  value?: number;
+  minAmountCents?: number;
+  maxDiscountCents?: number | null;
+  validFrom?: string;
+  validUntil?: string;
+  status?: "ACTIVE" | "DISABLED";
+  usageLimit?: number | null;
+}
+
+function setup(amountCents: number, coupon: CouponInput = {}): { app: App; orderId: number } {
+  const app = createApp({ clock: fixedClock });
+  const order = app.request("POST", "/orders", { customer: "alice", amountCents });
+  const created = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...coupon,
+  });
+  if (created.status !== 201) throw new Error(`coupon setup failed: ${JSON.stringify(created.body)}`);
+  return { app, orderId: (order.body as any).id };
+}
+
+const apply = (app: App, orderId: number, body: unknown) =>
+  app.request("POST", `/orders/${orderId}/apply-coupon`, body);
+
+describe("apply coupon — amounts", () => {
+  it("AC-01 percent discount", () => {
+    const { app, orderId } = setup(10000);
+    const res = apply(app, orderId, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02 fixed discount", () => {
+    const { app, orderId } = setup(10000, { type: "FIXED", value: 1500 });
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 8500,
+    });
+  });
+
+  it("AC-03 percent capped by maxDiscountCents", () => {
+    const { app, orderId } = setup(100000, { maxDiscountCents: 5000 });
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 5000,
+      finalAmountCents: 95000,
+    });
+  });
+
+  it("AC-04 discount never exceeds the order amount", () => {
+    const { app, orderId } = setup(1000, { type: "FIXED", value: 3000 });
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("AC-05 percent floors the discount", () => {
+    const { app, orderId } = setup(999, { value: 15 });
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).body).toMatchObject({ discountCents: 149 });
+  });
+
+  it("AC-06 minimum amount is inclusive", () => {
+    const { app, orderId } = setup(5000, { type: "FIXED", value: 100, minAmountCents: 5000 });
+    const res = apply(app, orderId, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 100 });
+  });
+
+  it("AC-10 trims and uppercases the coupon code", () => {
+    const { app, orderId } = setup(10000);
+    const res = apply(app, orderId, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+});
+
+describe("apply coupon — validity window", () => {
+  it("AC-07 accepts now == validFrom", () => {
+    const { app, orderId } = setup(10000, { validFrom: NOW });
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("AC-07 rejects now == validUntil", () => {
+    const { app, orderId } = setup(10000, { validUntil: NOW });
+    const res = apply(app, orderId, { couponCode: "SAVE20" });
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects before validFrom", () => {
+    const { app, orderId } = setup(10000, { validFrom: "2026-12-01T00:00:00Z" });
+    expect((apply(app, orderId, { couponCode: "SAVE20" }).body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+});
+
+describe("apply coupon — idempotency and side effects", () => {
+  it("AC-08 a second coupon on the same order is rejected and changes nothing", () => {
+    const { app, orderId } = setup(10000);
+    apply(app, orderId, { couponCode: "SAVE20" });
+    const res = apply(app, orderId, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000 });
+  });
+
+  it("AC-09 increments usedCount and records a redemption", () => {
+    const { app, orderId } = setup(10000);
+    apply(app, orderId, { couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db
+      .prepare("SELECT order_id, coupon_code, discount_cents, created_at FROM coupon_redemptions")
+      .all() as any[];
+    expect(rows).toEqual([
+      { order_id: orderId, coupon_code: "SAVE20", discount_cents: 2000, created_at: "2026-10-01T08:00:00.000Z" },
+    ]);
+  });
+
+  it("REQ-14 response equals the subsequent GET", () => {
+    const { app, orderId } = setup(10000);
+    const res = apply(app, orderId, { couponCode: "SAVE20" });
+    expect(res.body).toEqual(app.request("GET", `/orders/${orderId}`).body);
+  });
+
+  it("keeps the order status PENDING", () => {
+    const { app, orderId } = setup(10000);
+    expect(apply(app, orderId, { couponCode: "SAVE20" }).body).toMatchObject({ status: "PENDING" });
+  });
+});
+
+describe("apply coupon — rejections", () => {
+  const expectError = (app: App, orderId: number, body: unknown, status: number, code: string) => {
+    const res = apply(app, orderId, body);
+    expect(res.status).toBe(status);
+    expect(res.body).toEqual({ error: { code, message: expect.any(String) } });
+  };
+
+  it("REQ-13 rejects a missing / blank / non-string code", () => {
+    const { app, orderId } = setup(10000);
+    expectError(app, orderId, {}, 400, "INVALID_REQUEST");
+    expectError(app, orderId, { couponCode: "   " }, 400, "INVALID_REQUEST");
+    expectError(app, orderId, { couponCode: 123 }, 400, "INVALID_REQUEST");
+  });
+
+  it("rejects an unknown order", () => {
+    const { app } = setup(10000);
+    expectError(app, 999, { couponCode: "SAVE20" }, 404, "ORDER_NOT_FOUND");
+  });
+
+  it("rejects a non-pending order", () => {
+    const { app, orderId } = setup(10000);
+    app.request("POST", `/orders/${orderId}/pay`);
+    expectError(app, orderId, { couponCode: "SAVE20" }, 409, "ORDER_NOT_PENDING");
+  });
+
+  it("rejects an unknown coupon", () => {
+    const { app, orderId } = setup(10000);
+    expectError(app, orderId, { couponCode: "NOPE" }, 404, "COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon", () => {
+    const { app, orderId } = setup(10000, { status: "DISABLED" });
+    expectError(app, orderId, { couponCode: "SAVE20" }, 400, "COUPON_INACTIVE");
+  });
+
+  it("rejects an exhausted coupon", () => {
+    const { app, orderId } = setup(10000, { usageLimit: 0 });
+    expectError(app, orderId, { couponCode: "SAVE20" }, 400, "COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("rejects an order below the minimum", () => {
+    const { app, orderId } = setup(10000, { minAmountCents: 10001 });
+    expectError(app, orderId, { couponCode: "SAVE20" }, 400, "MINIMUM_NOT_MET");
+  });
+
+  it("leaves the database untouched on rejection", () => {
+    const { app, orderId } = setup(10000, { minAmountCents: 10001 });
+    apply(app, orderId, { couponCode: "SAVE20" });
+    expect(app.request("GET", `/orders/${orderId}`).body).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 0 });
+    expect(app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 0 });
+  });
+
+  it("enforces the error precedence (order checks before coupon checks)", () => {
+    const { app, orderId } = setup(10000, { status: "DISABLED" });
+    app.request("POST", `/orders/${orderId}/cancel`);
+    // order not pending wins over coupon inactive
+    expectError(app, orderId, { couponCode: "SAVE20" }, 409, "ORDER_NOT_PENDING");
+  });
+});
