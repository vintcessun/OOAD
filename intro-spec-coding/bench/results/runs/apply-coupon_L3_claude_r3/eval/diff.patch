new file mode 100644
index 0000000..f1ef238
--- /dev/null
+++ b/src/repositories/transaction.ts
@@ -0,0 +1,18 @@
+import type { Db } from "../db.ts";
+
+/** Runs `fn` inside one SQLite transaction, rolling back if it throws. */
+export type Transaction = <T>(fn: () => T) => T;
+
+export function transactionRunner(db: Db): Transaction {
+  return <T>(fn: () => T): T => {
+    db.exec("BEGIN");
+    try {
+      const result = fn();
+      db.exec("COMMIT");
+      return result;
+    } catch (error) {
+      db.exec("ROLLBACK");
+      throw error;
+    }
+  };
+}
