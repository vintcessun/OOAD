+import { beforeEach, describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const NOW_ISO = "2026-10-01T08:00:00.000Z";
+const fixedClock = () => new Date(NOW_ISO);
+
+let app: App;
+
+beforeEach(() => {
+  app = createApp({ clock: fixedClock });
+});
+
+function makeOrder(amountCents: number, customer = "alice"): any {
+  const res = app.request("POST", "/orders", { customer, amountCents });
+  if (res.status !== 201) throw new Error(`order create failed: ${JSON.stringify(res.body)}`);
+  return res.body;
+}
+
+function makeCoupon(overrides: Record<string, unknown> = {}): any {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  if (res.status !== 201) throw new Error(`coupon create failed: ${JSON.stringify(res.body)}`);
+  return res.body;
+}
+
+const apply = (id: number, couponCode: unknown) =>
+  app.request("POST", `/orders/${id}/apply-coupon`, { couponCode });
+
+describe("apply coupon - success", () => {
+  it("AC-01: percent coupon reduces the payable amount", () => {
+    makeOrder(10000);
+    makeCoupon({ type: "PERCENT", value: 20 });
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      amountCents: 10000,
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("AC-02: fixed coupon subtracts its value", () => {
+    makeOrder(10000);
+    makeCoupon({ type: "FIXED", value: 1500 });
+    const res = apply(1, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 8500 });
+  });
+
+  it("AC-03: a large order with a capped percent coupon is bounded by the cap", () => {
+    makeOrder(1_000_000);
+    makeCoupon({ type: "PERCENT", value: 50, maxDiscountCents: 5000 });
+    const res = apply(1, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 995_000 });
+  });
+
+  it("AC-04: the discount never exceeds the order amount", () => {
+    makeOrder(1000);
+    makeCoupon({ type: "FIXED", value: 3000 });
+    const res = apply(1, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 0 });
+  });
+
+  it("AC-06: applying exactly at the minimum amount succeeds", () => {
+    makeOrder(5000);
+    makeCoupon({ type: "FIXED", value: 500, minAmountCents: 5000 });
+    expect(apply(1, "SAVE20").status).toBe(200);
+  });
+
+  it("AC-07: now == validFrom is valid, now == validUntil is expired", () => {
+    makeOrder(10000, "alice");
+    makeCoupon({ code: "START", validFrom: NOW_ISO, validUntil: "2027-01-01T00:00:00Z" });
+    expect(apply(1, "START").status).toBe(200);
+
+    makeOrder(10000, "bob");
+    makeCoupon({ code: "END", validFrom: "2026-01-01T00:00:00Z", validUntil: NOW_ISO });
+    const res = apply(2, "END");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+  });
+
+  it("AC-10: a padded, lower-case code matches the stored code", () => {
+    makeOrder(10000);
+    makeCoupon({ code: "SAVE20" });
+    const res = apply(1, " save20 ");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("AC-14: the response equals a following GET /orders/:id", () => {
+    makeOrder(10000);
+    makeCoupon();
+    const applied = apply(1, "SAVE20");
+    const fetched = app.request("GET", "/orders/1");
+    expect(applied.body).toEqual(fetched.body);
+  });
+});
+
+describe("apply coupon - accounting", () => {
+  it("AC-09: increments usedCount and inserts one redemption row", () => {
+    makeOrder(10000);
+    makeCoupon();
+    apply(1, "SAVE20");
+
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(1);
+    const rows = app.db
+      .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ?")
+      .all(1) as any[];
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      order_id: 1,
+      coupon_code: "SAVE20",
+      discount_cents: 2000,
+      created_at: NOW_ISO,
+    });
+  });
+
+  it("AC-08: a second application is rejected and changes nothing", () => {
+    makeOrder(10000);
+    makeCoupon();
+    apply(1, "SAVE20");
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(1);
+  });
+});
+
+describe("apply coupon - rejections", () => {
+  it("REQ-13: missing, non-string and blank codes are INVALID_REQUEST", () => {
+    makeOrder(10000);
+    makeCoupon();
+    expect(app.request("POST", "/orders/1/apply-coupon", {}).status).toBe(400);
+    expect(apply(1, 123).status).toBe(400);
+    const blank = apply(1, "   ");
+    expect(blank.status).toBe(400);
+    expect((blank.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("returns ORDER_NOT_FOUND for an unknown order", () => {
+    makeCoupon();
+    const res = apply(99, "SAVE20");
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+
+  it("returns ORDER_NOT_PENDING for a paid order", () => {
+    makeOrder(10000);
+    makeCoupon();
+    app.request("POST", "/orders/1/pay");
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_PENDING");
+  });
+
+  it("returns COUPON_NOT_FOUND for an unknown coupon", () => {
+    makeOrder(10000);
+    const res = apply(1, "NOPE");
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("returns COUPON_INACTIVE for a disabled coupon", () => {
+    makeOrder(10000);
+    makeCoupon({ status: "DISABLED" });
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_INACTIVE");
+  });
+
+  it("returns COUPON_NOT_YET_VALID before validFrom", () => {
+    makeOrder(10000);
+    makeCoupon({ validFrom: "2027-01-01T00:00:00Z", validUntil: "2028-01-01T00:00:00Z" });
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("returns COUPON_USAGE_EXHAUSTED when the limit is reached", () => {
+    makeOrder(10000);
+    makeCoupon({ usageLimit: 1 });
+    app.db.prepare("UPDATE coupons SET used_count = 1 WHERE code = ?").run("SAVE20");
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_USAGE_EXHAUSTED");
+  });
+
+  it("returns MINIMUM_NOT_MET below the coupon minimum", () => {
+    makeOrder(1000);
+    makeCoupon({ minAmountCents: 5000 });
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("MINIMUM_NOT_MET");
+  });
+
+  it("checks body validity before order state", () => {
+    makeOrder(10000);
+    makeCoupon();
+    app.request("POST", "/orders/1/pay");
+    const res = app.request("POST", "/orders/1/apply-coupon", {});
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("checks already-applied before coupon lookup", () => {
+    makeOrder(10000);
+    makeCoupon();
+    apply(1, "SAVE20");
+    const res = apply(1, "DOESNOTEXIST");
+    expect(res.status).toBe(409);
+    expect((res.body as any).error.code).toBe("COUPON_ALREADY_APPLIED");
+  });
+
+  it("leaves every record unchanged for a rejected request", () => {
+    makeOrder(10000);
+    makeCoupon({ minAmountCents: 50000 });
+    const before = app.request("GET", "/orders/1").body;
+    const res = apply(1, "SAVE20");
+    expect(res.status).toBe(400);
+    expect(app.request("GET", "/orders/1").body).toEqual(before);
+    expect((app.request("GET", "/coupons/SAVE20").body as any).usedCount).toBe(0);
+    expect(
+      (app.db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get() as any).n,
+    ).toBe(0);
+  });
+});
