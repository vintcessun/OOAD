diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..77fde1f 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,24 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
+/** Hard ceiling on the discount a single order can receive, in cents (100 yuan). */
+const MAX_DISCOUNT_CENTS = 10000;
+
+/** REQ-06..REQ-09: discount from coupon type, capped by the coupon, the ceiling and the amount. */
+function computeDiscount(amountCents: number, coupon: Coupon): number {
+  let discount = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+  discount = Math.min(discount, MAX_DISCOUNT_CENTS);
+  discount = Math.min(discount, amountCents);
+  return discount;
+}
+
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +55,42 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** REQ-01..REQ-14: checks run in the exact order of the TASK.md section 6 table. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim().toUpperCase();
+
+    const order = this.orders.findById(id);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${id} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    const nowMs = now.getTime();
+    if (nowMs < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (nowMs >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} has reached its usage limit`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order ${id} is below the coupon minimum`);
+    }
+
+    const discountCents = computeDiscount(order.amountCents, coupon);
+    this.orders.applyCoupon(id, code, discountCents, order.amountCents - discountCents, now.toISOString());
+    return this.get(id);
+  }
 }
diff --git a/tests/applyCoupon.test.ts b/tests/applyCoupon.test.ts
new file mode 100644
index 0000000..fdf09a8
--- /dev/null
+++ b/tests/applyCoupon.test.ts
@@ -0,0 +1,327 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const VALID_FROM = "2026-01-01T00:00:00Z";
+const VALID_UNTIL = "2027-01-01T00:00:00Z";
+
+function seedCoupon(app: App, overrides: Record<string, unknown> = {}): void {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: VALID_FROM,
+    validUntil: VALID_UNTIL,
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+}
+
+function createOrder(app: App, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function count(sql: string, app: App): number {
+  return (app.db.prepare(sql).get() as { n: number }).n;
+}
+
+describe("OrderRepository.applyCoupon", () => {
+  function seedRepo() {
+    const db = openDb();
+    db.prepare(
+      "INSERT INTO orders (customer, amount_cents, final_amount_cents, created_at) VALUES ('a', 10000, 10000, 't')",
+    ).run();
+    db.prepare(
+      "INSERT INTO coupons (code, type, value, valid_from, valid_until) VALUES ('C', 'FIXED', 500, '2020-01-01T00:00:00Z', '2030-01-01T00:00:00Z')",
+    ).run();
+    return { db, repo: new OrderRepository(db) };
+  }
+
+  it("writes the order, one redemption row and the usage counter", () => {
+    const { db, repo } = seedRepo();
+    repo.applyCoupon(1, "C", 500, 9500, "2026-10-01T08:00:00.000Z");
+
+    expect(repo.findById(1)).toMatchObject({
+      discountCents: 500,
+      finalAmountCents: 9500,
+      couponCode: "C",
+    });
+    expect(db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 1 });
+    expect(db.prepare("SELECT * FROM coupon_redemptions").get()).toMatchObject({
+      order_id: 1,
+      coupon_code: "C",
+      discount_cents: 500,
+      created_at: "2026-10-01T08:00:00.000Z",
+    });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = 'C'").get()).toEqual({ used_count: 1 });
+  });
+
+  it("rolls back every write when a later statement fails", () => {
+    const { db, repo } = seedRepo();
+    db.exec(
+      "CREATE TRIGGER fail_usage BEFORE UPDATE ON coupons WHEN NEW.used_count > OLD.used_count BEGIN SELECT RAISE(ABORT, 'boom'); END",
+    );
+
+    expect(() => repo.applyCoupon(1, "C", 500, 9500, "2026-10-01T08:00:00.000Z")).toThrow();
+
+    expect(repo.findById(1)).toMatchObject({ discountCents: 0, finalAmountCents: 10000, couponCode: null });
+    expect(db.prepare("SELECT COUNT(*) AS n FROM coupon_redemptions").get()).toEqual({ n: 0 });
+    expect(db.prepare("SELECT used_count FROM coupons WHERE code = 'C'").get()).toEqual({ used_count: 0 });
+  });
+});
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("AC-01: percent coupon lowers the amount due", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "PERCENT", value: 20 });
+    const id = createOrder(app, 10000);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 8000, couponCode: "SAVE20" });
+  });
+
+  it("AC-02: fixed coupon lowers the amount due", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "FIXED", value: 1500 });
+    const id = createOrder(app, 10000);
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 8500,
+    });
+  });
+
+  it("REQ-08: a single discount never exceeds 10000 cents (AC-03 conflict)", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: null });
+    const id = createOrder(app, 100000);
+
+    // TASK.md AC-03 expects 20000; REQ-08's MUST-NOT ceiling wins, so 10000. See proposal.md.
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 10000,
+      finalAmountCents: 90000,
+    });
+  });
+
+  it("AC-04: the discount is clamped to the order amount", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "FIXED", value: 3000 });
+    const id = createOrder(app, 1000);
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("AC-05: percent discounts round down", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "PERCENT", value: 15 });
+    const id = createOrder(app, 999);
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 149,
+    });
+  });
+
+  it("REQ-08: maxDiscountCents caps the discount", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { type: "PERCENT", value: 20, maxDiscountCents: 500 });
+    const id = createOrder(app, 10000);
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).body).toMatchObject({
+      discountCents: 500,
+    });
+  });
+
+  it("AC-06: amount equal to minAmountCents is accepted", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { minAmountCents: 5000 });
+    const id = createOrder(app, 5000);
+
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).status).toBe(200);
+  });
+
+  it("AC-07: validFrom is inclusive and validUntil is exclusive", () => {
+    const app = createApp({ clock: () => new Date("2026-10-01T00:00:00Z") });
+    seedCoupon(app, { validFrom: "2026-10-01T00:00:00Z", validUntil: "2026-10-02T00:00:00Z" });
+    const id = createOrder(app, 10000);
+
+    const atStart = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(atStart.status).toBe(200);
+
+    const expiredApp = createApp({ clock: () => new Date("2026-10-02T00:00:00Z") });
+    seedCoupon(expiredApp, { validFrom: "2026-10-01T00:00:00Z", validUntil: "2026-10-02T00:00:00Z" });
+    const other = createOrder(expiredApp, 10000);
+    expect(expiredApp.request("POST", `/orders/${other}/apply-coupon`, { couponCode: "SAVE20" })).toEqual({
+      status: 400,
+      body: { error: { code: "COUPON_EXPIRED", message: expect.any(String) } },
+    });
+  });
+
+  it("AC-09: bumps usedCount and inserts one redemption row", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { value: 20 });
+    const id = createOrder(app, 10000);
+    const before = count("SELECT COUNT(*) AS n FROM coupon_redemptions", app);
+
+    app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    expect(count("SELECT COUNT(*) AS n FROM coupon_redemptions", app)).toBe(before + 1);
+  });
+
+  it("AC-10: trims and upper-cases the coupon code", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { code: "SAVE20" });
+    const id = createOrder(app, 10000);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: " save20 " });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20" });
+  });
+
+  it("REQ-14: success body equals the following GET and keeps the status PENDING", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app);
+    const id = createOrder(app, 10000);
+
+    const applied = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    const read = app.request("GET", `/orders/${id}`);
+
+    expect(applied.status).toBe(200);
+    expect(applied.body).toEqual(read.body);
+    expect(applied.body).toMatchObject({ status: "PENDING" });
+  });
+});
+
+describe("apply-coupon rejections", () => {
+  function rejected(code: string) {
+    return { status: expect.any(Number), body: { error: { code, message: expect.any(String) } } };
+  }
+
+  it("rejects a missing, non-string or blank couponCode as INVALID_REQUEST", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app);
+    const id = createOrder(app, 10000);
+
+    for (const body of [{}, { couponCode: 42 }, { couponCode: {} }, { couponCode: "   " }]) {
+      expect(app.request("POST", `/orders/${id}/apply-coupon`, body)).toEqual(rejected("INVALID_REQUEST"));
+    }
+  });
+
+  it("checks INVALID_REQUEST before the order lookup", () => {
+    const app = createApp({ clock: fixedClock });
+    expect(app.request("POST", "/orders/999/apply-coupon", {})).toEqual(rejected("INVALID_REQUEST"));
+  });
+
+  it("rejects an unknown order with ORDER_NOT_FOUND", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app);
+    const res = app.request("POST", "/orders/999/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect(res.body).toEqual(rejected("ORDER_NOT_FOUND").body);
+  });
+
+  it("rejects a non-pending order with ORDER_NOT_PENDING", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app);
+    const id = createOrder(app, 10000);
+    app.request("POST", `/orders/${id}/pay`);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect(res.body).toEqual(rejected("ORDER_NOT_PENDING").body);
+  });
+
+  it("rejects a second coupon with COUPON_ALREADY_APPLIED", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app);
+    const id = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" }).status).toBe(200);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(409);
+    expect(res.body).toEqual(rejected("COUPON_ALREADY_APPLIED").body);
+  });
+
+  it("rejects an unknown coupon with COUPON_NOT_FOUND", () => {
+    const app = createApp({ clock: fixedClock });
+    const id = createOrder(app, 10000);
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "NOPE" });
+    expect(res.status).toBe(404);
+    expect(res.body).toEqual(rejected("COUPON_NOT_FOUND").body);
+  });
+
+  it("rejects a disabled coupon with COUPON_INACTIVE", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { status: "DISABLED" });
+    const id = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" })).toEqual({
+      status: 400,
+      body: rejected("COUPON_INACTIVE").body,
+    });
+  });
+
+  it("rejects before validFrom with COUPON_NOT_YET_VALID", () => {
+    const app = createApp({ clock: () => new Date("2025-12-31T23:59:59Z") });
+    seedCoupon(app);
+    const id = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" })).toEqual({
+      status: 400,
+      body: rejected("COUPON_NOT_YET_VALID").body,
+    });
+  });
+
+  it("rejects an exhausted coupon with COUPON_USAGE_EXHAUSTED", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { usageLimit: 1 });
+    const first = createOrder(app, 10000);
+    const second = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${first}/apply-coupon`, { couponCode: "SAVE20" }).status).toBe(200);
+
+    expect(app.request("POST", `/orders/${second}/apply-coupon`, { couponCode: "SAVE20" })).toEqual({
+      status: 400,
+      body: rejected("COUPON_USAGE_EXHAUSTED").body,
+    });
+  });
+
+  it("rejects a below-minimum order with MINIMUM_NOT_MET", () => {
+    const app = createApp({ clock: fixedClock });
+    seedCoupon(app, { minAmountCents: 100000 });
+    const id = createOrder(app, 10000);
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" })).toEqual({
+      status: 400,
+      body: rejected("MINIMUM_NOT_MET").body,
