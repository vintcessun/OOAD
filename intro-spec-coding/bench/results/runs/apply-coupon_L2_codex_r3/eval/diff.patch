   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +43,55 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Applies a coupon to a pending order and returns the updated order. */
+  applyCoupon(id: number, rawCode: unknown): Order {
+    if (typeof rawCode !== "string" || rawCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = rawCode.trim();
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    this.assertUsable(coupon, order.amountCents);
+
+    const discountCents = this.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+    const now = this.clock().toISOString();
+
+    this.orders.recordCoupon(order.id, coupon.code, discountCents, finalAmountCents);
+    this.coupons.consume(coupon.code, order.id, discountCents, now);
+    return this.get(id);
+  }
+
+  private assertUsable(coupon: Coupon, amountCents: number): void {
+    if (coupon.status !== "ACTIVE") {
+      throw badRequest("COUPON_INACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    }
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${coupon.code} has expired`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "ORDER_BELOW_MIN_AMOUNT",
+        `order amount ${amountCents} is below coupon minimum ${coupon.minAmountCents}`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} has reached its usage limit`);
+    }
+  }
+
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    const raw =
+      coupon.type === "PERCENT" ? Math.floor((amountCents * coupon.value) / 100) : coupon.value;
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(capped, amountCents));
+  }
 }
