--- a/src/repositories/couponRepository.ts
+++ b/src/repositories/couponRepository.ts
@@ -57,4 +57,21 @@ export class CouponRepository {
     const row = this.db.prepare("SELECT * FROM coupons WHERE code = ?").get(code) as CouponRow | undefined;
     return row && toCoupon(row);
   }
+
+  /** Records a redemption and bumps the coupon's usage counter as one atomic step. */
+  recordRedemption(orderId: number, couponCode: string, discountCents: number, createdAt: string): void {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(orderId, couponCode, discountCents, createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(couponCode);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
 }
