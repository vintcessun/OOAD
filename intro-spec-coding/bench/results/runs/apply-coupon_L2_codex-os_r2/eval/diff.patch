+
+  it("rejects an expired coupon with 400", () => {
+    const { coupons, service } = setup();
+    coupons.insert(coupon({ validUntil: "2026-09-30T00:00:00Z" }));
+    const order = service.create("alice", 12000);
+    expect(codeOf(() => service.applyCoupon(order.id, "SAVE10"))).toBe("COUPON_EXPIRED");
+  });
+
+  it("rejects a not-yet-valid coupon with 400", () => {
+    const { coupons, service } = setup();
+    coupons.insert(coupon({ validFrom: "2026-11-01T00:00:00Z" }));
+    const order = service.create("alice", 12000);
+    expect(codeOf(() => service.applyCoupon(order.id, "SAVE10"))).toBe("COUPON_NOT_YET_VALID");
