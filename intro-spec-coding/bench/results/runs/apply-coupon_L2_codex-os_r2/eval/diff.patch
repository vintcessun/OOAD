+describe("POST /orders/:id/apply-coupon", () => {
+  const appWithCoupon = (over: Record<string, unknown> = {}) => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/coupons", {
+      code: "SAVE20",
+      type: "PERCENT",
+      value: 20,
+      validFrom: "2026-01-01T00:00:00Z",
+      validUntil: "2027-01-01T00:00:00Z",
+      ...over,
+    });
+    app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+    return app;
+  };
+
+  it("returns 200 with the updated order for a valid coupon", () => {
+    const app = appWithCoupon();
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id: 1,
+      couponCode: "SAVE20",
+      discountCents: 2400,
+      finalAmountCents: 9600,
+    });
+  });
+
+  it("returns 400 for an unknown, expired, disabled or below-minimum coupon", () => {
+    expect(appWithCoupon().request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" }).status).toBe(400);
+    expect(
+      appWithCoupon({ validUntil: "2026-01-01T00:00:00Z" }).request("POST", "/orders/1/apply-coupon", {
+        couponCode: "SAVE20",
+      }).status,
+    ).toBe(400);
+    expect(
+      appWithCoupon({ status: "DISABLED" }).request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" }).status,
+    ).toBe(400);
+    expect(
+      appWithCoupon({ minAmountCents: 99999 }).request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" })
+        .status,
+    ).toBe(400);
+  });
+
+  it("returns 400 when the coupon code is missing", () => {
+    const res = appWithCoupon().request("POST", "/orders/1/apply-coupon", {});
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const res = appWithCoupon().request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
