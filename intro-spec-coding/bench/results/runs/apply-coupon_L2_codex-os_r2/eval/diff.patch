+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+import { openDb } from "../src/db.ts";
+import type { AppError } from "../src/errors.ts";
+import { CouponRepository, type Coupon } from "../src/repositories/couponRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+import { OrderService, computeDiscount } from "../src/services/orderService.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const coupon = (over: Partial<Coupon> = {}): Coupon => ({
+  code: "SAVE10",
+  type: "FIXED",
+  value: 1000,
+  minAmountCents: 0,
+  maxDiscountCents: null,
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+  status: "ACTIVE",
+  usageLimit: null,
+  usedCount: 0,
+  ...over,
+});
+
+const codeOf = (fn: () => unknown): string => {
+  try {
+    fn();
+  } catch (e) {
+    return (e as AppError).code;
+  }
+  throw new Error("expected the call to throw");
+};
+
+describe("discount calculation", () => {
+  it("subtracts a fixed value", () => {
+    expect(computeDiscount(10000, coupon({ type: "FIXED", value: 1500 }))).toBe(1500);
+  });
+
+  it("applies a percentage, truncated to whole cents", () => {
+    expect(computeDiscount(999, coupon({ type: "PERCENT", value: 15 }))).toBe(149);
+  });
+
+  it("caps the discount at maxDiscountCents", () => {
+    expect(computeDiscount(10000, coupon({ type: "PERCENT", value: 50, maxDiscountCents: 1000 }))).toBe(1000);
+  });
+
+  it("never discounts more than the order amount", () => {
+    expect(computeDiscount(500, coupon({ type: "FIXED", value: 9999 }))).toBe(500);
+  });
+});
+
+describe("repositories", () => {
+  it("persists a discount on an order", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const order = orders.insert("alice", 10000, "2026-01-01T00:00:00.000Z");
+
+    orders.applyCoupon(order.id, { couponCode: "SAVE10", discountCents: 1000, finalAmountCents: 9000 });
+
+    expect(orders.findById(order.id)).toMatchObject({
+      couponCode: "SAVE10",
+      discountCents: 1000,
+      finalAmountCents: 9000,
+    });
+  });
+
+  it("records a redemption and bumps usedCount", () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const coupons = new CouponRepository(db);
+    coupons.insert(coupon());
+    const order = orders.insert("bob", 10000, "2026-01-01T00:00:00.000Z");
+
+    coupons.recordRedemption(order.id, "SAVE10", 1000, "2026-01-01T00:00:00.000Z");
+
+    expect(coupons.findByCode("SAVE10")!.usedCount).toBe(1);
+    const rows = db.prepare("SELECT * FROM coupon_redemptions").all() as unknown as Record<string, unknown>[];
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ order_id: order.id, coupon_code: "SAVE10", discount_cents: 1000 });
+  });
+});
+
+describe("OrderService.applyCoupon", () => {
+  const setup = () => {
+    const db = openDb();
+    const orders = new OrderRepository(db);
+    const coupons = new CouponRepository(db);
+    return { db, orders, coupons, service: new OrderService(orders, coupons, fixedClock) };
+  };
+
+  it("applies a fixed coupon and records the redemption", () => {
+    const { orders, coupons, service } = setup();
+    coupons.insert(coupon({ type: "FIXED", value: 2000 }));
+    const order = service.create("alice", 12000);
+
+    const updated = service.applyCoupon(order.id, "SAVE10");
+
+    expect(updated).toMatchObject({ couponCode: "SAVE10", discountCents: 2000, finalAmountCents: 10000 });
+    expect(coupons.findByCode("SAVE10")!.usedCount).toBe(1);
+    expect(orders.findById(order.id)!.finalAmountCents).toBe(10000);
+  });
+
+  it("applies a percent coupon", () => {
+    const { coupons, service } = setup();
+    coupons.insert(coupon({ type: "PERCENT", value: 25 }));
+    const order = service.create("alice", 8000);
+
+    expect(service.applyCoupon(order.id, "SAVE10")).toMatchObject({ discountCents: 2000, finalAmountCents: 6000 });
+  });
+
+  it("rejects an unknown coupon with 400", () => {
+    const { service } = setup();
+    const order = service.create("alice", 12000);
+    expect(codeOf(() => service.applyCoupon(order.id, "NOPE"))).toBe("COUPON_NOT_FOUND");
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const { coupons, service } = setup();
+    coupons.insert(coupon({ status: "DISABLED" }));
+    const order = service.create("alice", 12000);
+    expect(codeOf(() => service.applyCoupon(order.id, "SAVE10"))).toBe("COUPON_NOT_ACTIVE");
