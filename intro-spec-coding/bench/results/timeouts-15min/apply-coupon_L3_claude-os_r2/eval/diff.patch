+import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
+import type { CouponRedemptionRepository } from "../repositories/couponRedemptionRepository.ts";
+import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
-/** Coupon administration (create / look up). Applying coupons to orders is not implemented yet. */
+/** Coupon administration (create / look up) and applying a coupon to a pending order. */
 export class CouponService {
-  constructor(private readonly coupons: CouponRepository) {}
+  constructor(
+    private readonly coupons: CouponRepository,
+    private readonly orders: OrderRepository,
+    private readonly redemptions: CouponRedemptionRepository,
+    private readonly clock: Clock,
+  ) {}
 
   create(input: Record<string, unknown>): Coupon {
     const code = input.code;
@@ -41,4 +49,58 @@ export class CouponService {
     if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
     return coupon;
   }
+
+  /**
+   * Applies one coupon to a pending order. Rejections are checked in the order the API contract
+   * documents, so the first failing condition determines the error. On success the order fields,
+   * a redemption row and the coupon usage counter are written atomically, and the updated order
+   * is returned.
+   */
+  applyToOrder(orderId: number, rawCouponCode: unknown): Order {
+    if (typeof rawCouponCode !== "string" || rawCouponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = rawCouponCode.trim().toUpperCase();
+
+    const order = this.orders.findById(orderId);
+    if (!order) throw notFound("ORDER_NOT_FOUND", `order ${orderId} not found`);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${orderId} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("COUPON_ALREADY_APPLIED", `order ${orderId} already has a coupon`);
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_INACTIVE", `coupon ${code} is ${coupon.status}`);
+
+    const now = this.clock();
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid yet`);
+    }
+    if (now.getTime() >= Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} has expired`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw badRequest("COUPON_USAGE_EXHAUSTED", `coupon ${code} usage limit reached`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw badRequest("MINIMUM_NOT_MET", `order amount is below coupon ${code} minimum`);
+    }
+
+    const discount = this.discountFor(order.amountCents, coupon);
+    this.redemptions.redeem({
+      orderId,
+      couponCode: code,
+      discountCents: discount,
+      finalAmountCents: order.amountCents - discount,
+      createdAt: now.toISOString(),
+    });
+    return this.orders.findById(orderId)!;
+  }
+
+  /** Base discount by type, reduced by the optional cap and clamped to the order amount. */
+  private discountFor(amountCents: number, coupon: Coupon): number {
+    let discount =
+      coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    if (coupon.maxDiscountCents !== null) discount = Math.min(discount, coupon.maxDiscountCents);
+    return Math.min(discount, amountCents);
+  }
 }
