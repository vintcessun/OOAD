@@ -0,0 +1,65 @@
+import type { Db } from "../db.ts";
+
+export interface CouponRedemption {
+  id: number;
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  createdAt: string;
+}
+
+interface RedemptionRow {
+  id: number;
+  order_id: number;
+  coupon_code: string;
+  discount_cents: number;
+  created_at: string;
+}
+
+export interface RedeemInput {
+  orderId: number;
+  couponCode: string;
+  discountCents: number;
+  finalAmountCents: number;
+  createdAt: string;
+}
+
+const toRedemption = (r: RedemptionRow): CouponRedemption => ({
+  id: r.id,
+  orderId: r.order_id,
+  couponCode: r.coupon_code,
+  discountCents: r.discount_cents,
+  createdAt: r.created_at,
+});
+
+/** Records a coupon redemption as one atomic unit: order fields, redemption row and usage counter. */
+export class CouponRedemptionRepository {
+  constructor(private readonly db: Db) {}
+
+  /** Applies the coupon to the order and records the redemption; rolls back entirely on any failure. */
+  redeem(input: RedeemInput): void {
+    this.db.exec("BEGIN");
+    try {
+      this.db
+        .prepare("UPDATE orders SET discount_cents = ?, final_amount_cents = ?, coupon_code = ? WHERE id = ?")
+        .run(input.discountCents, input.finalAmountCents, input.couponCode, input.orderId);
+      this.db
+        .prepare(
+          "INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)",
+        )
+        .run(input.orderId, input.couponCode, input.discountCents, input.createdAt);
+      this.db.prepare("UPDATE coupons SET used_count = used_count + 1 WHERE code = ?").run(input.couponCode);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
+
+  findByOrderId(orderId: number): CouponRedemption[] {
+    const rows = this.db
+      .prepare("SELECT * FROM coupon_redemptions WHERE order_id = ? ORDER BY id")
+      .all(orderId) as unknown as RedemptionRow[];
+    return rows.map(toRedemption);
+  }
+}
