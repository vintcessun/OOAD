+import { describe, expect, it } from "vitest";
+import { openDb } from "../src/db.ts";
+import { CouponRepository } from "../src/repositories/couponRepository.ts";
+import { CouponRedemptionRepository } from "../src/repositories/couponRedemptionRepository.ts";
+import { OrderRepository } from "../src/repositories/orderRepository.ts";
+
+const NOW = "2026-10-01T08:00:00.000Z";
+
+function setup() {
+  const db = openDb();
+  const orders = new OrderRepository(db);
+  const coupons = new CouponRepository(db);
+  const redemptions = new CouponRedemptionRepository(db);
+  coupons.insert({
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    minAmountCents: 0,
+    maxDiscountCents: null,
+    validFrom: "2026-01-01T00:00:00.000Z",
+    validUntil: "2027-01-01T00:00:00.000Z",
+    status: "ACTIVE",
+    usageLimit: null,
+  });
+  return { db, orders, coupons, redemptions };
+}
+
+describe("CouponRedemptionRepository.redeem", () => {
+  it("updates the order, inserts a redemption and increments the usage counter", () => {
+    const { orders, coupons, redemptions } = setup();
+    const order = orders.insert("alice", 10000, NOW);
+
+    redemptions.redeem({
+      orderId: order.id,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      createdAt: NOW,
+    });
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 2000,
+      finalAmountCents: 8000,
+      couponCode: "SAVE20",
+    });
+    expect(coupons.findByCode("SAVE20")!.usedCount).toBe(1);
+
+    const rows = redemptions.findByOrderId(order.id);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({
+      orderId: order.id,
+      couponCode: "SAVE20",
+      discountCents: 2000,
+      createdAt: NOW,
+    });
+  });
+
+  it("rolls back every write when a step fails", () => {
+    const { orders, coupons, redemptions } = setup();
+    const order = orders.insert("bob", 10000, NOW);
+
+    // The unknown coupon makes the redemption insert violate its foreign key,
+    // after the order update has already run.
+    expect(() =>
+      redemptions.redeem({
+        orderId: order.id,
+        couponCode: "NOPE",
+        discountCents: 500,
+        finalAmountCents: 9500,
+        createdAt: NOW,
+      }),
+    ).toThrow();
+
+    expect(orders.findById(order.id)).toMatchObject({
+      discountCents: 0,
+      finalAmountCents: 10000,
+      couponCode: null,
+    });
+    expect(coupons.findByCode("SAVE20")!.usedCount).toBe(0);
+    expect(redemptions.findByOrderId(order.id)).toHaveLength(0);
+  });
+});
