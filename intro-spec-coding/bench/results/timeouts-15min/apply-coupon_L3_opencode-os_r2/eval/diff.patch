--- a/src/db.ts
+++ b/src/db.ts
@@ -42,3 +42,16 @@ export function openDb(path = ":memory:"): Db {
   db.exec(SCHEMA);
   return db;
 }
+
+/** Runs `fn` inside a SQLite transaction, committing on success and rolling back on any throw. */
+export function transaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (e) {
+    db.exec("ROLLBACK");
+    throw e;
+  }
+}
