@@ -0,0 +1,196 @@
+import { describe, expect, it } from "vitest";
+import { createApp, type App } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+function makeApp(): App {
+  return createApp({ clock: fixedClock });
+}
+
+function addCoupon(app: App, overrides: Record<string, unknown> = {}) {
+  const res = app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...overrides,
+  });
+  expect(res.status).toBe(201);
+  return res;
+}
+
+function addOrder(app: App, amountCents = 12000) {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as any).id as number;
+}
+
+const errCode = (res: { body: unknown }) => (res.body as any).error.code;
+
+describe("POST /orders/:id/apply-coupon", () => {
+  it("applies a percent coupon and returns the discounted order", () => {
+    const app = makeApp();
+    addCoupon(app);
+    const id = addOrder(app);
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+    });
+    expect(app.request("GET", "/orders/" + id).body).toMatchObject({ finalAmountCents: 9600 });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a fixed coupon capped at the order amount", () => {
+    const app = makeApp();
+    addCoupon(app, { code: "OFF1500", type: "FIXED", value: 1500 });
+    addCoupon(app, { code: "BIG", type: "FIXED", value: 5000 });
+
+    const a = addOrder(app);
+    expect(app.request("POST", `/orders/${a}/apply-coupon`, { couponCode: "OFF1500" }).body).toMatchObject({
+      discountCents: 1500,
+      finalAmountCents: 10500,
+    });
+
+    const b = addOrder(app, 300);
+    expect(app.request("POST", `/orders/${b}/apply-coupon`, { couponCode: "BIG" }).body).toMatchObject({
+      discountCents: 300,
+      finalAmountCents: 0,
+    });
+  });
+
+  it("rounds percent discounts down", () => {
+    const app = makeApp();
+    addCoupon(app, { code: "TEN", value: 10 });
+    const id = addOrder(app, 999);
+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "TEN" }).body).toMatchObject({
+      discountCents: 99,
+      finalAmountCents: 900,
+    });
+  });
+
+  it("caps a percent coupon at maxDiscountCents", () => {
+    const app = makeApp();
+    addCoupon(app, { code: "HALF", value: 50, maxDiscountCents: 1000 });
