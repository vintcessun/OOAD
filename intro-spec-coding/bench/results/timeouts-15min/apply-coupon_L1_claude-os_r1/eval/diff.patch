diff --git a/src/db.ts b/src/db.ts
index de673a1..35c2701 100755
--- a/src/db.ts
+++ b/src/db.ts
@@ -42,3 +42,16 @@ export function openDb(path = ":memory:"): Db {
   db.exec(SCHEMA);
   return db;
 }
+
+/** Runs `fn` inside a transaction, rolling back if it throws. */
+export function withTransaction<T>(db: Db, fn: () => T): T {
+  db.exec("BEGIN");
+  try {
+    const result = fn();
+    db.exec("COMMIT");
+    return result;
+  } catch (e) {
+    db.exec("ROLLBACK");
+    throw e;
+  }
+}
