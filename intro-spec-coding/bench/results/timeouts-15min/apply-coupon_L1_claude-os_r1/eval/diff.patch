+    expect(app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "HALF" }).body).toMatchObject({
+      discountCents: 1000,
+      finalAmountCents: 9000,
+    });
+  });
+
+  it("rejects a missing couponCode", () => {
