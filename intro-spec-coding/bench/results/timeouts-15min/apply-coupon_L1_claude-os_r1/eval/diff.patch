diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..acc2eb0 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,11 +1,15 @@
 import type { Clock } from "../clock.ts";
+import { withTransaction, type Db } from "../db.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
+    private readonly db: Db,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +45,47 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already has coupon ${order.couponCode}`);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const coupon = this.coupons.findByCode(couponCode.trim());
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+    this.assertRedeemable(coupon, order);
+
+    const now = this.clock();
+    const discountCents = computeDiscount(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    return withTransaction(this.db, () => {
+      this.orders.applyCoupon(id, coupon.code, discountCents, finalAmountCents);
+      this.orders.recordRedemption(id, coupon.code, discountCents, now.toISOString());
+      this.coupons.incrementUsedCount(coupon.code);
+      return this.get(id);
+    });
+  }
+
+  private assertRedeemable(coupon: Coupon, order: Order): void {
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_NOT_ACTIVE", `coupon ${coupon.code} is ${coupon.status}`);
+    const now = this.clock().getTime();
+    if (now < Date.parse(coupon.validFrom)) throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} starts ${coupon.validFrom}`);
+    if (now > Date.parse(coupon.validUntil)) throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} ended ${coupon.validUntil}`);
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} is exhausted`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict("ORDER_BELOW_MIN_AMOUNT", `order ${order.id} is below the coupon minimum`);
+    }
+  }
+}
+
+function computeDiscount(coupon: Coupon, amountCents: number): number {
+  const raw =
+    coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.min(capped, amountCents);
 }
