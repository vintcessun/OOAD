 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,51 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const code = couponCode.trim();
+
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("COUPON_ALREADY_APPLIED", `order ${id} already used coupon ${order.couponCode}`);
+    }
+
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
+
+    const now = this.clock();
+    this.assertApplicable(coupon, order.amountCents, now);
+
+    const discount = this.discountFor(coupon, order.amountCents);
+    this.orders.applyCoupon(id, coupon.code, discount, order.amountCents - discount);
+    this.coupons.recordRedemption(id, coupon.code, discount, now.toISOString());
+    this.coupons.incrementUsedCount(coupon.code);
+    return this.get(id);
+  }
+
+  private assertApplicable(coupon: Coupon, amountCents: number, now: Date): void {
+    if (coupon.status !== "ACTIVE") throw conflict("COUPON_DISABLED", `coupon ${coupon.code} is disabled`);
+    if (now < new Date(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid before ${coupon.validFrom}`);
+    }
+    if (now > new Date(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} expired after ${coupon.validUntil}`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw conflict("COUPON_MIN_AMOUNT", `order amount ${amountCents} is below coupon ${coupon.code} minimum ${coupon.minAmountCents}`);
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} reached its usage limit`);
+    }
+  }
+
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(capped, amountCents));
+  }
 }
diff --git a/tests/tmp-apply.test.ts b/tests/tmp-apply.test.ts
new file mode 100644
index 0000000..c65c645
--- /dev/null
+++ b/tests/tmp-apply.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const clock = () => new Date("2026-10-01T08:00:00Z");
+
+function makeCoupon(app: ReturnType<typeof createApp>, over: Record<string, unknown> = {}) {
+  return app.request("POST", "/coupons", {
+    code: "SAVE20",
+    type: "PERCENT",
+    value: 20,
+    validFrom: "2026-01-01T00:00:00Z",
+    validUntil: "2027-01-01T00:00:00Z",
+    ...over,
+  });
+}
+
+describe("apply-coupon", () => {
+  it("applies a percentage coupon", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 12000 });
+    makeCoupon(app);
+    const res = app.request("POST", "/orders/1/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ amountCents: 12000, discountCents: 2400, finalAmountCents: 9600, couponCode: "SAVE20" });
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("applies a fixed coupon and floors percent", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 999 });
+    makeCoupon(app, { code: "FIX", type: "FIXED", value: 500 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "FIX" }).body).toMatchObject({ discountCents: 500, finalAmountCents: 499 });
+    app.request("POST", "/orders", { customer: "b", amountCents: 333 });
+    makeCoupon(app, { code: "P10", type: "PERCENT", value: 10 });
+    expect(app.request("POST", "/orders/2/apply-coupon", { couponCode: "P10" }).body).toMatchObject({ discountCents: 33, finalAmountCents: 300 });
+  });
+
+  it("enforces the max discount cap and never exceeds the amount", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 10000 });
+    makeCoupon(app, { code: "CAP", type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "CAP" }).body).toMatchObject({ discountCents: 1000 });
+
+    app.request("POST", "/orders", { customer: "b", amountCents: 300 });
+    makeCoupon(app, { code: "BIG", type: "FIXED", value: 500 });
+    expect(app.request("POST", "/orders/2/apply-coupon", { couponCode: "BIG" }).body).toMatchObject({ discountCents: 300, finalAmountCents: 0 });
+  });
+
+  it("rejects unavailable coupons", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 10000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "NOPE" }).status).toBe(404);
+
+    makeCoupon(app, { code: "OFF", status: "DISABLED" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OFF" }).status).toBe(409);
+
+    makeCoupon(app, { code: "OLD", validUntil: "2026-01-01T00:00:00Z" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "OLD" }).status).toBe(409);
+
+    makeCoupon(app, { code: "FUT", validFrom: "2027-01-01T00:00:00Z" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "FUT" }).status).toBe(409);
+
+    makeCoupon(app, { code: "MIN", minAmountCents: 20000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "MIN" }).status).toBe(409);
+
+    makeCoupon(app, { code: "ONE", usageLimit: 1 });
+    const app2 = createApp({ clock });
+    app2.request("POST", "/orders", { customer: "a", amountCents: 1000 });
+    app2.request("POST", "/orders", { customer: "b", amountCents: 1000 });
+    makeCoupon(app2, { code: "ONE", usageLimit: 1 });
+    expect(app2.request("POST", "/orders/1/apply-coupon", { couponCode: "ONE" }).status).toBe(200);
+    expect(app2.request("POST", "/orders/2/apply-coupon", { couponCode: "ONE" }).status).toBe(409);
+    expect(app2.request("GET", "/coupons/ONE").body).toMatchObject({ usedCount: 1 });
+  });
+
+  it("rejects a second coupon and non-pending orders", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 1000 });
+    makeCoupon(app, { code: "A1X" });
+    app.request("POST", "/orders/1/apply-coupon", { couponCode: "A1X" });
+    expect(app.request("POST", "/orders/1/apply-coupon", { couponCode: "A1X" }).status).toBe(409);
+
+    app.request("POST", "/orders/2", { customer: "b", amountCents: 1000 });
+    app.request("POST", "/orders/2/pay");
+    makeCoupon(app, { code: "B1X" });
+    expect(app.request("POST", "/orders/2/apply-coupon", { couponCode: "B1X" }).status).toBe(409);
+  });
+
+  it("rejects missing coupon codes and unknown orders", () => {
+    const app = createApp({ clock });
+    app.request("POST", "/orders", { customer: "a", amountCents: 1000 });
+    expect(app.request("POST", "/orders/1/apply-coupon", {}).status).toBe(400);
+    expect(app.request("POST", "/orders/99/apply-coupon", { couponCode: "X" }).status).toBe(404);
+  });
+});
