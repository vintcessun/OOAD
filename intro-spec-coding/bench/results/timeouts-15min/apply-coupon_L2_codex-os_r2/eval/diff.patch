diff --git a/src/services/couponService.ts b/src/services/couponService.ts
index e39f586..0a3acc3 100755
--- a/src/services/couponService.ts
+++ b/src/services/couponService.ts
@@ -1,7 +1,19 @@
 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 
-/** Coupon administration (create / look up). Applying coupons to orders is not implemented yet. */
+/** Discount in integer cents: FIXED subtracts its value, PERCENT takes a percentage (floored). */
+export function computeDiscount(coupon: Coupon, amountCents: number): number {
+  const raw = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+  const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+  return Math.max(0, Math.min(capped, amountCents));
+}
+
+export interface Redemption {
+  coupon: Coupon;
+  discountCents: number;
+}
+
+/** Coupon administration (create / look up) and coupon redemption rules. */
 export class CouponService {
   constructor(private readonly coupons: CouponRepository) {}
 
@@ -41,4 +53,33 @@ export class CouponService {
     if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${code} not found`);
     return coupon;
   }
+
+  /**
+   * Check that `code` may be redeemed for `amountCents` at `now` and return the discount.
+   * Every rejection is a 400: an unusable coupon is an invalid request.
+   */
+  redeem(code: string, amountCents: number, now: Date): Redemption {
+    const coupon = this.coupons.findByCode(code);
+    if (!coupon) throw badRequest("COUPON_NOT_FOUND", `coupon ${code} not found`);
+    if (coupon.status !== "ACTIVE") throw badRequest("COUPON_NOT_ACTIVE", `coupon ${code} is ${coupon.status}`);
+    const timestamp = now.getTime();
+    if (timestamp < Date.parse(coupon.validFrom)) {
+      throw badRequest("COUPON_NOT_YET_VALID", `coupon ${code} is not valid before ${coupon.validFrom}`);
+    }
+    if (timestamp > Date.parse(coupon.validUntil)) {
+      throw badRequest("COUPON_EXPIRED", `coupon ${code} expired at ${coupon.validUntil}`);
+    }
+    if (amountCents < coupon.minAmountCents) {
+      throw badRequest(
+        "COUPON_MIN_AMOUNT_NOT_MET",
+        `order amount ${amountCents} is below coupon ${code} minimum ${coupon.minAmountCents}`,
+      );
+    }
+    return { coupon, discountCents: computeDiscount(coupon, amountCents) };
+  }
+
+  /** Record that `code` was redeemed on `orderId`; bumps the coupon's usage counter. */
+  recordRedemption(orderId: number, code: string, discountCents: number, createdAt: string): void {
+    this.coupons.recordRedemption(orderId, code, discountCents, createdAt);
+  }
 }
diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..841ca19 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,11 +1,13 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
+import type { CouponService } from "./couponService.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
     private readonly clock: Clock,
+    private readonly coupons: CouponService,
   ) {}
 
   create(customer: unknown, amountCents: unknown): Order {
@@ -41,4 +43,23 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Price `id` with a coupon and record the redemption. Discounts always use the original amount. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    const order = this.get(id);
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const now = this.clock();
+    const { coupon, discountCents } = this.coupons.redeem(couponCode.trim(), order.amountCents, now);
+    return this.orders.transaction(() => {
+      this.orders.updatePricing(id, {
+        discountCents,
+        finalAmountCents: Math.max(0, order.amountCents - discountCents),
+        couponCode: coupon.code,
+      });
+      this.coupons.recordRedemption(id, coupon.code, discountCents, now.toISOString());
+      return this.get(id);
+    });
+  }
 }
