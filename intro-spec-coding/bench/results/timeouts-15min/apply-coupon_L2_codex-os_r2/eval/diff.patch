+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const WINDOW = { validFrom: "2026-01-01T00:00:00Z", validUntil: "2027-01-01T00:00:00Z" };
+
+/** One order of 12000 cents plus one coupon built from `coupon`. */
+function setup(coupon: Record<string, unknown>) {
+  const app = createApp({ clock: fixedClock });
+  app.request("POST", "/orders", { customer: "alice", amountCents: 12000 });
+  const created = app.request("POST", "/coupons", { code: "SAVE20", ...WINDOW, ...coupon });
+  expect(created.status).toBe(201);
+  return app;
+}
+
+const apply = (app: ReturnType<typeof createApp>, couponCode: unknown = "SAVE20") =>
+  app.request("POST", "/orders/1/apply-coupon", { couponCode });
+
+describe("apply coupon: discount arithmetic", () => {
+  it("subtracts a FIXED coupon value from the order amount", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    const res = apply(app);
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ couponCode: "SAVE20", discountCents: 2000, finalAmountCents: 10000 });
+  });
+
+  it("applies a PERCENT coupon as a floored percentage", () => {
+    const app = setup({ type: "PERCENT", value: 20 });
+    expect(apply(app).body).toMatchObject({ discountCents: 2400, finalAmountCents: 9600 });
+  });
+
+  it("floors fractional cents", () => {
+    const app = createApp({ clock: fixedClock });
+    app.request("POST", "/orders", { customer: "bob", amountCents: 999 });
+    app.request("POST", "/coupons", { code: "SAVE20", type: "PERCENT", value: 33, ...WINDOW });
+    expect(apply(app).body).toMatchObject({ discountCents: 329, finalAmountCents: 670 });
+  });
+
+  it("caps a PERCENT coupon at maxDiscountCents", () => {
+    const app = setup({ type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+    expect(apply(app).body).toMatchObject({ discountCents: 1000, finalAmountCents: 11000 });
+  });
+
+  it("never discounts more than the order amount", () => {
+    const app = setup({ type: "FIXED", value: 99999 });
+    expect(apply(app).body).toMatchObject({ discountCents: 12000, finalAmountCents: 0 });
+  });
+});
+
+describe("apply coupon: eligibility", () => {
+  it("rejects an unknown coupon with 400", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    const res = apply(app, "NOPE");
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_FOUND");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({ discountCents: 0, finalAmountCents: 12000 });
+  });
+
+  it("rejects a disabled coupon with 400", () => {
+    const app = setup({ type: "FIXED", value: 2000, status: "DISABLED" });
+    const res = apply(app);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_ACTIVE");
+  });
+
+  it("rejects an expired coupon with 400", () => {
+    const app = setup({ type: "FIXED", value: 2000, validFrom: "2026-01-01T00:00:00Z", validUntil: "2026-09-30T00:00:00Z" });
+    const res = apply(app);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_EXPIRED");
+    expect(app.request("GET", "/orders/1").body).toMatchObject({ discountCents: 0, finalAmountCents: 12000 });
+  });
+
+  it("rejects a coupon that is not valid yet with 400", () => {
+    const app = setup({ type: "FIXED", value: 2000, validFrom: "2026-11-01T00:00:00Z" });
+    const res = apply(app);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_NOT_YET_VALID");
+  });
+
+  it("accepts a coupon at the edge of its validity window", () => {
+    const app = setup({ type: "FIXED", value: 2000, validFrom: "2026-10-01T08:00:00Z", validUntil: "2026-10-01T08:00:00Z" });
+    expect(apply(app).status).toBe(200);
+  });
+
+  it("rejects a coupon whose minimum amount is not met", () => {
+    const app = setup({ type: "FIXED", value: 2000, minAmountCents: 20000 });
+    const res = apply(app);
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("COUPON_MIN_AMOUNT_NOT_MET");
+  });
+
+  it("accepts a coupon when the order equals its minimum amount", () => {
+    const app = setup({ type: "FIXED", value: 2000, minAmountCents: 12000 });
+    expect(apply(app).status).toBe(200);
+  });
+
+  it("rejects a request without a coupon code", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    const res = app.request("POST", "/orders/1/apply-coupon", {});
+    expect(res.status).toBe(400);
+    expect((res.body as any).error.code).toBe("INVALID_REQUEST");
+  });
+
+  it("returns 404 for an unknown order", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    const res = app.request("POST", "/orders/99/apply-coupon", { couponCode: "SAVE20" });
+    expect(res.status).toBe(404);
+    expect((res.body as any).error.code).toBe("ORDER_NOT_FOUND");
+  });
+});
+
+describe("apply coupon: persistence", () => {
+  it("stores the pricing, records the redemption and bumps usedCount", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    expect(apply(app).status).toBe(200);
+    expect(app.request("GET", "/coupons/SAVE20").body).toMatchObject({ usedCount: 1 });
+    const rows = app.db.prepare("SELECT * FROM coupon_redemptions WHERE order_id = ?").all(1) as any[];
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ coupon_code: "SAVE20", discount_cents: 2000 });
+  });
+
+  it("re-prices from the original amount when a coupon is replaced", () => {
+    const app = setup({ type: "FIXED", value: 2000 });
+    apply(app);
+    const res = apply(app, "SAVE20");
+    expect(res.body).toMatchObject({ discountCents: 2000, finalAmountCents: 10000 });
+  });
+});
