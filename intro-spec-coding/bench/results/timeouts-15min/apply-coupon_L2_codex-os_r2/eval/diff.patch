@@ -57,4 +57,12 @@ export class CouponRepository {
     const row = this.db.prepare("SELECT * FROM coupons WHERE code = ?").get(code) as CouponRow | undefined;
     return row && toCoupon(row);
   }
+
+  /** Append an auditable redemption and bump the coupon's usage counter. */
+  recordRedemption(orderId: number, code: string, discountCents: number, createdAt: string): void {
+    this.db
+      .prepare("INSERT INTO coupon_redemptions (order_id, coupon_code, discount_cents, created_at) VALUES (?, ?, ?, ?)")
