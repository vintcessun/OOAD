diff --git a/src/services/orderService.ts b/src/services/orderService.ts
index 63b29b4..626d3e2 100755
--- a/src/services/orderService.ts
+++ b/src/services/orderService.ts
@@ -1,10 +1,12 @@
 import type { Clock } from "../clock.ts";
 import { badRequest, conflict, notFound } from "../errors.ts";
+import type { Coupon, CouponRepository } from "../repositories/couponRepository.ts";
 import type { Order, OrderRepository } from "../repositories/orderRepository.ts";
 
 export class OrderService {
   constructor(
     private readonly orders: OrderRepository,
+    private readonly coupons: CouponRepository,
     private readonly clock: Clock,
   ) {}
 
@@ -41,4 +43,55 @@ export class OrderService {
     this.orders.updateStatus(id, "CANCELLED");
     return this.get(id);
   }
+
+  /** Redeems a coupon against a pending order, updating totals and usage. */
+  applyCoupon(id: number, couponCode: unknown): Order {
+    if (typeof couponCode !== "string" || couponCode.trim() === "") {
+      throw badRequest("INVALID_REQUEST", "couponCode is required");
+    }
+    const order = this.get(id);
+    if (order.status !== "PENDING") throw conflict("ORDER_NOT_PENDING", `order ${id} is ${order.status}`);
+    if (order.couponCode !== null) {
+      throw conflict("ORDER_ALREADY_HAS_COUPON", `order ${id} already uses coupon ${order.couponCode}`);
+    }
+    const coupon = this.coupons.findByCode(couponCode);
+    if (!coupon) throw notFound("COUPON_NOT_FOUND", `coupon ${couponCode} not found`);
+
+    const now = this.clock();
+    this.assertRedeemable(coupon, order, now);
+    const discountCents = this.discountFor(coupon, order.amountCents);
+    const finalAmountCents = order.amountCents - discountCents;
+
+    this.orders.applyCoupon(id, coupon.code, discountCents, finalAmountCents);
+    this.coupons.redeem(id, coupon.code, discountCents, now.toISOString());
+    return this.get(id);
+  }
+
+  private assertRedeemable(coupon: Coupon, order: Order, now: Date): void {
+    if (coupon.status !== "ACTIVE") {
+      throw conflict("COUPON_DISABLED", `coupon ${coupon.code} is ${coupon.status}`);
+    }
+    if (now.getTime() < Date.parse(coupon.validFrom)) {
+      throw conflict("COUPON_NOT_YET_VALID", `coupon ${coupon.code} is not valid yet`);
+    }
+    if (now.getTime() > Date.parse(coupon.validUntil)) {
+      throw conflict("COUPON_EXPIRED", `coupon ${coupon.code} expired`);
+    }
+    if (order.amountCents < coupon.minAmountCents) {
+      throw conflict(
+        "ORDER_BELOW_MIN_AMOUNT",
+        `order ${order.id} amount is below coupon ${coupon.code} minimum`,
+      );
+    }
+    if (coupon.usageLimit !== null && coupon.usedCount >= coupon.usageLimit) {
+      throw conflict("COUPON_USAGE_LIMIT_REACHED", `coupon ${coupon.code} usage limit reached`);
+    }
+  }
+
+  /** Discount in whole cents: FIXED is a flat amount, PERCENT is floored, both capped and clamped. */
+  private discountFor(coupon: Coupon, amountCents: number): number {
+    const raw = coupon.type === "FIXED" ? coupon.value : Math.floor((amountCents * coupon.value) / 100);
+    const capped = coupon.maxDiscountCents === null ? raw : Math.min(raw, coupon.maxDiscountCents);
+    return Math.max(0, Math.min(capped, amountCents));
+  }
 }
