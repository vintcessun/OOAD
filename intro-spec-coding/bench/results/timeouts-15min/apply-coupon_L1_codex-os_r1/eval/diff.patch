+++ b/tests/apply-coupon.test.ts
@@ -0,0 +1,215 @@
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.ts";
+
+const fixedClock = () => new Date("2026-10-01T08:00:00Z");
+
+const baseCoupon = {
+  validFrom: "2026-01-01T00:00:00Z",
+  validUntil: "2027-01-01T00:00:00Z",
+};
+
+function makeApp() {
+  return createApp({ clock: fixedClock });
+}
+
+function newOrder(app: ReturnType<typeof makeApp>, amountCents: number): number {
+  const res = app.request("POST", "/orders", { customer: "alice", amountCents });
+  expect(res.status).toBe(201);
+  return (res.body as { id: number }).id;
+}
+
+function addCoupon(app: ReturnType<typeof makeApp>, coupon: Record<string, unknown>) {
+  const res = app.request("POST", "/coupons", { ...baseCoupon, ...coupon });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+describe("apply coupon", () => {
+  it("applies a percent coupon and rounds the discount down", () => {
+    const app = makeApp();
+    const id = newOrder(app, 12000);
+    addCoupon(app, { code: "SAVE20", type: "PERCENT", value: 20 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "SAVE20" });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      id,
+      amountCents: 12000,
+      discountCents: 2400,
+      finalAmountCents: 9600,
+      couponCode: "SAVE20",
+      status: "PENDING",
+    });
+  });
+
+  it("floors the percent discount to whole cents", () => {
+    const app = makeApp();
+    const id = newOrder(app, 3333);
+    addCoupon(app, { code: "TEN", type: "PERCENT", value: 10 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "TEN" });
+    expect(res.body).toMatchObject({ discountCents: 333, finalAmountCents: 3000 });
+  });
+
+  it("applies a fixed coupon", () => {
+    const app = makeApp();
+    const id = newOrder(app, 5000);
+    addCoupon(app, { code: "FLAT15", type: "FIXED", value: 1500 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "FLAT15" });
+    expect(res.body).toMatchObject({ discountCents: 1500, finalAmountCents: 3500, couponCode: "FLAT15" });
+  });
+
+  it("never discounts below zero when the fixed value exceeds the order", () => {
+    const app = makeApp();
+    const id = newOrder(app, 5000);
+    addCoupon(app, { code: "HUGE", type: "FIXED", value: 9000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "HUGE" });
+    expect(res.body).toMatchObject({ discountCents: 5000, finalAmountCents: 0 });
+  });
+
+  it("caps the discount at maxDiscountCents", () => {
+    const app = makeApp();
+    const id = newOrder(app, 10000);
+    addCoupon(app, { code: "HALF", type: "PERCENT", value: 50, maxDiscountCents: 1000 });
+
+    const res = app.request("POST", `/orders/${id}/apply-coupon`, { couponCode: "HALF" });
+    expect(res.body).toMatchObject({ discountCents: 1000, finalAmountCents: 9000 });
+  });
+
